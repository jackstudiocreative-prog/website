{% doc %}
  @prompt
    title and content
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-title-content-{{ ai_gen_id }} { display: block; width: {{ block.settings.desktop_width_percent }}%; max-width: 100%; margin: 0 auto; padding: {{ block.settings.vertical_spacing }}px 24px; text-align: {{ block.settings.alignment }}; background-color: {{ block.settings.background_color }}; color: {{ block.settings.text_color }}; box-sizing: border-box; }
  .ai-title-content-{{ ai_gen_id }}__inner { width: 100%; max-width: {{ block.settings.content_width }}px; margin: 0 auto; }
  .ai-title-content-{{ ai_gen_id }}__title { margin: 0 0 14px; color: {{ block.settings.title_color }}; font-size: {{ block.settings.title_size }}px; line-height: 1.15; font-weight: 600; letter-spacing: -0.02em; }
  .ai-title-content-{{ ai_gen_id }}__content { color: {{ block.settings.text_color }}; font-size: {{ block.settings.content_size }}px; line-height: 1.65; }
  .ai-title-content-{{ ai_gen_id }}__content p { margin: 0 0 1em; }
  .ai-title-content-{{ ai_gen_id }}__content p:last-child { margin-bottom: 0; }
  @media screen and (max-width: 749px) { .ai-title-content-{{ ai_gen_id }} { width: 100%; padding: {{ block.settings.mobile_spacing }}px 18px; } .ai-title-content-{{ ai_gen_id }}__title { font-size: {{ block.settings.title_size | times: 0.8 | round }}px; } .ai-title-content-{{ ai_gen_id }}__content { font-size: {{ block.settings.content_size | times: 0.9 | round }}px; } }
{% endstyle %}

<div class="ai-title-content-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-title-content-{{ ai_gen_id }}__inner">
    {% if block.settings.title != blank %}<h2 class="ai-title-content-{{ ai_gen_id }}__title">{{ block.settings.title | escape }}</h2>{% endif %}
    {% if block.settings.content != blank %}<div class="ai-title-content-{{ ai_gen_id }}__content">{{ block.settings.content }}</div>{% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Title and content",
  "settings": [
    { "type": "text", "id": "title", "label": "Title", "default": "Shipping information" },
    { "type": "richtext", "id": "content", "label": "Content", "default": "<p>Add useful information for your customers here.</p>" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "alignment", "label": "Alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }, { "value": "right", "label": "Right" }], "default": "left" },
    { "type": "range", "id": "content_width", "label": "Content width", "min": 400, "max": 1200, "step": 50, "unit": "px", "default": 750 },
    { "type": "range", "id": "title_size", "label": "Title size", "min": 20, "max": 60, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "content_size", "label": "Content size", "min": 14, "max": 24, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "vertical_spacing", "label": "Desktop spacing", "min": 10, "max": 100, "step": 5, "unit": "px", "default": 45 },
    { "type": "range", "id": "mobile_spacing", "label": "Mobile spacing", "min": 10, "max": 70, "step": 5, "unit": "px", "default": 30 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#F4EFDC" },
    { "type": "color", "id": "title_color", "label": "Title color", "default": "#2B2420" },
    { "type": "color", "id": "text_color", "label": "Text color", "default": "#2B2420" }
  ],
  "presets": [{ "name": "Title and content" }],
  "tag": null,
  "class": "title-content-block"
}
{% endschema %}