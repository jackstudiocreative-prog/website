    {"type":"color","id":"text_color","label":"Text","default":"#2B2420"},
    {"type":"color","id":"muted_color","label":"Muted text","default":"#7A7263"},
    {"type":"color","id":"badge_background","label":"Badge background","default":"#2B2420"},
    {"type":"header","content":"Series content"},
    {"type":"text","id":"series_1_title","label":"Series 1 name","default":"Urban Carry"},{"type":"textarea","id":"series_1_description","label":"Series 1 description","default":"Carry smart. Live urban."},{"type":"image_picker","id":"series_1_image","label":"Series 1 image"},
    {"type":"text","id":"series_2_title","label":"Series 2 name","default":"Craft Heritage"},{"type":"textarea","id":"series_2_description","label":"Series 2 description","default":"Timeless craft, made to endure."},{"type":"image_picker","id":"series_2_image","label":"Series 2 image"},
    {"type":"text","id":"series_3_title","label":"Series 3 name","default":"Travel Movement"},{"type":"textarea","id":"series_3_description","label":"Series 3 description","default":"Designed for every journey."},{"type":"image_picker","id":"series_3_image","label":"Series 3 image"},
    {"type":"text","id":"series_4_title","label":"Series 4 name","default":"Professional"},{"type":"textarea","id":"series_4_description","label":"Series 4 description","default":"Refined essentials for work and life."},{"type":"image_picker","id":"series_4_image","label":"Series 4 image"},
    {"type":"text","id":"series_5_title","label":"Series 5 name","default":"Essential"},{"type":"textarea","id":"series_5_description","label":"Series 5 description","default":"The pieces you reach for every day."},{"type":"image_picker","id":"series_5_image","label":"Series 5 image"},
    {"type":"text","id":"series_6_title","label":"Series 6 name","default":"Make It Personal"},{"type":"textarea","id":"series_6_description","label":"Series 6 description","default":"Make every detail your own."},{"type":"image_picker","id":"series_6_image","label":"Series 6 image"},
