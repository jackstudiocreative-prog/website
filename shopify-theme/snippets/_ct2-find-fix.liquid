  .ct2-find{display:grid;grid-template-columns:1fr 1.3fr 1fr;gap:32px;padding:60px 40px;background:#F4EFDC;align-items:center;}
  .ct2-find-left h2{font-family:'Bebas Neue',sans-serif;font-size:30px;margin:0 0 14px;}
  .ct2-find-left p{font-size:13px;color:#7A7263;line-height:1.6;margin:0 0 20px;max-width:280px;}
  .ct2-btn-dark{display:inline-block;background:#2B2420;color:#F4EFDC;padding:12px 24px;font-size:12px;letter-spacing:1px;text-decoration:none;border-radius:2px;font-weight:600;}
  .ct2-find-map{background:#F9F4E3;border-radius:8px;overflow:hidden;aspect-ratio:4/5;max-height:420px;}
  .ct2-find-map img{width:100%;height:100%;display:block;object-fit:cover;}
  .ct2-region-row{display:flex;justify-content:space-between;padding:16px 0;border-bottom:1px solid #E3DCC8;font-size:13px;}
  .ct2-region-count{color:#7A7263;font-size:11px;}