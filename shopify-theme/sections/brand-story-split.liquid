<section class="section"><div class="split {% if section.settings.reverse %}reverse{% endif %}" {{ section.shopify_attributes }}><div class="image" style="{% if section.settings.image != blank %}background-image:url('{{ section.settings.image | image_url: width:1600 }}');{% endif %}"></div><div><div class="kicker">{{ section.settings.kicker }}</div><h2>{{ section.settings.heading }}</h2>{% if section.settings.text1 != blank %}<p>{{ section.settings.text1 }}</p>{% endif %}{% if section.settings.text2 != blank %}<p>{{ section.settings.text2 }}</p>{% endif %}</div></div></section>
<style>
  .split h2{font-size:clamp(20px,2.4vw,28px)!important;line-height:1.15!important;}
</style>
{% schema %}
{"name":"BRAND STORY — Split Story","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"checkbox","id":"reverse","label":"Reverse image/text","default":false},{"type":"text","id":"kicker","label":"Kicker","default":"2010 — 2013"},{"type":"text","id":"heading","label":"Heading","default":"Where it all began."},{"type":"textarea","id":"text1","label":"Paragraph 1","default":"Jacky's journey began in 2010, working hands-on with leather and learning how everyday products are truly used."},{"type":"textarea","id":"text2","label":"Paragraph 2","default":"In 2012 he entered the men's leather goods market with the Canvas Bag — loved for its practicality. In 2013, Jack Studio was officially registered as a brand."}]}
{% endschema %}