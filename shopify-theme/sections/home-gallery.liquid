<section class="section" {{ section.shopify_attributes }}><div class="section-head"><div><div class="eyebrow">{{ section.settings.eyebrow }}</div><h2 class="section-title">{{ section.settings.heading }}</h2></div><div class="section-tagline">{{ section.settings.text }}</div></div><div class="gallery">{% for row in (1..2) %}<div class="row {% if row == 1 %}top{% else %}bottom{% endif %}">{% for block in section.blocks %}{% assign r = block.settings.row | plus: 0 %}{% if r == row %}<div class="cell" {{ block.shopify_attributes }} style="{% if block.settings.image != blank %}background-image:url('{{ block.settings.image | image_url: width:1000 }}');{% endif %}"></div>{% endif %}{% endfor %}</div>{% endfor %}</div></section>
{% schema %}
{"name":"HOME — Gallery","max_blocks":12,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"VISUAL STORY"},{"type":"text","id":"heading","label":"Heading","default":"Made for every journey."},{"type":"textarea","id":"text","label":"Text","default":"Edit the original gallery content without changing its layout."}],"blocks":[{"type":"image","name":"Gallery image","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"select","id":"row","label":"Row","options":[{"value":"1","label":"Top"},{"value":"2","label":"Bottom"}],"default":"1"}]}],"presets":[{"name":"HOME — Gallery","blocks":[{"type":"image","settings":{"row":"1"}},{"type":"image","settings":{"row":"1"}},{"type":"image","settings":{"row":"1"}},{"type":"image","settings":{"row":"2"}},{"type":"image","settings":{"row":"2"}},{"type":"image","settings":{"row":"2"}}]}]}
{% endschema %}