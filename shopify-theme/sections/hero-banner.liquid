{%- assign img_size = section.settings.heading_image_size | default: 240 -%}

<section class="hb-hero">
  {% if section.settings.video %}
    <video class="hb-media" autoplay muted loop playsinline preload="metadata">
      <source src="{{ section.settings.video.sources.last.url }}" type="video/mp4">
    </video>
  {% elsif section.settings.image %}
    {{ section.settings.image | image_url: width: 1600 | image_tag: class: 'hb-media', loading: 'eager' }}
  {% endif %}
  <div class="hb-overlay"></div>
  <div class="hb-copy">
    {% if section.settings.eyebrow != blank %}<span class="hb-eyebrow" style="color:{{ section.settings.eyebrow_color }};">{{ section.settings.eyebrow }}</span>{% endif %}
    {% if section.settings.heading_image != blank %}
      <img class="hb-heading-img" src="{{ section.settings.heading_image | image_url: width: 1200 }}" alt="{{ section.settings.heading | default: shop.name }}" style="max-height:{{ img_size }}px;">
    {% elsif section.settings.heading != blank %}
      <h1>{{ section.settings.heading }}</h1>
    {% endif %}
    {% if section.settings.body != blank %}<p class="hb-body">{{ section.settings.body }}</p>{% elsif section.settings.tagline != blank %}<p>{{ section.settings.tagline }}</p>{% endif %}
    {% if section.settings.button_text != blank %}
      <a class="hb-btn" href="{{ section.settings.button_link }}">{{ section.settings.button_text }}</a>
    {% endif %}
  </div>
</section>
<style>
  .hb-hero{position:relative;width:100%;aspect-ratio:16/9;min-height:420px;background:#4A382E;overflow:hidden;display:flex;align-items:center;padding:0 28px;}
  .hb-media{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;}
  .hb-overlay{position:absolute;inset:0;background:linear-gradient(90deg,rgba(74,56,46,.62) 0%,rgba(74,56,46,.4) 32%,rgba(74,56,46,.05) 60%);z-index:1;}
  .hb-copy{position:relative;z-index:2;max-width:520px;text-align:left;color:#F5F1E8;}
  .hb-eyebrow{display:block;font-size:11px;letter-spacing:2.5px;text-transform:uppercase;font-weight:700;margin-bottom:12px;}
  .hb-copy h1{color:#F5F1E8;font-size:clamp(22px,3.2vw,34px);margin:0 0 8px;}
  .hb-heading-img{display:block;max-width:100%;width:auto;height:auto;margin:0 0 16px;object-fit:contain;}
  .hb-copy p{font-family:Georgia,serif;font-style:italic;font-size:15px;line-height:1.5;margin:0;}
  .hb-body{font-family:Inter,sans-serif !important;font-style:normal !important;font-size:14px !important;line-height:1.6 !important;opacity:.92;max-width:400px;}
  .hb-btn{display:inline-block;margin-top:18px;background:#C38239;color:#fff;font-weight:600;font-size:13px;padding:12px 28px;border-radius:3px;text-decoration:none;}
  .hb-btn:hover{background:#A8702F;}
  @media(max-width:749px){
    .hb-hero{aspect-ratio:auto;min-height:0;height:60vh;max-height:460px;padding:0 20px;}
    .hb-overlay{background:linear-gradient(to top,rgba(74,56,46,.65) 0%,rgba(74,56,46,.3) 45%,rgba(74,56,46,.1) 100%);}
    .hb-copy{max-width:100%;align-self:flex-end;padding-bottom:24px;}
    .hb-heading-img{max-height:calc({{ img_size }}px * 0.5) !important;}
    .hb-copy p{font-size:12px;}
    .hb-btn{padding:10px 22px;font-size:12px;margin-top:12px;}
  }
</style>
{% schema %}
{
  "name": "Hero banner",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow (optional)" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow text color", "default": "#A97852" },
    { "type": "paragraph", "content": "Fill EITHER heading text OR upload heading image. If image is uploaded, it replaces the text." },
    { "type": "text", "id": "heading", "label": "Heading text" },
    { "type": "image_picker", "id": "heading_image", "label": "Heading image (overrides text)" },
    { "type": "range", "id": "heading_image_size", "label": "Heading image size (max height px)", "min": 60, "max": 400, "step": 20, "default": 240, "unit": "px" },
    { "type": "textarea", "id": "body", "label": "Body text (optional, overrides tagline)" },
    { "type": "text", "id": "tagline", "label": "Tagline (italic, used if no body text)", "default": "Crafted For Every Journey" },
    { "type": "header", "content": "Background" },
    { "type": "image_picker", "id": "image", "label": "Background image (if no video)" },
    { "type": "video", "id": "video", "label": "Background video (overrides image)" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Hero banner" }]
}
{% endschema %}
