<section class="bb2-wrap" {{ section.shopify_attributes }}>
  {% if section.settings.image %}
    <div class="bb2-bg">
      {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', class: 'bb2-bg-img' }}
    </div>
  {% endif %}
  <div class="bb2-overlay"></div>
  <div class="bb2-content">
    <span class="bb2-eyebrow">{{ section.settings.kicker }}</span>
    <h2 class="bb2-heading">{{ section.settings.heading }}</h2>
    <p class="bb2-body">{{ section.settings.quote }}</p>
    {% if section.settings.link_text != blank %}
      <a class="bb2-link" href="{{ section.settings.link }}">{{ section.settings.link_text }} &rarr;</a>
    {% endif %}
  </div>
</section>

<style>
  .bb2-wrap{position:relative;min-height:300px;overflow:hidden;background:#F8F4EA;}
  .bb2-bg{position:absolute;inset:0;}
  .bb2-bg-img{width:100%;height:100%;object-fit:cover;display:block;}
  .bb2-overlay{position:absolute;inset:0;background:linear-gradient(to right, #F8F4EA 0%, #F8F4EA 36%, rgba(248,244,234,0.85) 45%, rgba(248,244,234,0) 62%);pointer-events:none;}
  .bb2-content{position:relative;z-index:2;display:flex;flex-direction:column;justify-content:center;min-height:300px;padding:40px 6vw;max-width:520px;}
  .bb2-eyebrow{font-size:10px;letter-spacing:2.5px;text-transform:uppercase;color:#C38239;font-weight:700;display:block;margin-bottom:16px;}
  .bb2-heading{font-family:'Bebas Neue',sans-serif;font-size:clamp(22px,2.6vw,30px);line-height:1.08;color:#2B2420;margin:0 0 16px;}
  .bb2-body{font-size:14px;line-height:1.7;color:#7A7263;max-width:340px;margin:0 0 20px;}
  .bb2-link{font-size:12px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:#2B2420;text-decoration:none;border-bottom:1px solid #2B2420;padding-bottom:3px;display:inline-block;width:fit-content;}
  .bb2-link:hover{opacity:.7;}

  @media(max-width:900px){
    .bb2-wrap{min-height:0;}
    .bb2-bg-img{min-height:300px;}
    .bb2-overlay{background:linear-gradient(180deg, rgba(248,244,234,0.97) 0%, rgba(248,244,234,0.97) 52%, rgba(248,244,234,0.55) 75%, rgba(248,244,234,0) 100%);}
    .bb2-content{padding:36px 24px;max-width:100%;min-height:300px;}
    .bb2-heading{font-size:20px;}
    .bb2-body{max-width:100%;}
  }
</style>

{% schema %}
{
  "name": "BRAND STORY — Belief v2",
  "settings": [
    {"type":"text","id":"kicker","label":"Kicker","default":"Our Belief"},
    {"type":"text","id":"heading","label":"Heading","default":"Understand First. Create Better."},
    {"type":"textarea","id":"quote","label":"Body text","default":"We believe the right product and experience begin with understanding real everyday needs."},
    {"type":"text","id":"link_text","label":"Link text","default":"Learn More"},
    {"type":"url","id":"link","label":"Link"},
    {"type":"image_picker","id":"image","label":"Background image"}
  ]
}
{% endschema %}