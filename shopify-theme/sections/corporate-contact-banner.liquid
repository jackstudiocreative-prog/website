<section class="ccb-wrap" {{ section.shopify_attributes }}>
  <div class="ccb-left">
    {% if section.settings.eyebrow != blank %}<span class="ccb-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
    <h2 class="ccb-heading">{{ section.settings.heading }}</h2>
    <span class="ccb-divider"></span>
    <p class="ccb-text">{{ section.settings.text }}</p>
  </div>
  <div class="ccb-right">
    <div class="ccb-item">
      <span class="ccb-item-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2a10 10 0 0 0-8.7 15l-1.2 4.4 4.5-1.2A10 10 0 1 0 12 2zm5.6 14.3c-.2.7-1.4 1.3-2 1.4-.5.1-1.1.1-1.8-.1-.4-.1-1-.3-1.6-.6-2.9-1.3-4.8-4.2-4.9-4.4-.1-.2-1.2-1.6-1.2-3 0-1.4.7-2.1 1-2.4.3-.3.6-.4.8-.4h.6c.2 0 .4 0 .6.5.2.5.7 1.8.8 1.9.1.1.1.3 0 .5-.1.2-.2.3-.4.5-.2.2-.4.4-.5.6-.2.2-.4.4-.2.7.2.4 1 1.6 2.1 2.6 1.4 1.3 2.6 1.7 3 1.9.3.2.5.1.7-.1.2-.2.9-1 1.1-1.4.2-.4.5-.3.8-.2.3.1 2 1 2.3 1.1.3.2.5.2.6.3.1.2.1.9-.1 1.6z"/></svg></span>
      <div><strong>WhatsApp</strong><span class="ccb-desc">{{ section.settings.whatsapp_desc }}</span><a href="https://wa.me/{{ section.settings.whatsapp | remove: ' ' | remove: '-' | remove: '+' }}">{{ section.settings.whatsapp }}</a></div>
    </div>
    <div class="ccb-item">
      <span class="ccb-item-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></span>
      <div><strong>Email</strong><span class="ccb-desc">{{ section.settings.email_desc }}</span><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></div>
    </div>
  </div>
</section>

<style>
  .ccb-wrap{display:grid;grid-template-columns:1fr 1.4fr;gap:40px;background:#F4EFDC;color:#2B2420;padding:44px 6vw;align-items:center;}
  .ccb-eyebrow{display:block;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#C4823A;font-weight:700;margin-bottom:10px;}
  .ccb-heading{font-family:'Bebas Neue',sans-serif;font-size:clamp(20px,2.4vw,26px);margin:0;line-height:1.1;color:#2B2420;}
  .ccb-divider{display:block;width:28px;height:2px;background:#2B2420;margin:14px 0 16px;}
  .ccb-text{font-size:13.5px;line-height:1.6;opacity:.85;margin:0;max-width:320px;}
  .ccb-btn{display:inline-block;width:fit-content;background:#C4823A;color:#fff;padding:11px 20px;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;text-decoration:none;border-radius:3px;}
  .ccb-btn:hover{background:#A8702F;}
  .ccb-right{display:flex;flex-wrap:wrap;gap:20px 48px;border-left:1px solid rgba(43,36,32,.18);padding-left:44px;align-self:stretch;align-items:center;}
  .ccb-item{display:flex;align-items:flex-start;gap:12px;}
  .ccb-item-icon{flex-shrink:0;width:38px;height:38px;border-radius:50%;border:1.5px solid rgba(43,36,32,.3);display:flex;align-items:center;justify-content:center;color:#2B2420;}
  .ccb-item strong{display:block;font-size:11.5px;letter-spacing:.5px;text-transform:uppercase;margin-bottom:3px;color:#2B2420;}
  .ccb-desc{display:block;font-size:12px;opacity:.75;margin-bottom:4px;line-height:1.4;color:#2B2420;}
  .ccb-item a{font-size:12.5px;color:#2B2420;font-weight:600;text-decoration:none;}
  .ccb-item a:hover{text-decoration:underline;}

  @media(max-width:900px){
    .ccb-wrap{grid-template-columns:1fr;padding:36px 24px;}
    .ccb-heading{font-size:17px;}
    .ccb-right{gap:20px 32px;border-left:0;border-top:1px solid rgba(43,36,32,.18);padding-left:0;padding-top:24px;margin-top:8px;}
  }
</style>

{% schema %}
{
  "name": "Corporate Contact Banner",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background","default":"#F4EFDC"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Let's Work Together"},
    {"type":"text","id":"heading","label":"Heading","default":"Have A Corporate Project In Mind?"},
    {"type":"textarea","id":"text","label":"Text","default":"Tell us what you need and our team will help you find the right solution for your business."},
    {"type":"header","content":"Button (unused)"},
    {"type":"text","id":"button_text","label":"Button text","default":"Request A Quote"},
    {"type":"url","id":"button_link","label":"Button link"},
    {"type":"header","content":"WhatsApp"},
    {"type":"text","id":"whatsapp_desc","label":"Description","default":"Quick response"},
    {"type":"text","id":"whatsapp","label":"Number","default":"+60 12-345 6789"},
    {"type":"header","content":"Email"},
    {"type":"text","id":"email_desc","label":"Description","default":"General enquiries"},
    {"type":"text","id":"email","label":"Email","default":"corporate@jack-studio.com"},
    {"type":"header","content":"Enquiry Form (unused)"},
    {"type":"text","id":"form_desc","label":"Description","default":"Share your requirements and we'll get back to you."},
    {"type":"text","id":"form_label","label":"Link label","default":"Fill Enquiry Form"},
    {"type":"url","id":"form_link","label":"Link"}
  ]
}
{% endschema %}