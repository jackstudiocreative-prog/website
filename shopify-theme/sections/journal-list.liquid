<section class="jl-hero" style="background:{{ section.settings.bg_color }};">
  {% if section.settings.eyebrow != blank %}<span class="jl-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
  <h1 class="jl-heading">{{ section.settings.heading }}</h1>
  {% if section.settings.subtitle != blank %}<p class="jl-subtitle">{{ section.settings.subtitle }}</p>{% endif %}
</section>

<section class="jl-grid-wrap" style="background:{{ section.settings.grid_bg_color }};">
  {%- assign all_articles = blogs['news'].articles | concat: blogs['promotions-genuine-leather-deals'].articles | sort: 'published_at' | reverse -%}
  <div class="jl-grid">
    {% for article in all_articles %}
      <a class="jl-card" href="{{ article.url }}" style="background:{{ section.settings.card_bg_color }};">
        <div class="jl-card-img">
          {% if article.image %}
            {{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: article.title }}
          {% else %}
            <div class="jl-card-placeholder"></div>
          {% endif %}
        </div>
        <div class="jl-card-body">
          <span class="jl-card-blog">{{ article.blog.title }}</span>
          <h3 class="jl-card-title">{{ article.title }}</h3>
          <span class="jl-card-date">{{ article.published_at | date: '%B %d, %Y' }}</span>
          <p class="jl-card-excerpt">{{ article.excerpt | strip_html | truncate: 120 }}</p>
          <span class="jl-card-link">Read More &rarr;</span>
        </div>
      </a>
    {% else %}
      <p class="jl-empty">No articles yet. Check back soon.</p>
    {% endfor %}
  </div>
</section>

<style>
  .jl-hero{padding:56px 6vw 40px;text-align:center;}
  .jl-eyebrow{display:block;font-size:11px;letter-spacing:2.5px;text-transform:uppercase;color:#C4823A;font-weight:700;margin-bottom:14px;}
  .jl-heading{font-family:'Bebas Neue',sans-serif;font-size:clamp(32px,4.5vw,54px);letter-spacing:1px;color:#2B2420;margin:0 0 12px;line-height:1;}
  .jl-subtitle{font-family:Georgia,serif;font-style:italic;font-size:15px;color:#7A7263;max-width:480px;margin:0 auto;}

  .jl-grid-wrap{padding:8px 6vw 64px;}
  .jl-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;max-width:1300px;margin:0 auto;}
  .jl-card{display:block;text-decoration:none;color:inherit;border-radius:10px;overflow:hidden;transition:box-shadow .2s;}
  .jl-card:hover{box-shadow:0 8px 24px rgba(64,20,16,.10);}
  .jl-card-img{aspect-ratio:4/3;background:#EFE9D8;overflow:hidden;}
  .jl-card-img img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s;}
  .jl-card:hover .jl-card-img img{transform:scale(1.04);}
  .jl-card-placeholder{width:100%;height:100%;background:linear-gradient(135deg,#EFE9D8,#E3DCC8);}
  .jl-card-body{padding:20px 20px 22px;}
  .jl-card-blog{display:block;font-size:10px;letter-spacing:1.5px;text-transform:uppercase;color:#C4823A;font-weight:700;margin-bottom:8px;}
  .jl-card-title{font-family:'Bebas Neue',sans-serif;font-size:19px;letter-spacing:.5px;color:#2B2420;margin:0 0 8px;line-height:1.15;}
  .jl-card-date{display:block;font-size:11px;color:#A79E8A;margin-bottom:10px;}
  .jl-card-excerpt{font-size:13px;line-height:1.55;color:#5A4E3F;margin:0 0 14px;}
  .jl-card-link{font-size:11px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:#2B2420;}
  .jl-empty{grid-column:1/-1;text-align:center;color:#7A7263;font-size:14px;padding:60px 0;}

  @media(max-width:1000px){
    .jl-grid{grid-template-columns:repeat(2,1fr);gap:20px;}
  }
  @media(max-width:640px){
    .jl-heading{font-size:30px;}
    .jl-grid{grid-template-columns:1fr;}
  }
</style>

{% schema %}
{
  "name": "Journal — List",
  "settings": [
    {"type":"color","id":"bg_color","label":"Hero background (top title area)","default":"#F4EFDC"},
    {"type":"color","id":"grid_bg_color","label":"Page background (behind the cards)","default":"#F8F4EA"},
    {"type":"color","id":"card_bg_color","label":"Card background","default":"#F9F4E3"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Stories & Guides"},
    {"type":"text","id":"heading","label":"Heading","default":"Journal"},
    {"type":"textarea","id":"subtitle","label":"Subtitle","default":"Craft, care, and everyday journeys from Jack Studio."}
  ],
  "presets":[{"name":"Journal — List"}]
}
{% endschema %}