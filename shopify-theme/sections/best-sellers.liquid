{%- assign coll = collections[section.settings.collection] -%}
<section class="bs-wrap" style="background:{{ section.settings.bg_color }};">
  <div class="bs-head">
    <div>
      <h2 class="bs-heading">{{ section.settings.heading }}</h2>
      {% if section.settings.subtitle != blank %}<p class="bs-sub">{{ section.settings.subtitle }}</p>{% endif %}
    </div>
    {% if section.settings.viewall_link != blank %}<a class="bs-viewall" href="{{ section.settings.viewall_link }}">{{ section.settings.viewall_text }}</a>{% endif %}
  </div>

  {%- if coll and coll.products.size > 0 -%}
    <div class="bs-grid">
      {%- for product in coll.products limit: section.settings.limit -%}
        {%- assign color_values = nil -%}
        {%- for option in product.options_with_values -%}
          {%- assign opt_lc = option.name | downcase -%}
          {%- if opt_lc contains 'color' or opt_lc contains 'colour' -%}{%- assign color_values = option.values -%}{%- endif -%}
        {%- endfor -%}
        {%- assign rating = product.metafields.reviews.rating.value.rating -%}
        {%- assign rating_count = product.metafields.reviews.rating_count.value -%}
        <div class="bs-card">
          <a href="{{ product.url }}" class="bs-card-photo">
            {% if section.settings.featured_tag != blank %}<span class="bs-tag">{{ section.settings.featured_tag }}</span>{% endif %}
            {% if product.featured_image %}<img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title }}" loading="lazy">{% endif %}
            {% unless product.available %}<span class="bs-badge-out">SOLD OUT</span>{% endunless %}
          </a>
          <button type="button" class="bs-wish-btn" data-wishlist-toggle="{{ product.handle }}" aria-label="Add to wishlist">
            <svg viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10z"/></svg>
          </button>
          <a href="{{ product.url }}" class="bs-card-body">
            <div class="bs-row">
              <div class="bs-title">{{ product.title }}</div>
              <div class="bs-price">{{ product.price | money }}</div>
            </div>
            {% if color_values %}
              <div class="bs-swatches">
                {% for v in color_values limit: 5 %}<span class="bs-swatch" style="background-color:{{ v | strip | downcase }};" title="{{ v }}"></span>{% endfor %}
              </div>
            {% endif %}
            {% if rating %}
              <div class="bs-stars">
                <span class="bs-stars-num">{{ rating }}</span>
                {% for i in (1..5) %}
                  {% if i <= rating %}<svg width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3 7h7l-5.5 4.5L18.5 21 12 16.5 5.5 21l2-7.5L2 9h7z"/></svg>{% else %}<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l3 7h7l-5.5 4.5L18.5 21 12 16.5 5.5 21l2-7.5L2 9h7z"/></svg>{% endif %}
                {% endfor %}
              </div>
            {% endif %}
          </a>
        </div>
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="bs-grid">
      {%- for i in (1..4) -%}
        <div class="bs-card">
          <div class="bs-card-photo bs-photo-placeholder">{% if section.settings.featured_tag != blank %}<span class="bs-tag">{{ section.settings.featured_tag }}</span>{% endif %}</div>
          <div class="bs-card-body">
            <div class="bs-row"><div class="bs-title">Product {{ i }}</div><div class="bs-price">RM 000</div></div>
          </div>
        </div>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>
<style>
  .bs-wrap{padding:56px 32px;}
  .bs-head{display:flex;justify-content:space-between;align-items:center;max-width:1400px;margin:0 auto 32px;gap:20px;flex-wrap:wrap;}
  .bs-heading{font-family:'Bebas Neue',sans-serif;font-size:clamp(26px,3vw,32px);letter-spacing:2px;color:#292724;margin:0 0 6px;}
  .bs-sub{font-family:Georgia,serif;font-style:italic;font-size:15px;color:#716B63;margin:0;}
  .bs-viewall{display:inline-flex;align-items:center;justify-content:center;background:#C38239;color:#F5F1E6;text-decoration:none;font-size:13px;font-weight:700;letter-spacing:.4px;padding:13px 28px;border-radius:999px;white-space:nowrap;transition:background .2s;}
  .bs-viewall:hover{background:#A8702F;}

  .bs-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;max-width:1400px;margin:0 auto;}
  .bs-card{position:relative;border-radius:8px;overflow:hidden;background:#F9F6EF;}

  .bs-card-photo{display:block;position:relative;aspect-ratio:1/1;background:#FFFFFF;overflow:hidden;}
  .bs-card-photo img{width:100%;height:100%;object-fit:contain;display:block;transition:transform .5s;}
  .bs-card:hover .bs-card-photo img{transform:scale(1.04);}
  .bs-photo-placeholder{background:#FFFFFF;}
  .bs-tag{position:absolute;top:14px;left:14px;z-index:1;font-size:11px;letter-spacing:1.1px;text-transform:uppercase;font-weight:700;color:#292724;}
  .bs-badge-out{position:absolute;top:14px;right:14px;background:#292724;color:#F5F1E8;font-size:9px;letter-spacing:1px;padding:4px 7px;border-radius:2px;font-weight:600;}
  .bs-wish-btn{position:absolute;bottom:12px;right:12px;width:28px;height:28px;border-radius:50%;background:#2B2420;border:0;display:flex;align-items:center;justify-content:center;color:#F5F1E6;cursor:pointer;}
  .bs-wish-btn.is-wished{background:#C38239;}

  .bs-card-body{display:block;text-decoration:none;color:#292724;padding:14px 14px 16px;background:#F9F6EF;}
  .bs-row{display:flex;justify-content:space-between;align-items:baseline;gap:8px;margin-bottom:8px;}
  .bs-title{font-size:14px;font-weight:600;line-height:1.3;}
  .bs-price{font-size:13.5px;color:#716B63;white-space:nowrap;}
  .bs-swatches{display:flex;gap:5px;margin-bottom:8px;}
  .bs-swatch{width:13px;height:13px;border-radius:50%;border:1px solid rgba(41,39,36,.18);display:inline-block;}
  .bs-stars{display:flex;align-items:center;gap:2px;color:#A97852;}
  .bs-stars-num{font-size:12px;color:#292724;font-weight:600;margin-right:4px;}

  @media(max-width:1024px){
    .bs-grid{grid-template-columns:repeat(2,1fr);gap:18px;}
  }
  @media(max-width:640px){
    .bs-wrap{padding:36px 16px;}
    .bs-heading{font-size:22px;}
    .bs-head{align-items:flex-start;}
    .bs-viewall{padding:10px 20px;font-size:11px;}
    .bs-grid{grid-template-columns:repeat(2,1fr);gap:14px;}
    .bs-card-body{padding:10px 10px 12px;}
    .bs-title{font-size:11.5px;}
    .bs-price{font-size:11px;}
  }
</style>
{% schema %}
{"name":"Best Sellers","tag":"section","settings":[
{"type":"color","id":"bg_color","label":"Background","default":"#F5F1E8"},
{"type":"text","id":"heading","label":"Heading","default":"BEST SELLERS"},
{"type":"text","id":"subtitle","label":"Subtitle","default":"Loved by many. Chosen for a reason."},
{"type":"text","id":"featured_tag","label":"Card badge text (shown on every card)","default":"Best Seller"},
{"type":"collection","id":"collection","label":"Collection"},
{"type":"range","id":"limit","label":"Number of products","min":3,"max":8,"step":1,"default":4},
{"type":"text","id":"viewall_text","label":"View all button text","default":"Shop All"},
{"type":"url","id":"viewall_link","label":"View all link"}],
"presets":[{"name":"Best Sellers"}]}
{% endschema %}