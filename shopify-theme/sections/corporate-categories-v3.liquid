<section class="cc3-wrap" {{ section.shopify_attributes }}>
  <div class="cc3-head">
    <span class="cc3-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="cc3-title">{{ section.settings.heading }}</h2>
    <p class="cc3-tagline">{{ section.settings.tagline }}</p>
  </div>
  <div class="cc3-grid">
    {% for block in section.blocks %}
      <a class="cc3-card" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
        <div class="cc3-img">
          {% if block.settings.image %}{{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy' }}{% endif %}
          <span class="cc3-num">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <span class="cc3-icon">
            {%- case block.settings.icon -%}
            {%- when 'wallet' -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="6" width="20" height="14" rx="2"/><path d="M16 12h4v4h-4a2 2 0 0 1 0-4z"/></svg>
            {%- when 'award' -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="6"/><path d="M9 13.5 7 22l5-3 5 3-2-8.5"/></svg>
            {%- when 'briefcase' -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="7" width="18" height="13" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
            {%- when 'bag' -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 8h12l1 13H5z"/><path d="M9 8a3 3 0 0 1 6 0"/></svg>
            {%- else -%}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/></svg>
            {%- endcase -%}
          </span>
        </div>
        <h3 class="cc3-name">{{ block.settings.name }}</h3>
        <p class="cc3-desc">{{ block.settings.items }}</p>
        <span class="cc3-link">{{ section.settings.link_text }} &rarr;</span>
      </a>
    {% endfor %}
  </div>
</section>

<style>
  .cc3-wrap{background:{{ section.settings.bg_color }};padding:52px 6vw;}
  .cc3-head{text-align:center;max-width:640px;margin:0 auto 36px;}
  .cc3-eyebrow{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#C4823A;font-weight:700;display:block;margin-bottom:10px;}
  .cc3-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(26px,3vw,32px);letter-spacing:.5px;color:#2B2420;margin:0 0 10px;}
  .cc3-tagline{font-size:14px;color:#7A7263;margin:0;}
  .cc3-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;max-width:1200px;margin:0 auto;}
  .cc3-card{display:block;text-decoration:none;color:inherit;background:#F1EAD9;border-radius:10px;overflow:hidden;transition:box-shadow .2s;}
  .cc3-card:hover{box-shadow:0 8px 22px rgba(64,20,16,.10);}
  .cc3-img{position:relative;aspect-ratio:4/3;background:#EDE4CC;}
  .cc3-img img{width:100%;height:100%;object-fit:cover;display:block;}
  .cc3-num{position:absolute;top:12px;left:12px;background:rgba(248,244,234,.9);color:#2B2420;font-family:'Bebas Neue',sans-serif;font-size:11px;letter-spacing:1px;padding:4px 9px;border-radius:20px;}
  .cc3-icon{position:absolute;left:14px;bottom:-16px;width:32px;height:32px;border-radius:50%;background:#3A2A1E;color:#F4EFDC;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 6px rgba(0,0,0,.2);}
  .cc3-name{font-family:'Bebas Neue',sans-serif;font-size:16px;letter-spacing:.5px;color:#2B2420;margin:26px 16px 8px;}
  .cc3-desc{font-size:12.5px;color:#7A7263;line-height:1.5;margin:0 16px 14px;min-height:32px;}
  .cc3-link{display:block;font-size:11px;font-weight:700;letter-spacing:.5px;text-transform:uppercase;color:#C4823A;margin:0 16px 16px;}

  @media(max-width:900px){
    .cc3-grid{grid-template-columns:repeat(2,1fr);}
    .cc3-title{font-size:22px;}
  }
  @media(max-width:520px){
    .cc3-grid{grid-template-columns:1fr;}
  }
</style>

{% schema %}
{
  "name": "CORPORATE — Categories v3",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background","default":"#F4EFDC"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Product Portfolio"},
    {"type":"text","id":"heading","label":"Heading","default":"Corporate Product Categories"},
    {"type":"textarea","id":"tagline","label":"Tagline","default":"Premium leather goods, curated for every corporate need."},
    {"type":"text","id":"link_text","label":"Card link text","default":"Explore Collection"}
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"select","id":"icon","label":"Icon","default":"wallet","options":[{"value":"wallet","label":"Wallet"},{"value":"award","label":"Award"},{"value":"briefcase","label":"Briefcase"},{"value":"bag","label":"Bag"}]},
        {"type":"text","id":"name","label":"Name","default":"Executive Gifts"},
        {"type":"text","id":"items","label":"Item list (short text)","default":"Premium Wallet · Card Holder · Passport Holder"},
        {"type":"url","id":"link","label":"Link"}
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "CORPORATE — Categories v3",
      "blocks": [
        {"type":"category","settings":{"icon":"wallet","name":"Executive Gifts","items":"Premium Wallet · Card Holder · Passport Holder · Business Backpack"}},
        {"type":"category","settings":{"icon":"award","name":"Employee Rewards","items":"Long Service Award · Joining Kit · Annual Dinner Gift · Retirement Gift"}},
        {"type":"category","settings":{"icon":"briefcase","name":"Event Merchandise","items":"Conference Bag · Delegate Bag · VIP Gift · Speaker Gift · Training Kit"}},
        {"type":"category","settings":{"icon":"bag","name":"Promotional Items","items":"Travel Backpack · Laptop Bag · Toiletry Kit · Corporate Gift Box"}}
      ]
    }
  ]
}
{% endschema %}