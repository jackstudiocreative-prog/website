<section class="cc-wrap" style="background:{{ section.settings.bg_color }};">
  <div class="cc-layout">
    <div class="cc-side">
      {% if section.settings.heading != blank %}<h2 class="cc-heading">{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.viewall_text != blank %}<a class="cc-viewall" href="{{ section.settings.viewall_link | default: '#' }}">{{ section.settings.viewall_text }} &rarr;</a>{% endif %}
    </div>

    <div class="cc-carousel">
      <button type="button" class="cc-arrow cc-arrow-prev" data-cc-prev aria-label="Previous">&larr;</button>
      <button type="button" class="cc-arrow cc-arrow-next" data-cc-next aria-label="Next">&rarr;</button>

      <div class="cc-rail" data-cc-rail>
        {% for block in section.blocks %}
          {%- assign cc_img_src = block.settings.image_url -%}
          {%- if cc_img_src == blank and block.settings.image -%}{%- assign cc_img_src = block.settings.image | image_url: width: 700 -%}{%- endif -%}
          {% assign cc_base_url = block.settings.url | default: '#' %}
          {% assign cc_slug = block.settings.title | handleize %}
          {% assign cc_sep = '?' %}
          {% if cc_base_url contains '?' %}{% assign cc_sep = '&' %}{% endif %}
          <a class="cc-card" href="{% unless cc_base_url == '#' %}{{ cc_base_url }}{{ cc_sep }}series={{ cc_slug }}{% else %}#{% endunless %}" data-cc-card {{ block.shopify_attributes }}>
            <div class="cc-img-wrap">
              {% if cc_img_src != blank %}<img class="cc-img" src="{{ cc_img_src }}" alt="{{ block.settings.title }}" loading="lazy">{% endif %}
            </div>
            <span class="cc-btn" style="background:{{ block.settings.accent | default: '#292724' }};">{{ block.settings.title }}</span>
          </a>
        {% endfor %}
      </div>

      {% if section.blocks.size > 1 %}
        <div class="cc-dots" data-cc-dots>
          {% for block in section.blocks %}
            <button type="button" class="cc-dot" data-cc-dot="{{ forloop.index0 }}" aria-label="Go to {{ block.settings.title }}"></button>
          {% endfor %}
        </div>
      {% endif %}
    </div>
  </div>
</section>

<style>
  .cc-wrap{background:#F5F1E8;padding:48px 0 56px;max-width:100vw;overflow:hidden;}
  .cc-layout{display:flex;gap:40px;max-width:1400px;margin:0 auto;padding:0 24px;align-items:flex-start;}
  .cc-side{flex:0 0 220px;padding-top:6px;}
  .cc-heading{font-family:'Bebas Neue',sans-serif;font-size:clamp(20px,2.2vw,26px);letter-spacing:1px;color:#292724;margin:0 0 14px;line-height:1.1;}
  .cc-viewall{font-size:11px;letter-spacing:1px;text-transform:uppercase;font-weight:700;color:#292724;text-decoration:underline;white-space:nowrap;}

  .cc-carousel{position:relative;flex:1;min-width:0;max-width:100%;}
  .cc-rail{display:flex;gap:28px;overflow-x:scroll;overflow-y:hidden;scroll-snap-type:x proximity;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;touch-action:pan-x;scrollbar-width:none;padding-bottom:6px;-webkit-transform:translateZ(0);transform:translateZ(0);will-change:scroll-position;}
  .cc-rail::-webkit-scrollbar{display:none;}

  .cc-card{flex:0 0 clamp(230px,24vw,320px);position:relative;display:block;text-decoration:none;scroll-snap-align:start;margin-bottom:26px;touch-action:pan-x;-webkit-user-drag:none;user-select:none;}
  .cc-img-wrap{aspect-ratio:3/4;border-radius:14px;overflow:hidden;background:#E9E2D5;pointer-events:none;}
  .cc-img{width:100%;height:100%;object-fit:cover;display:block;transition:transform .5s ease;pointer-events:none;-webkit-user-drag:none;}
  .cc-card:hover .cc-img{transform:scale(1.045);}

  .cc-btn{position:absolute;left:14px;right:14px;bottom:-20px;text-align:center;color:#F5F1E8;font-family:'Inter',sans-serif;font-weight:700;font-size:11px;letter-spacing:1.2px;text-transform:uppercase;padding:15px 10px;border-radius:6px;box-shadow:0 10px 22px rgba(41,39,36,.22);pointer-events:none;}

  .cc-arrow{position:absolute;top:calc(50% - 26px);width:40px;height:40px;border-radius:50%;border:1px solid #D9CFC0;background:#F5F1E8;color:#292724;font-size:16px;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:2;transition:background .2s;}
  .cc-arrow:hover{background:#E9E2D5;}
  .cc-arrow-prev{left:-8px;}
  .cc-arrow-next{right:-8px;}

  .cc-dots{display:flex;justify-content:center;align-items:center;gap:12px;margin-top:38px;}
  .cc-dot{position:relative;width:9px;height:9px;padding:0;border-radius:50%;border:1px solid rgba(41,39,36,.35);background:#C9BFA6;cursor:pointer;transition:background .2s,width .2s,border-color .2s;flex:0 0 auto;}
  .cc-dot::after{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:34px;height:34px;}
  .cc-dot.is-active{background:#A97852;border-color:#A97852;width:24px;border-radius:5px;}

  @media(max-width:900px){
    .cc-layout{flex-direction:column;gap:16px;}
    .cc-side{flex:0 0 auto;}
    .cc-heading{font-size:18px;}
    .cc-arrow{display:none;}
  }
  @media(max-width:640px){
    .cc-card{flex:0 0 68vw;}
    .cc-btn{font-size:10px;padding:12px 8px;}
    .cc-dots{margin-top:34px;gap:14px;}
    .cc-dot{width:10px;height:10px;}
    .cc-dot.is-active{width:26px;}
  }
</style>

{% javascript %}
  document.querySelectorAll('[data-cc-rail]').forEach(function (rail) {
    var carousel = rail.closest('.cc-carousel');
    if (!carousel) return;
    var cards = Array.prototype.slice.call(rail.querySelectorAll('[data-cc-card]'));
    var dots = Array.prototype.slice.call(carousel.querySelectorAll('[data-cc-dot]'));
    var prevBtn = carousel.querySelector('[data-cc-prev]');
    var nextBtn = carousel.querySelector('[data-cc-next]');

    function setActive(i) {
      dots.forEach(function (d, idx) { d.classList.toggle('is-active', idx === i); });
    }

    function scrollToCard(i) {
      var card = cards[i];
      if (!card) return;
      rail.scrollTo({ left: card.offsetLeft - rail.offsetLeft, behavior: 'smooth' });
    }

    dots.forEach(function (dot, idx) {
      dot.addEventListener('click', function () { scrollToCard(idx); });
    });

    function step(dir) {
      var w = cards[0] ? cards[0].getBoundingClientRect().width + 28 : 300;
      rail.scrollBy({ left: dir * w, behavior: 'smooth' });
    }
    if (prevBtn) prevBtn.addEventListener('click', function () { step(-1); });
    if (nextBtn) nextBtn.addEventListener('click', function () { step(1); });

    var ticking = false;
    function updateActiveFromScroll() {
      var maxScroll = rail.scrollWidth - rail.clientWidth;
      var idx;
      if (maxScroll <= 0) {
        idx = 0;
      } else if (rail.scrollLeft >= maxScroll - 1) {
        idx = cards.length - 1;
      } else {
        var fraction = rail.scrollLeft / maxScroll;
        idx = Math.round(fraction * (cards.length - 1));
      }
      setActive(idx);
    }
    rail.addEventListener('scroll', function () {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(function () {
        updateActiveFromScroll();
        ticking = false;
      });
    });

    setActive(0);

    /* Manual drag support (mouse + touch) as a fallback for environments
       where native overflow-x panning is blocked by ancestor CSS */
    var isDown = false, startX = 0, startScroll = 0, moved = false;

    function pointerX(e) {
      return (e.touches && e.touches[0]) ? e.touches[0].clientX : e.clientX;
    }
    function dragStart(e) {
      isDown = true; moved = false;
      startX = pointerX(e);
      startScroll = rail.scrollLeft;
    }
    function dragMove(e) {
      if (!isDown) return;
      var x = pointerX(e);
      var delta = startX - x;
      if (Math.abs(delta) > 4) moved = true;
      rail.scrollLeft = startScroll + delta;
    }
    function dragEnd() { isDown = false; }

    rail.addEventListener('touchstart', dragStart, { passive: true });
    rail.addEventListener('touchmove', dragMove, { passive: true });
    rail.addEventListener('touchend', dragEnd);
    rail.addEventListener('mousedown', dragStart);
    window.addEventListener('mousemove', dragMove);
    window.addEventListener('mouseup', dragEnd);

    cards.forEach(function (card) {
      card.addEventListener('click', function (e) { if (moved) e.preventDefault(); });
    });
  });
{% endjavascript %}

{% schema %}
{"name":"Category Cards","tag":"section","settings":[
{"type":"color","id":"bg_color","label":"Background","default":"#F5F1E8"},
{"type":"text","id":"heading","label":"Heading (optional)"},
{"type":"text","id":"viewall_text","label":"View all text (optional)"},
{"type":"url","id":"viewall_link","label":"View all link"}],
"blocks":[{"type":"card","name":"Card","settings":[
{"type":"image_picker","id":"image","label":"Image"},
{"type":"url","id":"image_url","label":"Image URL (optional — overrides Image above if filled in)"},
{"type":"text","id":"title","label":"Title","default":"CATEGORY"},
{"type":"text","id":"subtitle","label":"Subtitle","default":"Short tagline"},
{"type":"color","id":"accent","label":"Accent color","default":"#292724"},
{"type":"url","id":"url","label":"Link"}]}],
"max_blocks":10,
"presets":[{"name":"Category Cards"}]}
{% endschema %}