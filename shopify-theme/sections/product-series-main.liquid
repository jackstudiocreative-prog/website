<div class="breadcrumb"><a href="{{ routes.root_url }}">Home</a><span>Product Collection</span></div>
<div class="page-intro" {{ section.shopify_attributes }}>
  <h1>{{ section.settings.heading }}</h1>
  <p>{{ section.settings.subtitle }}</p>
</div>

<div class="more-categories">
  <div class="mc-title">{{ section.settings.more_title }}</div>
  <div class="mc-scroll">
    {% for block in section.blocks %}
      <div class="mc-card" {{ block.shopify_attributes }} style="{% if block.settings.image != blank %}background-image:url('{{ block.settings.image | image_url: width:900 }}');{% endif %}" onclick="openSeries('series-{{ block.id }}',this)">
        <div class="mc-label">{{ block.settings.title }}</div>
      </div>
    {% endfor %}
  </div>
</div>

{% for block in section.blocks %}
  <div id="series-{{ block.id }}" class="expand-panel">
    <div class="ep-head">
      <h2>{{ block.settings.title }}</h2>
      <div class="ep-tag">{{ block.settings.tagline }}</div>
    </div>
    {% for row in (1..4) %}
      {% capture shelf %}shelf_{{ row }}{% endcapture %}
      {% capture names %}names_{{ row }}{% endcapture %}
      {% if block.settings[shelf] != blank %}
        <div class="shelf-section">
          <div class="shelf-head">
            <h3>{{ block.settings[shelf] }}</h3>
            <a class="view-all" href="{{ block.settings.view_link }}">VIEW ALL</a>
          </div>
          <div class="shelf-scroll">
            {% assign products = block.settings.collection.products %}
            {% if products != blank %}
              {% for product in products limit:5 %}
                <div class="shelf-item" onclick="openProduct(this)">
                  <div class="simg" style="background-image:url('{{ product.featured_image | image_url: width:600 }}')"></div>
                  <div class="sname">{{ product.title }}</div>
                  <div class="qty-box">
                    <button onclick="event.stopPropagation();changeQty(this,-1)">−</button>
                    <div class="qty-val">0</div>
                    <button onclick="event.stopPropagation();changeQty(this,1)">+</button>
                  </div>
                </div>
              {% endfor %}
            {% else %}
              {% assign arr = block.settings[names] | split: ',' %}
              {% for name in arr %}
                {% assign img_key = 'img_' | append: row | append: '_' | append: forloop.index %}
                <div class="shelf-item" onclick="openProduct(this)">
                  <div class="simg" style="{% if block.settings[img_key] != blank %}background-image:url('{{ block.settings[img_key] | image_url: width:600 }}');{% elsif block.settings.image != blank %}background-image:url('{{ block.settings.image | image_url: width:600 }}');{% endif %}"></div>
                  <div class="sname">{{ name | strip }}</div>
                  <div class="qty-box">
                    <button onclick="event.stopPropagation();changeQty(this,-1)">−</button>
                    <div class="qty-val">0</div>
                    <button onclick="event.stopPropagation();changeQty(this,1)">+</button>
                  </div>
                </div>
              {% endfor %}
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
    <div class="ep-close" onclick="closeSeries()">Close collection</div>
  </div>
{% endfor %}

<div class="product-modal-overlay" id="productModal" onclick="if(event.target===this)closeProduct()">
  <div class="product-modal">
    <button class="pm-close" onclick="closeProduct()">×</button>
    <div class="pm-photo" id="pmPhoto"></div>
    <div class="pm-info">
      <div class="pm-eyebrow" id="pmEyebrow"></div>
      <div class="pm-name" id="pmName"></div>
      <div class="pm-sub" id="pmSub"></div>
      <div class="pm-price">{{ section.settings.default_price }}</div>
      <p class="pm-desc" id="pmDesc"></p>
      <div class="pm-actions">
        <a class="btn primary" href="{{ routes.cart_url }}">VIEW CART</a>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "PRODUCT SERIES — Main",
  "max_blocks": 8,
  "settings": [
    {"type":"text","id":"heading","label":"Page heading","default":"Product Collection"},
    {"type":"text","id":"subtitle","label":"Subtitle","default":"(Unnamed)"},
    {"type":"text","id":"more_title","label":"More categories title","default":"More Categories"},
    {"type":"text","id":"default_price","label":"Default price","default":"RM 149.00"}
  ],
  "blocks": [
    {
      "type": "series",
      "name": "Series",
      "settings": [
