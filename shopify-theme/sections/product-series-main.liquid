        {"type":"image_picker","id":"img_1_3","label":"Shelf 1 - Product 3 image"},
        {"type":"image_picker","id":"img_1_4","label":"Shelf 1 - Product 4 image"},
        {"type":"image_picker","id":"img_1_5","label":"Shelf 1 - Product 5 image"},
        {"type":"text","id":"shelf_2","label":"Shelf 2 title","default":"Wallets"},
        {"type":"textarea","id":"names_2","label":"Shelf 2 manual names","default":"Classic Wallet,Card Holder,Passport Holder"},
        {"type":"image_picker","id":"img_2_1","label":"Shelf 2 - Product 1 image"},
        {"type":"image_picker","id":"img_2_2","label":"Shelf 2 - Product 2 image"},
        {"type":"image_picker","id":"img_2_3","label":"Shelf 2 - Product 3 image"},
        {"type":"image_picker","id":"img_2_4","label":"Shelf 2 - Product 4 image"},
        {"type":"image_picker","id":"img_2_5","label":"Shelf 2 - Product 5 image"},
        {"type":"text","id":"shelf_3","label":"Shelf 3 title","default":"Accessories"},
        {"type":"textarea","id":"names_3","label":"Shelf 3 manual names","default":"Pouch,Key Holder,Belt"},
        {"type":"image_picker","id":"img_3_1","label":"Shelf 3 - Product 1 image"},
        {"type":"image_picker","id":"img_3_2","label":"Shelf 3 - Product 2 image"},
        {"type":"image_picker","id":"img_3_3","label":"Shelf 3 - Product 3 image"},
        {"type":"image_picker","id":"img_3_4","label":"Shelf 3 - Product 4 image"},
        {"type":"image_picker","id":"img_3_5","label":"Shelf 3 - Product 5 image"},
        {"type":"text","id":"shelf_4","label":"Shelf 4 title","default":"Travel"},
        {"type":"textarea","id":"names_4","label":"Shelf 4 manual names","default":"Travel Pouch,Organizer"},
        {"type":"image_picker","id":"img_4_1","label":"Shelf 4 - Product 1 image"},
        {"type":"image_picker","id":"img_4_2","label":"Shelf 4 - Product 2 image"},
        {"type":"image_picker","id":"img_4_3","label":"Shelf 4 - Product 3 image"},
        {"type":"image_picker","id":"img_4_4","label":"Shelf 4 - Product 4 image"},
        {"type":"image_picker","id":"img_4_5","label":"Shelf 4 - Product 5 image"},
        {"type":"url","id":"view_link","label":"View all link"}
      ]
    }
  ],
  "presets": [
    {
      "name": "PRODUCT SERIES — Main",
      "blocks": [
        {"type":"series","settings":{"title":"Urban Carry","tagline":"Carry smart. Move freely."}},
        {"type":"series","settings":{"title":"Craft Heritage","tagline":"Crafted with character."}},
        {"type":"series","settings":{"title":"Travel Movement","tagline":"Made for every journey."}},
