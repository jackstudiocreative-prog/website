<div class="ct-wrap">
  <h1 class="ct-title">{{ page.title }}</h1>
  {% if page.content != blank %}<div class="ct-body">{{ page.content }}</div>{% endif %}

  <div class="ct-info">
    <div><strong>Email:</strong> <a href="mailto:sales.jackstudio@gmail.com">sales.jackstudio@gmail.com</a></div>
    <div><strong>Phone:</strong> <a href="tel:0116060127">011-6060 1277</a></div>
    <div><strong>Address:</strong> 3060, Persiaran Raja Muda Musa, Kampung Raja Uda, 42000 Pelabuhan Klang, Selangor</div>
  </div>

  {% form 'contact' %}
    {% if form.posted_successfully? %}<p class="ct-success">Thanks! We'll get back to you soon.</p>{% endif %}
    <div class="ct-row">
      <input type="text" name="contact[name]" placeholder="Name">
      <input type="email" name="contact[email]" placeholder="Email *" required>
    </div>
    <input type="tel" name="contact[phone]" placeholder="Phone number">
    <textarea name="contact[body]" rows="5" placeholder="Comment"></textarea>
    <button type="submit">Send</button>
  {% endform %}
</div>
<style>
  .ct-wrap{max-width:640px;margin:0 auto;padding:60px 24px;color:#2B2420;}
  .ct-title{font-family:'Bebas Neue',sans-serif;font-size:36px;margin:0 0 24px;}
  .ct-body{font-size:15px;line-height:1.7;color:#4a3f33;margin-bottom:24px;}
  .ct-info{margin-bottom:32px;font-size:14px;line-height:2;}
  .ct-info a{color:#2B2420;}
  .ct-row{display:flex;gap:12px;margin-bottom:12px;}
  .ct-wrap input,.ct-wrap textarea{width:100%;padding:12px 14px;border:1px solid #D8CFB8;border-radius:4px;font:inherit;font-size:14px;margin-bottom:12px;background:#F9F4E3;}
  .ct-wrap button{background:#2B2420;color:#F4EFDC;border:0;padding:12px 28px;border-radius:4px;font-size:14px;font-weight:600;cursor:pointer;}
  .ct-success{background:#8DA68A;color:#fff;padding:12px 16px;border-radius:4px;margin-bottom:16px;}
  @media(max-width:500px){.ct-row{flex-direction:column;gap:0;}}
</style>
{% schema %}
{"name":"Contact Page","settings":[]}
{% endschema %}