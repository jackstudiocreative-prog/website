<div class="sr-wrap">
  <h2>{{ section.settings.heading }}</h2>
  <div class="sr-sub">{{ section.settings.subtitle }}</div>
  <div class="sr-stage">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy' }}
    {% else %}
      <span class="sr-label">360° Product View</span>
    {% endif %}
  </div>
  {% if section.settings.button_text != blank %}
    <a class="sr-btn" href="{{ section.settings.button_link }}">{{ section.settings.button_text }}</a>
  {% endif %}
</div>
<style>
  .sr-wrap{padding:48px 24px;text-align:center;background:#F4EFDC;color:#2B2420;}
  .sr-wrap h2{font-size:24px;margin:0 0 8px;}
  .sr-sub{color:#7A7263;font-size:13px;margin-bottom:24px;}
  .sr-stage{max-width:480px;margin:0 auto 24px;aspect-ratio:1/1;background:#EFEAD9;border-radius:8px;display:flex;align-items:center;justify-content:center;overflow:hidden;}
  .sr-stage img{width:100%;height:100%;object-fit:cover;}
  .sr-label{color:#A69C86;font-size:11px;letter-spacing:1px;text-transform:uppercase;}
  .sr-btn{display:inline-block;background:#C38239;color:#fff;font-weight:600;font-size:13px;padding:12px 28px;border-radius:3px;text-decoration:none;}
</style>
{% schema %}
{
  "name": "Showroom 360",
  "settings": [
    { "type": "text", "id": "heading", "label": "标题", "default": "Showroom 360°" },
    { "type": "text", "id": "subtitle", "label": "副标题", "default": "Drag to explore every stitch and angle." },
    { "type": "image_picker", "id": "image", "label": "展示图片" },
    { "type": "text", "id": "button_text", "label": "按钮文字", "default": "Explore Showroom" },
    { "type": "url", "id": "button_link", "label": "按钮链接" }
  ],
  "presets": [{ "name": "Showroom 360" }]
}
{% endschema %}