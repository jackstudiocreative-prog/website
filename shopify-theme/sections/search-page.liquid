<div class="sr-wrap">
  <form action="{{ routes.search_url }}" method="get" class="sr-form">
    <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search products..." class="sr-input" autofocus>
    <button type="submit" class="sr-btn">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><line x1="16.5" y1="16.5" x2="21" y2="21"/></svg>
    </button>
  </form>

  {% if search.performed %}
    <div class="sr-meta">
      {% if search.results_count > 0 %}
        {{ search.results_count }} result{% if search.results_count != 1 %}s{% endif %} for “{{ search.terms }}”
      {% else %}
        No results for “{{ search.terms }}”
      {% endif %}
    </div>

    {% if search.results_count > 0 %}
      <div class="sr-grid">
        {% for item in search.results %}
          {% if item.object_type == 'product' %}
            <a class="sr-card" href="{{ item.url }}">
              <div class="sr-img">
                {% if item.featured_image %}{{ item.featured_image | image_url: width: 500, height: 625, crop: 'center' | image_tag: loading: 'lazy', alt: item.title }}{% endif %}
              </div>
              <div class="sr-name">{{ item.title }}</div>
              <div class="sr-price">{{ item.price | money }}</div>
            </a>
          {% elsif item.object_type == 'page' %}
            <a class="sr-card sr-card-page" href="{{ item.url }}">
              <div class="sr-page-icon">☰</div>
              <div class="sr-name">{{ item.title }}</div>
              <div class="sr-page-label">Page</div>
            </a>
          {% elsif item.object_type == 'article' %}
            <a class="sr-card sr-card-page" href="{{ item.url }}">
              <div class="sr-page-icon">☰</div>
              <div class="sr-name">{{ item.title }}</div>
              <div class="sr-page-label">Article</div>
            </a>
          {% endif %}
        {% endfor %}
      </div>
    {% else %}
      <div class="sr-empty">
        <p>Try checking your spelling or use more general terms.</p>
        <a href="/collections/all" class="sr-empty-link">Browse All Products &rarr;</a>
      </div>
    {% endif %}
  {% else %}
    <div class="sr-empty">
      <p>Search for products, pages and more.</p>
    </div>
  {% endif %}
</div>

<style>
  .sr-wrap{max-width:1200px;margin:0 auto;padding:48px 24px 80px;color:#2B2420;}
  .sr-form{display:flex;gap:10px;max-width:560px;margin:0 auto 40px;border-bottom:2px solid #2B2420;padding-bottom:12px;}
  .sr-input{flex:1;border:0;background:transparent;font-size:17px;font-family:'Bebas Neue',sans-serif;letter-spacing:1px;color:#2B2420;outline:none;}
  .sr-input::placeholder{color:#B3AA8F;}
  .sr-btn{background:none;border:0;cursor:pointer;color:#2B2420;padding:4px;}
  .sr-meta{text-align:center;font-size:12px;color:#7A7263;letter-spacing:1px;text-transform:uppercase;margin-bottom:32px;}
  .sr-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;}
  .sr-card{text-decoration:none;color:inherit;display:block;}
  .sr-img{aspect-ratio:4/5;background:#F9F4E3;border-radius:4px;overflow:hidden;margin-bottom:12px;}
  .sr-img img{width:100%;height:100%;object-fit:cover;display:block;}
  .sr-name{font-size:13px;font-weight:600;margin-bottom:4px;line-height:1.3;}
  .sr-price{font-size:13px;color:#7A7263;}
  .sr-card-page{border:1px solid #E3DCC8;border-radius:4px;padding:20px;text-align:center;}
  .sr-page-icon{font-size:24px;margin-bottom:8px;opacity:.5;}
  .sr-page-label{font-size:10px;letter-spacing:1px;text-transform:uppercase;color:#C4823A;margin-top:4px;}
  .sr-empty{text-align:center;padding:60px 20px;color:#7A7263;font-size:14px;}
  .sr-empty-link{display:inline-block;margin-top:16px;color:#2B2420;font-weight:600;text-decoration:underline;}
  @media(max-width:768px){.sr-grid{grid-template-columns:repeat(2,1fr);gap:16px;}.sr-input{font-size:15px;}}
</style>
{% schema %}
{"name":"Search results","settings":[]}
{% endschema %}