{%- assign wa_number = section.settings.whatsapp_number | remove: ' ' | remove: '-' | remove: '+' -%}
<section class="cct" style="--cct-bg:{{ section.settings.bg_color }};" {{ section.shopify_attributes }}>
  {%- if section.settings.image -%}
    {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '800,1200,1800', sizes: '100vw', class: 'cct-bgimg', alt: '' }}
  {%- endif -%}
  <div class="cct-inner">
    <div class="cct-copy">
      {%- if section.settings.eyebrow != blank -%}<p class="cct-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h2 class="cct-heading">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="cct-text">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="cct-side">
      {%- if wa_number != blank and section.settings.button_label != blank -%}
        <a class="cct-btn" href="https://wa.me/{{ wa_number }}{% if section.settings.whatsapp_message != blank %}?text={{ section.settings.whatsapp_message | url_encode }}{% endif %}" target="_blank" rel="noopener">
          {{ section.settings.button_label }}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M13 7l5 5-5 5"/></svg>
        </a>
      {%- endif -%}
      <p class="cct-contact">
        {%- if section.settings.phone_display != blank -%}<a href="https://wa.me/{{ wa_number }}" target="_blank" rel="noopener">{{ section.settings.phone_display }}</a>{%- endif -%}
        {%- if section.settings.phone_display != blank and section.settings.email != blank -%}<span aria-hidden="true"> &bull; </span>{%- endif -%}
        {%- if section.settings.email != blank -%}<a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a>{%- endif -%}
      </p>
    </div>
  </div>
</section>

<style>
  .cct{position:relative;overflow:hidden;background:var(--cct-bg);background-image:linear-gradient(110deg,rgba(255,255,255,.08),rgba(0,0,0,.08));}
  .cct-bgimg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.25;mix-blend-mode:multiply;}
  .cct-inner{position:relative;z-index:1;max-width:1440px;margin:0 auto;padding:clamp(44px,5vw,64px) clamp(20px,5vw,72px);display:flex;justify-content:space-between;align-items:center;gap:32px;}
  .cct-eyebrow{margin:0 0 14px;font-family:'Inter',sans-serif;font-size:11px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:rgba(251,248,240,.8);}
  .cct-heading{max-width:640px;margin:0 0 14px;font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:clamp(38px,4.4vw,60px);line-height:.95;color:#FBF8F0;}
  .cct-text{margin:0;font-family:'Inter',sans-serif;font-size:13px;line-height:1.6;color:rgba(251,248,240,.9);}
  .cct-side{flex-shrink:0;display:flex;flex-direction:column;align-items:flex-start;gap:14px;}
  .cct-btn{display:inline-flex;align-items:center;gap:14px;height:46px;padding:0 24px;background:#FBF8F0;color:#401410;font-family:'Inter',sans-serif;font-size:13px;font-weight:600;text-decoration:none;transition:background .25s,color .25s;}
  .cct-btn:hover{background:#401410;color:#FBF8F0;}
  .cct-btn:focus-visible{outline:2px solid #FBF8F0;outline-offset:3px;}
  .cct-btn svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.8;stroke-linecap:round;stroke-linejoin:round;}
  .cct-contact{margin:0;font-family:'Inter',sans-serif;font-size:11px;color:rgba(251,248,240,.9);}
  .cct-contact a{color:inherit;text-decoration:none;}
  .cct-contact a:hover{text-decoration:underline;}

  @media(max-width:800px){
    .cct-inner{flex-direction:column;align-items:flex-start;}
  }
</style>

{% schema %}
{
  "name": "Corporate — CTA",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background","default":"#6E8B67"},
    {"type":"image_picker","id":"image","label":"Background texture (optional)"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Let's make it meaningful"},
    {"type":"text","id":"heading","label":"Heading","default":"Have a corporate project in mind?"},
    {"type":"textarea","id":"text","label":"Text","default":"Tell us your requirements. We'll help you explore suitable gifting options."},
    {"type":"header","content":"WhatsApp"},
    {"type":"text","id":"button_label","label":"Button label","default":"Start a WhatsApp Enquiry"},
    {"type":"text","id":"whatsapp_number","label":"Number (with country code)","default":"601112015288"},
    {"type":"text","id":"whatsapp_message","label":"Pre-filled message","default":"Hi Jack Studio, I'd like to enquire about corporate gifting."},
    {"type":"text","id":"phone_display","label":"Phone (displayed)","default":"+60 11-1201 5288"},
    {"type":"text","id":"email","label":"Email","default":"sales.jackstudio@gmail.com"}
  ],
  "presets": [{"name":"Corporate — CTA"}]
}
{% endschema %}
