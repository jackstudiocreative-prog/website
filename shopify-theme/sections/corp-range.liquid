<section class="crg" id="corporate-range" style="--crg-bg:{{ section.settings.bg_color }};" {{ section.shopify_attributes }}>
  <div class="crg-inner">
    <div class="crg-head">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="crg-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="crg-heading">{{ section.settings.heading }}</h2>{%- endif -%}
      </div>
      {%- if section.settings.text != blank -%}<p class="crg-side">{{ section.settings.text }}</p>{%- endif -%}
    </div>
    <div class="crg-grid">
      {%- for block in section.blocks -%}
        <a class="crg-card" href="{{ block.settings.link | default: '#' }}" {{ block.shopify_attributes }}>
          {%- if block.settings.image -%}
            {{ block.settings.image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '400,600,900', sizes: '(max-width: 749px) 100vw, (max-width: 1100px) 50vw, 25vw', class: 'crg-img', alt: '' }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'crg-img crg-ph' }}
          {%- endif -%}
          <span class="crg-body">
            <span class="crg-title">{{ block.settings.title }}</span>
            {%- if block.settings.desc != blank -%}<span class="crg-desc">{{ block.settings.desc }}</span>{%- endif -%}
          </span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .crg{background:var(--crg-bg);}
  .crg-inner{max-width:1440px;margin:0 auto;padding:clamp(48px,6vw,88px) clamp(20px,5vw,72px);}
  .crg-head{display:flex;justify-content:space-between;align-items:flex-end;gap:32px;margin-bottom:clamp(24px,2.5vw,32px);}
  .crg-eyebrow{margin:0 0 14px;font-family:'Inter',sans-serif;font-size:11px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:#B87635;}
  .crg-heading{margin:0;font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:clamp(40px,4.6vw,64px);line-height:.95;color:#401410;}
  .crg-side{max-width:300px;margin:0 0 6px;font-family:'Inter',sans-serif;font-size:13px;line-height:1.6;color:#5A4E3F;}
  .crg-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(12px,1.4vw,18px);}
  .crg-card{position:relative;display:block;aspect-ratio:3/4;overflow:hidden;border-radius:8px;background:#3A2418;color:#FBF8F0;text-decoration:none;}
  .crg-card:focus-visible{outline:2px solid #C38239;outline-offset:3px;}
  .crg-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;transition:transform .6s ease;}
  .crg-ph{background:#5A3A28;}
  .crg-card:hover .crg-img{transform:scale(1.04);}
  .crg-card::after{content:"";position:absolute;inset:0;background:linear-gradient(0deg,rgba(40,24,16,.78) 0%,rgba(40,24,16,.35) 30%,transparent 55%);pointer-events:none;}
  .crg-body{position:absolute;left:16px;right:16px;bottom:18px;z-index:1;display:flex;flex-direction:column;gap:4px;}
  .crg-title{font-family:'Inter',sans-serif;font-size:14px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;line-height:1.3;color:#FBF8F0;}
  .crg-desc{font-family:'Inter',sans-serif;font-size:12px;line-height:1.5;color:rgba(251,248,240,.9);}

  @media(max-width:1100px){ .crg-grid{grid-template-columns:repeat(2,1fr);} }
  @media(max-width:749px){
    .crg-head{display:block;}
    .crg-side{max-width:none;margin-top:14px;}
    .crg-grid{grid-template-columns:1fr;}
  }
</style>

{% schema %}
{
  "name": "Corporate — Range",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background","default":"#FBF7EF"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"01 / Explore our range"},
    {"type":"text","id":"heading","label":"Heading","default":"Find the right gift."},
    {"type":"textarea","id":"text","label":"Side text","default":"A curated selection of leather goods for every business occasion. Choose a category to get started."},
    {"type":"text","id":"link_text","label":"Card link text (not shown)","default":"View category"}
  ],
  "blocks": [
    {
      "type":"category",
      "name":"Category",
      "settings":[
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"text","id":"title","label":"Title","default":"Executive Gifts"},
        {"type":"textarea","id":"desc","label":"Description","default":"Wallets, card holders and refined everyday essentials."},
        {"type":"url","id":"link","label":"Link"}
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{"name":"Corporate — Range"}]
}
{% endschema %}
