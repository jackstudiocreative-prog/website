<section class="ci-wrap" style="background:{{ section.settings.bg_color }};">
  <div class="ci-grid">
    <div class="ci-image">
      {% if section.settings.image %}<img src="{{ section.settings.image | image_url: width: 1400 }}" alt="{{ section.settings.heading }}" loading="lazy">{% endif %}
    </div>
    <div class="ci-body">
      <h2 class="ci-heading">{{ section.settings.heading }}</h2>
      <p class="ci-desc">{{ section.settings.desc | newline_to_br }}</p>
      {% if section.settings.link != blank %}<a class="ci-link" href="{{ section.settings.link }}">{{ section.settings.link_text }} &rarr;</a>{% endif %}
    </div>
  </div>
</section>
<style>
  .ci-wrap{padding:0;}
  .ci-grid{display:grid;grid-template-columns:1.2fr 1fr;align-items:stretch;min-height:420px;}
  .ci-image{position:relative;overflow:hidden;background:#292724;}
  .ci-image img{width:100%;height:100%;object-fit:cover;display:block;}
  .ci-body{display:flex;flex-direction:column;justify-content:center;padding:64px 60px;color:#292724;}
  .ci-heading{font-family:'Bebas Neue',sans-serif;font-size:24px;letter-spacing:2px;margin:0 0 20px;}
  .ci-desc{font-size:15px;line-height:1.7;color:#716B63;margin:0 0 24px;max-width:400px;}
  .ci-link{display:inline-block;color:#292724;text-decoration:none;font-size:13px;letter-spacing:2px;text-transform:uppercase;border-bottom:1px solid currentColor;padding-bottom:4px;font-weight:600;}
  .ci-link:hover{opacity:.7;}
  @media(max-width:900px){.ci-grid{grid-template-columns:1fr;min-height:auto;}.ci-image{aspect-ratio:4/3;}.ci-body{padding:40px 24px;}.ci-heading{font-size:19px;}}
</style>
{% schema %}
{"name":"Crafted With Intention","tag":"section","settings":[
{"type":"color","id":"bg_color","label":"Background","default":"#E9E2D5"},
{"type":"image_picker","id":"image","label":"Image"},
{"type":"text","id":"heading","label":"Heading","default":"CRAFTED WITH INTENTION"},
{"type":"textarea","id":"desc","label":"Description","default":"Every stitch, every detail – made to last for years to come."},
{"type":"text","id":"link_text","label":"Link text","default":"Our Craftsmanship"},
{"type":"url","id":"link","label":"Link URL"}],
"presets":[{"name":"Crafted With Intention"}]}
{% endschema %}