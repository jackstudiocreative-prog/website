<section class="bsh-wrap" {{ section.shopify_attributes }}>
  <div class="bsh-text">
    <h1 class="bsh-heading">{{ section.settings.heading }}</h1>
    <span class="bsh-divider"></span>
    <p class="bsh-tagline">{{ section.settings.text }}</p>
    {% if section.settings.body != blank %}<p class="bsh-body">{{ section.settings.body }}</p>{% endif %}
  </div>
  <div class="bsh-image">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1600 | image_tag: loading: 'eager' }}
    {% endif %}
  </div>
</section>

<style>
  .bsh-wrap{display:flex;align-items:stretch;min-height:520px;background:#F8F4EA;overflow:hidden;flex-wrap:wrap;}
  .bsh-text{flex:0 0 42%;display:flex;flex-direction:column;justify-content:center;padding:48px 5vw;}
  .bsh-heading{font-family:'Bebas Neue',sans-serif;font-size:clamp(44px,6vw,84px);line-height:0.9;color:#3B4530;margin:0 0 22px;letter-spacing:1px;}
  .bsh-divider{display:block;width:56px;height:3px;background:#C4823A;margin-bottom:22px;}
  .bsh-tagline{font-size:17px;line-height:1.55;color:#5A4E3F;margin:0 0 14px;max-width:360px;}
  .bsh-body{font-size:14px;line-height:1.65;color:#7A7263;margin:0;max-width:360px;}

  .bsh-image{flex:1 1 400px;overflow:hidden;min-height:420px;}
  .bsh-image img{width:100%;height:100%;object-fit:cover;display:block;}

  @media(max-width:900px){
    .bsh-wrap{flex-direction:column;min-height:0;}
    .bsh-text{flex:0 0 auto;padding:44px 24px 32px;}
    .bsh-heading{font-size:clamp(36px,10vw,54px);}
    .bsh-image{flex:0 0 auto;min-height:320px;}
  }
</style>

{% schema %}
{"name":"BRAND STORY — Hero","settings":[{"type":"image_picker","id":"image","label":"Hero image"},{"type":"text","id":"eyebrow","label":"Eyebrow (unused in current layout)","default":"BRAND STORY"},{"type":"text","id":"heading","label":"Heading","default":"Brand Story"},{"type":"textarea","id":"text","label":"Tagline (short)","default":"From everyday essentials to every journey."},{"type":"textarea","id":"body","label":"Body text (optional, longer paragraph below tagline)","default":"Built around how you live, work and travel — with trusted quality, thoughtful design and care beyond every purchase."}]}
{% endschema %}