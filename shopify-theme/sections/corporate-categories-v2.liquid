{% assign sid = section.id | replace: '_', '' | downcase %}
<section class="cc3-{{ sid }}-wrap" {{ section.shopify_attributes }}>
  <div class="cc3-{{ sid }}-head">
    <span class="cc3-{{ sid }}-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="cc3-{{ sid }}-title">{{ section.settings.heading }}</h2>
    <p class="cc3-{{ sid }}-tagline">{{ section.settings.tagline }}</p>
  </div>

  <div class="cc3-{{ sid }}-icons">
    {% for block in section.blocks %}
      <button type="button" class="cc3-{{ sid }}-icon-card" data-cc3-toggle="cc3-{{ sid }}-panel-{{ block.id }}" {{ block.shopify_attributes }}>
        <span class="cc3-{{ sid }}-icon-circle">
          {% if block.settings.icon == 'gift' %}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="8" width="18" height="13" rx="1"/><path d="M3 12h18M12 8v13M7.5 8a2.5 2.5 0 0 1 0-5C10 3 12 8 12 8s2-5 4.5-5a2.5 2.5 0 0 1 0 5"/></svg>
          {% elsif block.settings.icon == 'award' %}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="8" r="6"/><path d="M9 13.5 7 22l5-3 5 3-2-8.5"/></svg>
          {% elsif block.settings.icon == 'flag' %}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M5 21V4m0 0h13l-2.5 4L18 12H5"/></svg>
          {% else %}<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M20 7h-3.5a2.5 2.5 0 1 0-2.5 2.5H20zM4 7h3.5A2.5 2.5 0 1 1 10 9.5H4zM4 7v13h16V7M4 12h16"/></svg>
          {% endif %}
        </span>
        <span class="cc3-{{ sid }}-icon-name">{{ block.settings.name }}</span>
        <span class="cc3-{{ sid }}-icon-preview">{{ block.settings.preview }}</span>
      </button>
    {% endfor %}
  </div>

  {% for block in section.blocks %}
    <div id="cc3-{{ sid }}-panel-{{ block.id }}" class="cc3-{{ sid }}-panel">
      <div class="cc3-{{ sid }}-panel-inner">
        <div class="cc3-{{ sid }}-panel-head">
          <div>
            <h3 class="cc3-{{ sid }}-panel-title">{{ block.settings.name }}</h3>
            <p class="cc3-{{ sid }}-panel-sub">{{ block.settings.preview }}</p>
          </div>
          <button type="button" class="cc3-{{ sid }}-close" data-cc3-close aria-label="Close">&times;</button>
        </div>

        {% if block.settings.collection != blank %}
          <div class="cc3-{{ sid }}-products">
            {% for product in block.settings.collection.products limit: block.settings.count %}
              <a class="cc3-{{ sid }}-product" href="{{ product.url }}">
                <div class="cc3-{{ sid }}-pimg">
                  {% if product.featured_image %}{{ product.featured_image | image_url: width: 500, height: 625, crop: 'center' | image_tag: loading: 'lazy', alt: product.title }}{% endif %}
                </div>
                <div class="cc3-{{ sid }}-pname">{{ product.title }}</div>
                <div class="cc3-{{ sid }}-pprice">From {{ product.price | money }}</div>
                <span class="cc3-{{ sid }}-pbtn">Add to Cart</span>
              </a>
            {% else %}
              <p class="cc3-{{ sid }}-empty">No products yet.</p>
            {% endfor %}
          </div>
          {% if block.settings.collection.url %}<a class="cc3-{{ sid }}-viewall" href="{{ block.settings.collection.url }}">View All {{ block.settings.name }} &rarr;</a>{% endif %}
        {% else %}
          <p class="cc3-{{ sid }}-empty">Select a collection for "{{ block.settings.name }}" in the theme editor.</p>
        {% endif %}
      </div>
    </div>
  {% endfor %}
</section>

<style>
  .cc3-{{ sid }}-wrap{padding:70px 24px 0;background:#F8F4EA;color:#2B2420;}
  .cc3-{{ sid }}-head{text-align:center;max-width:640px;margin:0 auto 44px;}
  .cc3-{{ sid }}-eyebrow{font-size:10px;letter-spacing:2px;text-transform:uppercase;color:#C4823A;font-weight:600;display:block;margin-bottom:12px;}
  .cc3-{{ sid }}-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(24px,3vw,32px);letter-spacing:1px;margin:0 0 10px;}
  .cc3-{{ sid }}-tagline{font-size:13px;color:#7A7263;margin:0;line-height:1.6;}

  .cc3-{{ sid }}-icons{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;max-width:1200px;margin:0 auto;padding-bottom:40px;}
  .cc3-{{ sid }}-icon-card{background:#FFFFFF;border:1px solid #E3DCC8;border-radius:8px;padding:28px 18px;text-align:center;cursor:pointer;transition:box-shadow .2s,border-color .2s;font:inherit;}
  .cc3-{{ sid }}-icon-card:hover{box-shadow:0 6px 20px rgba(64,20,16,.08);border-color:#8DA68A;}
  .cc3-{{ sid }}-icon-card.is-active{border-color:#8DA68A;box-shadow:0 6px 20px rgba(64,20,16,.12);}
  .cc3-{{ sid }}-icon-circle{display:flex;align-items:center;justify-content:center;width:52px;height:52px;border-radius:50%;background:#F9F4E3;color:#2B2420;margin:0 auto 16px;}
  .cc3-{{ sid }}-icon-name{display:block;font-family:'Bebas Neue',sans-serif;font-size:15px;letter-spacing:1px;margin-bottom:8px;}
  .cc3-{{ sid }}-icon-preview{display:block;font-size:10.5px;color:#7A7263;line-height:1.5;}

  .cc3-{{ sid }}-panel{max-height:0;overflow:hidden;background:#6B5D45;transition:max-height .5s cubic-bezier(.4,0,.2,1);}
  .cc3-{{ sid }}-panel-inner{max-width:1200px;margin:0 auto;padding:36px 24px 48px;color:#FFFFFF;}
  .cc3-{{ sid }}-panel-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:28px;}
  .cc3-{{ sid }}-panel-title{font-family:'Bebas Neue',sans-serif;font-size:22px;letter-spacing:1px;margin:0 0 6px;color:#FFFFFF;}
  .cc3-{{ sid }}-panel-sub{font-size:12px;color:#F0E9DC;margin:0;max-width:480px;line-height:1.5;}
  .cc3-{{ sid }}-close{background:none;border:0;color:#FFFFFF;font-size:26px;line-height:1;cursor:pointer;padding:0 4px;}

  .cc3-{{ sid }}-products{display:grid;grid-template-columns:repeat(5,1fr);gap:18px;}
  .cc3-{{ sid }}-product{text-decoration:none;color:inherit;display:block;}
  .cc3-{{ sid }}-pimg{aspect-ratio:4/5;background:#8A7A5C;border-radius:4px;overflow:hidden;margin-bottom:12px;}
  .cc3-{{ sid }}-pimg img{width:100%;height:100%;object-fit:cover;display:block;}
  .cc3-{{ sid }}-pname{font-size:12.5px;font-weight:600;margin-bottom:4px;line-height:1.3;}
  .cc3-{{ sid }}-pprice{font-size:11px;color:#F0E9DC;margin-bottom:10px;}
  .cc3-{{ sid }}-pbtn{display:block;text-align:center;border:1px solid #C38239;color:#C38239;font-size:10px;letter-spacing:1px;text-transform:uppercase;padding:8px;border-radius:3px;font-weight:600;}
  .cc3-{{ sid }}-product:hover .cc3-{{ sid }}-pbtn{background:#C38239;color:#FFFFFF;}
  .cc3-{{ sid }}-empty{color:#F0E9DC;font-size:12px;}
  .cc3-{{ sid }}-viewall{display:inline-block;margin-top:28px;color:#FFFFFF;font-size:11px;font-weight:600;letter-spacing:1px;text-transform:uppercase;text-decoration:underline;}

  @media(max-width:900px){
    .cc3-{{ sid }}-icons{grid-template-columns:repeat(2,1fr);}
    .cc3-{{ sid }}-products{grid-template-columns:repeat(2,1fr);}
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function(){
    document.querySelectorAll('[class*="cc3-"][class*="-wrap"]').forEach(function(root){
      var closeAll = function(){
        root.querySelectorAll('[class*="-panel"]').forEach(function(p){ p.style.maxHeight = null; });
        root.querySelectorAll('[class*="-icon-card"]').forEach(function(c){ c.classList.remove('is-active'); });
      };
      root.querySelectorAll('[data-cc3-toggle]').forEach(function(btn){
        btn.addEventListener('click', function(){
          var id = btn.getAttribute('data-cc3-toggle');
          var panel = document.getElementById(id);
          var wasOpen = btn.classList.contains('is-active');
          closeAll();
          if(!wasOpen && panel){
            btn.classList.add('is-active');
            panel.style.maxHeight = panel.scrollHeight + 'px';
            panel.scrollIntoView({behavior:'smooth', block:'nearest'});
          }
        });
      });
      root.querySelectorAll('[data-cc3-close]').forEach(function(btn){
        btn.addEventListener('click', closeAll);
      });
    });
  });
</script>

{% schema %}
{
  "name": "CORPORATE — Categories v2",
  "tag": "section",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Product Portfolio"},
    {"type":"text","id":"heading","label":"Heading","default":"Corporate Product Categories"},
    {"type":"textarea","id":"tagline","label":"Tagline","default":"Premium leather goods, curated into four corporate gifting categories."}
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {"type":"text","id":"name","label":"Category name","default":"Executive Gifts"},
        {"type":"select","id":"icon","label":"Icon","options":[{"value":"gift","label":"Gift"},{"value":"award","label":"Award"},{"value":"flag","label":"Flag"},{"value":"bag","label":"Bag"}],"default":"gift"},
        {"type":"textarea","id":"preview","label":"Preview text","default":"Premium Wallet · Card Holder · Passport Holder · Business Backpack"},
        {"type":"collection","id":"collection","label":"Products collection"},
        {"type":"range","id":"count","label":"Products to show","min":2,"max":10,"step":1,"default":5}
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "CORPORATE — Categories v2",
      "blocks": [
        {"type":"category","settings":{"name":"Executive Gifts","icon":"gift","preview":"Premium Wallet · Card Holder · Passport Holder · Business Backpack"}},
        {"type":"category","settings":{"name":"Employee Rewards","icon":"award","preview":"Long Service Award · Joining Kit · Annual Dinner Gift · Retirement Gift"}},
        {"type":"category","settings":{"name":"Event Merchandise","icon":"flag","preview":"Conference Bag · Delegate Bag · VIP Gift · Speaker Gift · Training Kit"}},
        {"type":"category","settings":{"name":"Promotional Items","icon":"bag","preview":"Travel Backpack · Laptop Bag · Toiletry Kit · Corporate Gift Box"}}
      ]
    }
  ]
}
{% endschema %}