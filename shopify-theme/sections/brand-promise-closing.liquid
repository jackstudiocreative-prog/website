<section class="bpc-wrap" {{ section.shopify_attributes }}>
  <div class="bpc-left">
    {% if section.settings.image %}{{ section.settings.image | image_url: width: 900 | image_tag: loading: 'lazy' }}{% endif %}
  </div>
  <div class="bpc-right">
    <span class="bpc-eyebrow"><span class="bpc-eyebrow-muted">{{ section.settings.eyebrow_muted }}</span> <span class="bpc-eyebrow-accent">{{ section.settings.eyebrow_accent }}</span></span>
    <h2 class="bpc-heading">{{ section.settings.heading }}</h2>

    <div class="bpc-icons">
      <span class="bpc-icon-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 3l8 3v6c0 5.5-3.5 9.5-8 11-4.5-1.5-8-5.5-8-11V6z"/></svg> {{ section.settings.icon1_label }}</span>
      <span class="bpc-icon-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/><path d="M15 9l-2 6-6 2 2-6z"/></svg> {{ section.settings.icon2_label }}</span>
      <span class="bpc-icon-item"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 20.5s-7-4.4-7-9.8A4.2 4.2 0 0 1 12 8a4.2 4.2 0 0 1 7 2.7c0 5.4-7 9.8-7 9.8z"/></svg> {{ section.settings.icon3_label }}</span>
    </div>

    <div class="bpc-divider-row">
      <span class="bpc-divider"></span>
      <p class="bpc-text">{{ section.settings.text }}</p>
    </div>

    {% if section.settings.button_text != blank %}
      <a class="bpc-btn" href="{{ section.settings.button_link }}">{{ section.settings.button_text }} &rarr;</a>
    {% endif %}
  </div>
</section>

<style>
  .bpc-wrap{display:grid;grid-template-columns:.9fr 1.1fr;min-height:380px;background:#EFE7D8;}
  .bpc-left{overflow:hidden;}
  .bpc-left img{width:100%;height:100%;object-fit:cover;display:block;min-height:380px;}
  .bpc-right{display:flex;flex-direction:column;justify-content:center;padding:48px 6vw;}
  .bpc-eyebrow{display:block;font-size:11px;letter-spacing:2px;text-transform:uppercase;font-weight:700;margin-bottom:14px;}
  .bpc-eyebrow-muted{color:#A79E8A;}
  .bpc-eyebrow-accent{color:#C38239;}
  .bpc-heading{font-family:'Bebas Neue',sans-serif;font-size:clamp(20px,2.4vw,27px);line-height:1.15;color:#2B2420;margin:0 0 26px;max-width:480px;}
  .bpc-icons{display:flex;gap:26px;flex-wrap:wrap;margin-bottom:24px;}
  .bpc-icon-item{display:inline-flex;align-items:center;gap:8px;font-size:11px;letter-spacing:1px;text-transform:uppercase;color:#2B2420;font-weight:600;}
  .bpc-icon-item svg{width:18px;height:18px;flex-shrink:0;}
  .bpc-divider-row{display:flex;gap:20px;align-items:flex-start;}
  .bpc-divider{width:1px;align-self:stretch;background:#C9BFA6;flex-shrink:0;}
  .bpc-text{font-size:14px;line-height:1.7;color:#5A4E3F;margin:0;max-width:320px;}
  .bpc-btn{display:inline-block;margin-top:28px;background:#C38239;color:#F4EFDC;padding:14px 28px;border-radius:3px;font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;text-decoration:none;width:fit-content;}
  .bpc-btn:hover{background:#A8702F;}

  @media(max-width:900px){
    .bpc-wrap{grid-template-columns:1fr;min-height:0;}
    .bpc-left img{min-height:240px;}
    .bpc-right{padding:36px 24px;}
    .bpc-heading{font-size:19px;}
  }
</style>

{% schema %}
{
  "name": "Brand Promise — Closing",
  "settings": [
    {"type":"image_picker","id":"image","label":"Left image"},
    {"type":"text","id":"eyebrow_muted","label":"Eyebrow (muted part)","default":"Our"},
    {"type":"text","id":"eyebrow_accent","label":"Eyebrow (accent part)","default":"Promise, Your Experience"},
    {"type":"text","id":"heading","label":"Heading","default":"A promise we keep. An experience you can feel."},
    {"type":"text","id":"icon1_label","label":"Icon 1 label","default":"Trust"},
    {"type":"text","id":"icon2_label","label":"Icon 2 label","default":"Relevance"},
    {"type":"text","id":"icon3_label","label":"Icon 3 label","default":"Personal"},
    {"type":"textarea","id":"text","label":"Closing text","default":"Thank you for being part of our journey. We promise to keep creating experiences that matter to you."},
    {"type":"text","id":"button_text","label":"Button text","default":"Explore Jack Studio"},
    {"type":"url","id":"button_link","label":"Button link"}
  ]
}
{% endschema %}