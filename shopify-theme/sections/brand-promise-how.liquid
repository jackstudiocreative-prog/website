<section class="bph2-wrap" {{ section.shopify_attributes }}>
  <h2 class="bph2-heading">{{ section.settings.heading }}</h2>
  <div class="bph2-row">
    {% for block in section.blocks %}
      <div class="bph2-item" {{ block.shopify_attributes }}>
        <span class="bph2-icon">
          {%- case block.settings.icon -%}
          {%- when 'leaf' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 4C10 4 4 10 4 18c8 0 14-6 14-14z"/><path d="M8 18C8 12 12 8 18 6"/></svg>
          {%- when 'pencil' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 20l1-4L16 5l3 3L8 19l-4 1z"/><path d="M14 7l3 3"/></svg>
          {%- when 'headset' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 13a8 8 0 0 1 16 0"/><path d="M4 13v4a2 2 0 0 0 2 2h1v-6H5a1 1 0 0 0-1 1zM20 13v4a2 2 0 0 1-2 2h-1v-6h2a1 1 0 0 1 1 1z"/><path d="M14 19a2 2 0 0 1-2 2h-1"/></svg>
          {%- when 'person' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-4 3-6.5 7-6.5s7 2.5 7 6.5"/></svg>
          {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="9"/></svg>
          {%- endcase -%}
        </span>
        <div class="bph2-body">
          <strong class="bph2-title">{{ block.settings.title }}</strong>
          <span class="bph2-desc">{{ block.settings.description }}</span>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<style>
  .bph2-wrap{background:#F8F4EA;padding:56px 6vw;}
  .bph2-heading{text-align:center;font-family:'Bebas Neue',sans-serif;font-size:clamp(18px,2vw,22px);letter-spacing:2px;color:#2B2420;margin:0 0 44px;}
  .bph2-row{display:grid;grid-template-columns:repeat(4,1fr);gap:32px;max-width:1200px;margin:0 auto;}
  .bph2-item{display:flex;align-items:flex-start;gap:16px;}
  .bph2-icon{width:38px;height:38px;color:#7A7263;flex-shrink:0;}
  .bph2-icon svg{width:100%;height:100%;}
  .bph2-body{display:flex;flex-direction:column;gap:6px;}
  .bph2-title{font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:1px;text-transform:uppercase;color:#2B2420;}
  .bph2-desc{font-size:14px;color:#7A7263;line-height:1.5;}

  @media(max-width:900px){
    .bph2-row{grid-template-columns:repeat(2,1fr);gap:28px 20px;}
    .bph2-heading{font-size:17px;}
    .bph2-icon{width:32px;height:32px;}
    .bph2-title{font-size:18px;}
    .bph2-desc{font-size:13px;}
  }
</style>

{% schema %}
{
  "name": "Brand Promise — How",
  "settings": [
    {"type":"text","id":"heading","label":"Heading","default":"How We Keep Our Promise"}
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {"type":"select","id":"icon","label":"Icon","default":"leaf","options":[{"value":"leaf","label":"Leaf (Quality)"},{"value":"pencil","label":"Pencil (Design)"},{"value":"headset","label":"Headset (Service)"},{"value":"person","label":"Person (Personalisation)"}]},
        {"type":"text","id":"title","label":"Title","default":"Quality"},
        {"type":"text","id":"description","label":"Description","default":"Thoughtful materials & lasting construction."}
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Brand Promise — How",
      "blocks": [
        {"type":"item","settings":{"icon":"leaf","title":"Quality","description":"Thoughtful materials & lasting construction."}},
        {"type":"item","settings":{"icon":"pencil","title":"Design","description":"Made for real everyday needs."}},
        {"type":"item","settings":{"icon":"headset","title":"Service","description":"Support beyond the purchase."}},
        {"type":"item","settings":{"icon":"person","title":"Personalisation","description":"Products that can become uniquely yours."}}
      ]
    }
  ]
}
{% endschema %}