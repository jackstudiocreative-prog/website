<section class="csp" style="--csp-bg:{{ section.settings.bg_color }};" {{ section.shopify_attributes }}>
  <div class="csp-inner">
    {%- if section.settings.eyebrow != blank -%}<p class="csp-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="csp-heading">{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="csp-sub">{{ section.settings.text }}</p>{%- endif -%}
    <div class="csp-grid">
      {%- for block in section.blocks -%}
        <div class="csp-card" {{ block.shopify_attributes }}>
          <span class="csp-icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'image' -%}<svg viewBox="0 0 24 24"><rect x="3.5" y="4.5" width="17" height="15" rx="1.5"/><circle cx="9" cy="9.5" r="1.6"/><path d="M4 17l5-5 4 4 2.5-2.5L20 18"/></svg>
              {%- when 'gift' -%}<svg viewBox="0 0 24 24"><rect x="3.5" y="8" width="17" height="4" rx=".6"/><path d="M5 12v8.5h14V12M12 8v12.5M12 8S10.6 3.5 8 4.1c-2 .5-1.3 3.9 4 3.9zm0 0s1.4-4.5 4-3.9c2 .5 1.3 3.9-4 3.9z"/></svg>
              {%- when 'card' -%}<svg viewBox="0 0 24 24"><rect x="3" y="5.5" width="18" height="13" rx="1.5"/><path d="M3 9.5h18M14.5 13h3.5v2.5h-3.5z"/></svg>
              {%- when 'truck' -%}<svg viewBox="0 0 24 24"><path d="M2.5 6.5h11v9h-11zM13.5 9.5h4l3 3v3h-7"/><circle cx="7" cy="17" r="1.8"/><circle cx="17" cy="17" r="1.8"/></svg>
              {%- when 'envelope' -%}<svg viewBox="0 0 24 24"><rect x="3" y="5.5" width="18" height="13" rx="1"/><path d="M3.5 6l8.5 7 8.5-7M3.5 18l6.5-6M20.5 18l-6.5-6"/></svg>
              {%- when 'bag' -%}<svg viewBox="0 0 24 24"><path d="M5 8h14l-1 12.5H6z"/><path d="M9 8V6.5a3 3 0 0 1 6 0V8"/></svg>
              {%- when 'gear' -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3"/><path d="M12 2.8v2.4M12 18.8v2.4M21.2 12h-2.4M5.2 12H2.8M18.5 5.5l-1.7 1.7M7.2 16.8l-1.7 1.7M18.5 18.5l-1.7-1.7M7.2 7.2L5.5 5.5"/><circle cx="12" cy="12" r="6.3"/></svg>
              {%- when 'clock' -%}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"/><path d="M12 7.5V12l3 2"/></svg>
              {%- else -%}<svg viewBox="0 0 24 24"><path d="M15.5 4.5l4 4L9 19H5v-4z"/><path d="M13 7l4 4"/></svg>
            {%- endcase -%}
          </span>
          <span class="csp-txt">
            <span class="csp-title">{{ block.settings.title }}</span>
            {%- if block.settings.desc != blank -%}<span class="csp-desc">{{ block.settings.desc }}</span>{%- endif -%}
          </span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  .csp{background:var(--csp-bg);}
  .csp-inner{max-width:1440px;margin:0 auto;padding:clamp(48px,6vw,88px) clamp(20px,5vw,72px);}
  .csp-eyebrow{margin:0 0 14px;font-family:'Inter',sans-serif;font-size:11px;font-weight:600;letter-spacing:.24em;text-transform:uppercase;color:#B87635;}
  .csp-heading{margin:0 0 8px;font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:clamp(40px,4.6vw,64px);line-height:.95;color:#401410;}
  .csp-sub{margin:0 0 clamp(24px,2.5vw,32px);font-family:'Inter',sans-serif;font-size:16px;line-height:1.6;color:#5A4E3F;}
  .csp-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:clamp(10px,1vw,14px);}
  .csp-card{display:flex;align-items:flex-start;gap:16px;padding:22px 20px;background:rgba(251,248,240,.85);box-shadow:0 2px 10px rgba(64,20,16,.04);}
  .csp-icon{flex-shrink:0;display:flex;align-items:center;justify-content:center;width:48px;height:48px;border-radius:50%;background:#F3E3CC;color:#B87635;}
  .csp-icon svg{width:24px;height:24px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;}
  .csp-txt{display:flex;flex-direction:column;}
  .csp-title{margin:4px 0 6px;font-family:'Bebas Neue',sans-serif;font-size:21px;line-height:1;color:#401410;}
  .csp-desc{font-family:'Inter',sans-serif;font-size:12px;line-height:1.55;color:#6B5D4F;}

  @media(max-width:1100px){ .csp-grid{grid-template-columns:repeat(2,1fr);} }
  @media(max-width:600px){
    .csp-grid{grid-template-columns:1fr;}
    .csp-sub{font-size:15px;}
  }
</style>

{% schema %}
{
  "name": "Corporate — Support",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background","default":"#EFEDE2"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"02 / Corporate support"},
    {"type":"text","id":"heading","label":"Heading","default":"Complete corporate support."},
    {"type":"text","id":"text","label":"Subheading","default":"Every detail handled in-house — from artwork to delivery."}
  ],
  "blocks": [
    {
      "type":"item",
      "name":"Item",
      "settings":[
        {"type":"select","id":"icon","label":"Icon","default":"pencil","options":[
          {"value":"pencil","label":"Pencil"},
          {"value":"image","label":"Image"},
          {"value":"gift","label":"Gift"},
          {"value":"card","label":"Name card"},
          {"value":"truck","label":"Delivery truck"},
          {"value":"envelope","label":"Envelope"},
          {"value":"bag","label":"Bag"},
          {"value":"gear","label":"Gear"},
          {"value":"clock","label":"Clock"}
        ]},
        {"type":"text","id":"title","label":"Title","default":"Free Logo Design"},
        {"type":"textarea","id":"desc","label":"Description","default":"Our team creates logo artwork for your approval."}
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{"name":"Corporate — Support"}]
}
{% endschema %}
