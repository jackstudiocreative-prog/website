{% assign sid = section.id | replace: '_', '' | downcase %}
<div id="es-{{ sid }}-root" class="es-{{ sid }}-wrap es-wrap" data-es-root>
  {% if section.settings.heading != blank %}<h2 class="es-{{ sid }}-heading">{{ section.settings.heading }}</h2>{% endif %}

  <div class="es-{{ sid }}-carousel es-carousel">
    <button type="button" class="es-{{ sid }}-arrow es-{{ sid }}-arrow-prev" data-es-prev aria-label="Previous">&larr;</button>
    <button type="button" class="es-{{ sid }}-arrow es-{{ sid }}-arrow-next" data-es-next aria-label="Next">&rarr;</button>

    <div class="es-{{ sid }}-rail es-rail" data-es-rail>
      {% for block in section.blocks %}
        <button type="button" class="es-{{ sid }}-card es-card" data-es-target="es-{{ sid }}-panel-{{ block.id }}" data-es-card data-es-slug="{{ block.settings.name | handleize }}" style="--accent:{{ block.settings.accent }};" {{ block.shopify_attributes }}>
          <span class="es-{{ sid }}-img-wrap">
            {% if block.settings.image %}
              <img class="es-{{ sid }}-img" src="{{ block.settings.image | image_url: width: 700 }}" alt="{{ block.settings.name }}" loading="lazy">
            {% else %}
              <span class="es-{{ sid }}-img es-{{ sid }}-placeholder"></span>
            {% endif %}
          </span>
          <span class="es-{{ sid }}-btn">{{ block.settings.name }}</span>
        </button>
      {% endfor %}
    </div>

    {% if section.blocks.size > 1 %}
      <div class="es-{{ sid }}-dots es-dots" data-es-dots>
        {% for block in section.blocks %}
          <button type="button" class="es-{{ sid }}-dot" data-es-dot="{{ forloop.index0 }}" aria-label="Go to {{ block.settings.name }}"></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>

  {% for block in section.blocks %}
    {% assign first_tab_set = false %}
    {%- assign series_source = block.settings.series_collection | default: section.settings.products_source | default: collections.all -%}
    <div id="es-{{ sid }}-panel-{{ block.id }}" class="es-{{ sid }}-panel es-panel" hidden>
      <div class="es-{{ sid }}-panel-inner">
        <h2 class="es-{{ sid }}-panel-title">{{ block.settings.name }}</h2>

        <div class="es-{{ sid }}-tabs" data-es-tabs>
          {% for i in (1..4) %}
            {% assign name_key = 'shelf_' | append: i | append: '_name' %}
            {% assign shelf_name = block.settings[name_key] %}
            {% if shelf_name != blank %}
              <button type="button" class="es-{{ sid }}-tab{% unless first_tab_set %} is-active{% endunless %}" data-es-tab="es-{{ sid }}-tabpanel-{{ block.id }}-{{ i }}">{{ shelf_name }}</button>
              {% assign first_tab_set = true %}
            {% endif %}
          {% endfor %}
        </div>

        {% assign first_panel_set = false %}
        {% for i in (1..4) %}
          {% assign name_key = 'shelf_' | append: i | append: '_name' %}
          {% assign tag_key = 'shelf_' | append: i | append: '_tag' %}
          {% assign count_key = 'shelf_' | append: i | append: '_count' %}
          {% assign shelf_name = block.settings[name_key] %}
          {% assign shelf_tag = block.settings[tag_key] | default: shelf_name %}
          {% assign shelf_count = block.settings[count_key] %}

          {% if shelf_name != blank %}
            {%- assign product_count = 0 -%}
            {% for product in series_source.products %}
              {% if product.tags contains shelf_tag %}{% assign product_count = product_count | plus: 1 %}{% endif %}
            {% endfor %}

            <div id="es-{{ sid }}-tabpanel-{{ block.id }}-{{ i }}" class="es-{{ sid }}-tabpanel{% if first_panel_set %} is-hidden{% endif %}">
              {% if product_count > 0 %}
                {%- assign matched = 0 -%}
                <div class="es-{{ sid }}-products">
                  {% for product in series_source.products %}
                    {% if product.tags contains shelf_tag %}
                      {% if matched < shelf_count %}
                        {% assign matched = matched | plus: 1 %}
                        {% assign color_values = nil %}
                        {% for option in product.options_with_values %}
                          {% assign opt_lc = option.name | downcase %}
                          {% if opt_lc contains 'color' or opt_lc contains 'colour' %}
                            {% assign color_values = option.values %}
                          {% endif %}
                        {% endfor %}
                        <a class="es-{{ sid }}-product" href="{{ product.url }}">
                          {% if product.featured_image %}
                            <div class="es-{{ sid }}-pimg-wrap">{{ product.featured_image | image_url: width: 500, height: 625, crop: 'center' | image_tag: loading: 'lazy', alt: product.title, width: 500, height: 625 }}</div>
                          {% else %}
                            <div class="es-{{ sid }}-product-placeholder"></div>
                          {% endif %}
                          <span class="es-{{ sid }}-pname">{{ product.title }}</span>
                          <span class="es-{{ sid }}-pprice">
                            {{ product.price | money }}
                            {% if product.compare_at_price > product.price %}<s>{{ product.compare_at_price | money }}</s>{% endif %}
                          </span>
                          {% if color_values %}
                            <span class="es-{{ sid }}-swatches">
                              {% for v in color_values limit: 5 %}<span class="es-{{ sid }}-dot" style="background-color:{{ v | strip | downcase }};" title="{{ v }}"></span>{% endfor %}
                            </span>
                          {% endif %}
                        </a>
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                </div>
              {% else %}
                {% assign soon_img = block.settings.coming_soon_image | default: block.settings.image %}
                {% assign notify_msg = 'Hi Jack Studio, I would like to be notified when the ' | append: block.settings.name | append: ' — ' | append: shelf_name | append: ' collection is available.' %}
                {% assign notify_msg_enc = notify_msg | url_encode %}
                {% assign wa_link = 'https://wa.me/601112015288?text=' | append: notify_msg_enc %}
                {% assign notify_href = block.settings.notify_link | default: wa_link %}
                <div class="es-{{ sid }}-soon">
                  {% if soon_img %}
                    <div class="es-{{ sid }}-soon-img">{{ soon_img | image_url: width: 1400 | image_tag: loading: 'lazy', alt: block.settings.name }}</div>
                  {% endif %}
                  <h3 class="es-{{ sid }}-soon-title">{{ block.settings.coming_soon_heading | default: 'Coming Soon' }}</h3>
                  {% if block.settings.description != blank %}<p class="es-{{ sid }}-soon-tagline">{{ block.settings.description }}</p>{% endif %}
                  {% if block.settings.coming_soon_desc != blank %}<p class="es-{{ sid }}-soon-desc">{{ block.settings.coming_soon_desc }}</p>{% endif %}
                  {% if block.settings.notify_button_text != blank %}
                    <a class="es-{{ sid }}-soon-btn" href="{{ notify_href }}" target="_blank" rel="noopener">{{ block.settings.notify_button_text }} &rarr;</a>
                  {% endif %}
                </div>
              {% endif %}
            </div>
            {% assign first_panel_set = true %}
          {% endif %}
        {% endfor %}

        <button type="button" class="es-{{ sid }}-close" data-es-close>Close</button>
      </div>
    </div>
  {% endfor %}
</div>

<style>
  .es-{{ sid }}-wrap{padding:40px 0;background:#F8F4EA;color:#2B2420;overflow:hidden;}
  .es-{{ sid }}-heading{font-family:'Bebas Neue',sans-serif;font-size:21px;margin:0 24px 28px;text-transform:uppercase;letter-spacing:2px;text-align:center;color:#2B2420;}

  .es-{{ sid }}-carousel{position:relative;max-width:1400px;margin:0 auto;padding:0 24px;}
  .es-{{ sid }}-rail{display:flex;gap:26px;overflow-x:scroll;overflow-y:hidden;scroll-snap-type:x proximity;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;touch-action:pan-x;scrollbar-width:none;padding-bottom:6px;-webkit-transform:translateZ(0);transform:translateZ(0);will-change:scroll-position;}
  .es-{{ sid }}-rail::-webkit-scrollbar{display:none;}

  .es-{{ sid }}-card{flex:0 0 clamp(220px,23vw,300px);position:relative;aspect-ratio:3/4;overflow:visible;border:0;padding:0;cursor:pointer;background:none;text-align:left;scroll-snap-align:start;margin-bottom:26px;touch-action:pan-x;-webkit-user-drag:none;user-select:none;}
  .es-{{ sid }}-img-wrap{position:absolute;inset:0;border-radius:14px;overflow:hidden;background:#EFE9D8;pointer-events:none;}
  .es-{{ sid }}-img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;transition:transform .5s ease;display:block;pointer-events:none;-webkit-user-drag:none;}
  .es-{{ sid }}-card:hover .es-{{ sid }}-img{transform:scale(1.045);}
  .es-{{ sid }}-placeholder{background:linear-gradient(135deg,#8A7A5C,#6B5D45);}
  .es-{{ sid }}-btn{position:absolute;left:12px;right:12px;bottom:-20px;text-align:center;color:#F5F1E6;background:var(--accent,#2B2420);font-family:'Inter',sans-serif;font-weight:700;font-size:11px;letter-spacing:1.2px;text-transform:uppercase;padding:15px 10px;border-radius:6px;box-shadow:0 10px 22px rgba(64,20,16,.22);pointer-events:none;}
  .es-{{ sid }}-card.is-active .es-{{ sid }}-img-wrap{outline:2px solid var(--accent,#C4823A);outline-offset:2px;}
  @media(max-width:768px){.es-{{ sid }}-card{flex:0 0 68vw;}.es-{{ sid }}-btn{font-size:10px;padding:12px 8px;}}

  .es-{{ sid }}-arrow{position:absolute;top:calc(50% - 26px - 13px);width:40px;height:40px;border-radius:50%;border:1px solid #D8CDB0;background:#F8F4EA;color:#2B2420;font-size:16px;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:2;transition:background .2s;}
  .es-{{ sid }}-arrow:hover{background:#EADFC4;}
  .es-{{ sid }}-arrow-prev{left:0;}
  .es-{{ sid }}-arrow-next{right:0;}
  @media(max-width:900px){.es-{{ sid }}-arrow{display:none;}}

  .es-{{ sid }}-dots{display:flex;justify-content:center;align-items:center;gap:12px;margin-top:34px;}
  .es-{{ sid }}-dots .es-{{ sid }}-dot{position:relative;width:9px;height:9px;padding:0;border-radius:50%;border:1px solid rgba(64,20,16,.35);background:#C9BFA6;cursor:pointer;transition:background .2s,width .2s,border-color .2s;flex:0 0 auto;}
  .es-{{ sid }}-dots .es-{{ sid }}-dot::after{content:'';position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:34px;height:34px;}
  .es-{{ sid }}-dots .es-{{ sid }}-dot.is-active{background:#C38239;border-color:#C38239;width:24px;border-radius:5px;}
  @media(max-width:640px){.es-{{ sid }}-dots{margin-top:30px;gap:14px;}.es-{{ sid }}-dots .es-{{ sid }}-dot{width:10px;height:10px;}.es-{{ sid }}-dots .es-{{ sid }}-dot.is-active{width:26px;}}

  .es-{{ sid }}-panel{overflow:hidden;max-height:0;transition:max-height .35s ease;background:#F8F4EA;color:#2B2420;}
  .es-{{ sid }}-panel-inner{padding:40px 24px 24px;text-align:center;max-width:1200px;margin:0 auto;}
  .es-{{ sid }}-panel-title{margin:0 0 24px;text-transform:none;font-size:21px;font-weight:700;font-family:'Bebas Neue',sans-serif;letter-spacing:1px;}
  .es-{{ sid }}-tabs{display:flex;justify-content:center;gap:28px;margin-bottom:28px;flex-wrap:wrap;}
  .es-{{ sid }}-tab{background:none;border:0;padding:0 0 6px;font:inherit;font-size:13px;letter-spacing:.5px;text-transform:uppercase;color:#A69C86;cursor:pointer;border-bottom:2px solid transparent;}
  .es-{{ sid }}-tab.is-active{color:#2B2420;border-bottom-color:#2B2420;}
  .es-{{ sid }}-tabpanel.is-hidden{display:none;}
  .es-{{ sid }}-products{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;text-align:left;align-items:start;}
  .es-{{ sid }}-product{color:inherit;text-decoration:none;display:block;}
  .es-{{ sid }}-pimg-wrap{width:100%;aspect-ratio:4/5;overflow:hidden;border-radius:4px;background:#F4F4F6;display:block;}
  .es-{{ sid }}-pimg-wrap img{width:100%;height:100%;object-fit:cover;display:block;}
  .es-{{ sid }}-product-placeholder{width:100%;aspect-ratio:4/5;border-radius:4px;background:#EFEAD9;}
  .es-{{ sid }}-pname,.es-{{ sid }}-pprice{display:block;margin-top:10px;font-size:13px;}
  .es-{{ sid }}-pprice{color:#7A7263;}
  .es-{{ sid }}-swatches{display:flex;gap:4px;margin-top:6px;}
  .es-{{ sid }}-panel .es-{{ sid }}-dot{width:10px;height:10px;border-radius:50%;display:inline-block;border:1px solid rgba(0,0,0,.15);background:none;}

  .es-{{ sid }}-soon{max-width:820px;margin:0 auto;text-align:center;}
  .es-{{ sid }}-soon-img{width:100%;aspect-ratio:21/6;border-radius:6px;overflow:hidden;background:#EFE9D8;margin-bottom:36px;}
  .es-{{ sid }}-soon-img img{width:100%;height:100%;object-fit:cover;display:block;}
  .es-{{ sid }}-soon-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(32px,4.4vw,48px);letter-spacing:2px;margin:0 0 14px;color:#2B2420;}
  .es-{{ sid }}-soon-tagline{font-family:Georgia,serif;font-style:italic;font-size:16px;color:#2B2420;margin:0 0 14px;}
  .es-{{ sid }}-soon-desc{font-family:'Inter',sans-serif;font-size:13.5px;line-height:1.7;color:#8A8069;max-width:420px;margin:0 auto 26px;}
  .es-{{ sid }}-soon-btn{display:inline-flex;align-items:center;gap:8px;border:1.5px solid #C4823A;color:#2B2420;font-family:'Inter',sans-serif;font-size:12px;font-weight:700;letter-spacing:1px;text-transform:uppercase;padding:14px 26px;text-decoration:none;margin-bottom:28px;}
  .es-{{ sid }}-soon-btn:hover{background:#C4823A;color:#fff;}

  .es-{{ sid }}-close{margin-top:24px;background:none;border:0;text-decoration:underline;cursor:pointer;font:inherit;color:#2B2420;padding:0;}
  @media(max-width:749px){.es-{{ sid }}-products{grid-template-columns:repeat(2,1fr);}.es-{{ sid }}-tabs{gap:16px;}.es-{{ sid }}-heading{font-size:18px;}.es-{{ sid }}-panel-title{font-size:18px;}.es-{{ sid }}-soon-img{aspect-ratio:4/3;margin-bottom:26px;}.es-{{ sid }}-soon-title{font-size:30px;}}
</style>

<script>
  (function(){
    var root=document.getElementById('es-{{ sid }}-root');
    if(!root)return;
    var dragMoved=false;

    function closeAll(){
      root.querySelectorAll('.es-panel').forEach(function(p){p.style.maxHeight=null;p.hidden=true;});
      root.querySelectorAll('.es-card').forEach(function(c){c.classList.remove('is-active');});
    }
    function openCard(btn){
      var id=btn.getAttribute('data-es-target');
      var panel=document.getElementById(id);
      closeAll();
      if(panel){
        btn.classList.add('is-active');
        panel.hidden=false;
        requestAnimationFrame(function(){panel.style.maxHeight=panel.scrollHeight+'px';});
      }
      return panel;
    }
    root.querySelectorAll('[data-es-target]').forEach(function(btn){
      btn.addEventListener('click',function(){
        if(dragMoved){dragMoved=false;return;}
        var wasOpen=btn.classList.contains('is-active');
        closeAll();
        if(!wasOpen){
          var panel=openCard(btn);
          if(panel) panel.scrollIntoView({behavior:'smooth',block:'nearest'});
        }
      });
    });
    root.querySelectorAll('[data-es-close]').forEach(function(btn){btn.addEventListener('click',closeAll);});
    root.querySelectorAll('[data-es-tabs]').forEach(function(tabRow){
      var panelWrap=tabRow.closest('.es-panel');
      tabRow.querySelectorAll('[data-es-tab]').forEach(function(tabBtn){
        tabBtn.addEventListener('click',function(){
          tabRow.querySelectorAll('.is-active').forEach(function(t){t.classList.remove('is-active');});
          tabBtn.classList.add('is-active');
          var targetId=tabBtn.getAttribute('data-es-tab');
          panelWrap.querySelectorAll('[class*="-tabpanel"]').forEach(function(tp){tp.classList.toggle('is-hidden',tp.id!==targetId);});
          if(panelWrap.style.maxHeight){requestAnimationFrame(function(){panelWrap.style.maxHeight=panelWrap.scrollHeight+'px';});}
        });
      });
    });

    var rail=root.querySelector('[data-es-rail]');
    if(rail){
      var carousel=rail.closest('.es-carousel');
      var cards=Array.prototype.slice.call(rail.querySelectorAll('[data-es-card]'));
      var dots=Array.prototype.slice.call(carousel.querySelectorAll('[data-es-dot]'));
      var prevBtn=carousel.querySelector('[data-es-prev]');
      var nextBtn=carousel.querySelector('[data-es-next]');

      function setActive(i){dots.forEach(function(d,idx){d.classList.toggle('is-active',idx===i);});}
      function scrollToCard(i){var card=cards[i];if(!card)return;rail.scrollTo({left:card.offsetLeft-rail.offsetLeft,behavior:'smooth'});}
      dots.forEach(function(dot,idx){dot.addEventListener('click',function(){scrollToCard(idx);});});

      function step(dir){var w=cards[0]?cards[0].getBoundingClientRect().width+26:280;rail.scrollBy({left:dir*w,behavior:'smooth'});}
      if(prevBtn)prevBtn.addEventListener('click',function(){step(-1);});
      if(nextBtn)nextBtn.addEventListener('click',function(){step(1);});

      var ticking=false;
      function updateActiveFromScroll(){
        var maxScroll=rail.scrollWidth-rail.clientWidth;
        var idx;
        if(maxScroll<=0){
          idx=0;
        } else if(rail.scrollLeft>=maxScroll-1){
          idx=cards.length-1;
        } else {
          var fraction=rail.scrollLeft/maxScroll;
          idx=Math.round(fraction*(cards.length-1));
        }
        setActive(idx);
      }
      rail.addEventListener('scroll',function(){
        if(ticking)return;ticking=true;
        requestAnimationFrame(function(){
          updateActiveFromScroll();ticking=false;
        });
      });
      setActive(0);

      var isDown=false,startX=0,startScroll=0;
      function pointerX(e){return (e.touches&&e.touches[0])?e.touches[0].clientX:e.clientX;}
      function dragStart(e){isDown=true;dragMoved=false;startX=pointerX(e);startScroll=rail.scrollLeft;}
      function dragMove(e){if(!isDown)return;var x=pointerX(e);var delta=startX-x;if(Math.abs(delta)>4)dragMoved=true;rail.scrollLeft=startScroll+delta;}
      function dragEnd(){isDown=false;}
      rail.addEventListener('touchstart',dragStart,{passive:true});
      rail.addEventListener('touchmove',dragMove,{passive:true});
      rail.addEventListener('touchend',dragEnd);
      rail.addEventListener('mousedown',dragStart);
      window.addEventListener('mousemove',dragMove);
      window.addEventListener('mouseup',dragEnd);

      /* Auto-open a series when arriving via ?series=<slug> (e.g. from homepage cards) */
      try{
        var params=new URLSearchParams(window.location.search);
        var wantedSlug=params.get('series');
        if(wantedSlug){
          var targetBtn=root.querySelector('[data-es-slug="'+wantedSlug+'"]');
          if(targetBtn){
            scrollToCard(cards.indexOf(targetBtn));
            var openedPanel=openCard(targetBtn);
            setTimeout(function(){
              root.scrollIntoView({behavior:'smooth',block:'start'});
              if(openedPanel){
                setTimeout(function(){ openedPanel.scrollIntoView({behavior:'smooth',block:'nearest'}); },350);
              }
            },250);
          }
        }
      }catch(e){}
    }
  })();
</script>

{% schema %}
{
  "name": "Series explorer v2",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (optional)" },
    { "type": "paragraph", "content": "每个系列选自己的 collection（在下面每个 Series 区块里选），分类（Bag/Wallet/Accessories/Belt）用 tag 在该 collection 内筛选。产品只需打 1 个分类 tag，无需系列 tag。" },
    { "type": "collection", "id": "products_source", "label": "默认 collection（当某个 Series 没单独选 collection 时使用）" }
  ],
  "blocks": [
    {
      "type": "series",
      "name": "Series",
      "settings": [
        { "type": "text", "id": "name", "label": "Category name", "default": "New Series" },
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "textarea", "id": "description", "label": "Description (also used as coming-soon tagline)" },
        { "type": "color", "id": "accent", "label": "Accent color", "default": "#C4823A" },
        { "type": "collection", "id": "series_collection", "label": "Series collection（这个系列用哪个 collection）" },
        { "type": "header", "content": "Coming soon state (0 tagged products)" },
        { "type": "image_picker", "id": "coming_soon_image", "label": "Banner image (defaults to Image above)" },
        { "type": "text", "id": "coming_soon_heading", "label": "Heading", "default": "Coming Soon" },
        { "type": "textarea", "id": "coming_soon_desc", "label": "Description", "default": "A new collection is taking shape — rooted in craftsmanship, made for everyday carry." },
        { "type": "text", "id": "notify_button_text", "label": "Button text", "default": "Notify Me" },
        { "type": "url", "id": "notify_link", "label": "Button link (blank = opens WhatsApp)" },
        { "type": "header", "content": "Product category 1" },
        { "type": "text", "id": "shelf_1_name", "label": "Category 1 name", "default": "Bag" },
        { "type": "text", "id": "shelf_1_tag", "label": "Category 1 tag (defaults to name if blank)" },
        { "type": "range", "id": "shelf_1_count", "label": "Category 1 count", "min": 1, "max": 12, "step": 1, "default": 8 },
        { "type": "header", "content": "Product category 2" },
        { "type": "text", "id": "shelf_2_name", "label": "Category 2 name" },
        { "type": "text", "id": "shelf_2_tag", "label": "Category 2 tag (defaults to name if blank)" },
        { "type": "range", "id": "shelf_2_count", "label": "Category 2 count", "min": 1, "max": 12, "step": 1, "default": 8 },
        { "type": "header", "content": "Product category 3" },
        { "type": "text", "id": "shelf_3_name", "label": "Category 3 name" },
        { "type": "text", "id": "shelf_3_tag", "label": "Category 3 tag (defaults to name if blank)" },
        { "type": "range", "id": "shelf_3_count", "label": "Category 3 count", "min": 1, "max": 12, "step": 1, "default": 8 },
        { "type": "header", "content": "Product category 4" },
        { "type": "text", "id": "shelf_4_name", "label": "Category 4 name" },
        { "type": "text", "id": "shelf_4_tag", "label": "Category 4 tag (defaults to name if blank)" },
        { "type": "range", "id": "shelf_4_count", "label": "Category 4 count", "min": 1, "max": 12, "step": 1, "default": 8 }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Series explorer v2" }]
}
{% endschema %}
