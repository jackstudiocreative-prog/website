<section class="ch2-wrap" {{ section.shopify_attributes }}>
  <div class="ch2-left">
    <span class="ch2-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="ch2-title">{{ section.settings.heading }}</h1>
    <span class="ch2-divider"></span>
    <p class="ch2-body">{{ section.settings.body }}</p>
    <div class="ch2-actions">
      <a class="ch2-btn-dark" href="{{ section.settings.quote_link }}">{{ section.settings.quote_label }}</a>
      {% if section.settings.brochure_link != blank %}
        <a class="ch2-btn-link" href="{{ section.settings.brochure_link }}">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v12m0 0l-4-4m4 4l4-4M4 17v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"/></svg>
          {{ section.settings.brochure_label }}
        </a>
      {% endif %}
    </div>
  </div>
  <div class="ch2-right">
    {% if section.settings.hero_image %}
      {{ section.settings.hero_image | image_url: width: 1200 | image_tag: loading: 'eager' }}
    {% endif %}
  </div>
</section>

<style>
  .ch2-wrap{display:grid;grid-template-columns:1fr 1fr;min-height:520px;background:{{ section.settings.bg_color }};}
  .ch2-left{display:flex;flex-direction:column;justify-content:center;padding:60px 6vw;}
  .ch2-eyebrow{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#C4823A;font-weight:600;display:block;margin-bottom:16px;}
  .ch2-title{font-family:'Bebas Neue',sans-serif;font-size:clamp(32px,4vw,46px);line-height:0.95;color:#2B2420;margin:0;}
  .ch2-divider{display:block;width:44px;height:2px;background:#2B2420;margin:20px 0;}
  .ch2-body{font-size:14px;line-height:1.7;color:#7A7263;max-width:440px;margin:0 0 32px;}
  .ch2-actions{display:flex;align-items:center;gap:24px;flex-wrap:wrap;}
  .ch2-btn-dark{display:inline-block;background:#C38239;color:#F4EFDC;padding:14px 30px;border-radius:3px;font-size:12px;font-weight:600;letter-spacing:1.5px;text-transform:uppercase;text-decoration:none;}
  .ch2-btn-dark:hover{background:#A8702F;}
  .ch2-btn-link{display:inline-flex;align-items:center;gap:8px;color:#2B2420;font-size:12px;font-weight:600;letter-spacing:1px;text-transform:uppercase;text-decoration:underline;}
  .ch2-right{background:#F9F4E3;overflow:hidden;}
  .ch2-right img{width:100%;height:100%;object-fit:cover;display:block;min-height:420px;}

  @media(max-width:900px){
    .ch2-wrap{grid-template-columns:1fr;min-height:0;}
    .ch2-left{padding:48px 24px;}
    .ch2-title{font-size:26px;}
    .ch2-right img{min-height:280px;}
  }
</style>

{% schema %}
{"name":"CORPORATE — Hero v2","settings":[
{"type":"color","id":"bg_color","label":"Background","default":"#F4EFDC"},
{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Premium Gifts, Thoughtfully Crafted"},
{"type":"text","id":"heading","label":"Heading","default":"Corporate Solutions"},
{"type":"textarea","id":"body","label":"Body","default":"Premium leather goods for every corporate occasion. Strengthen relationships with gifts that leave a lasting impression."},
{"type":"text","id":"quote_label","label":"Quote button","default":"Get a Quote"},
{"type":"url","id":"quote_link","label":"Quote link"},
{"type":"text","id":"brochure_label","label":"Brochure link text","default":"Download Brochure"},
{"type":"url","id":"brochure_link","label":"Brochure link (PDF or page)"},
{"type":"image_picker","id":"hero_image","label":"Hero image"}
]}
{% endschema %}