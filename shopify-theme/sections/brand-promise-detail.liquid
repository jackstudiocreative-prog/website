<section class="bp-wrap" {{ section.shopify_attributes }}>
  <div class="bp-head">
    {% if section.settings.eyebrow != blank %}<span class="bp-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
    <h2 class="bp-heading">{{ section.settings.heading }}</h2>
    {% if section.settings.text != blank %}<p class="bp-text">{{ section.settings.text }}</p>{% endif %}
  </div>

  <div class="bp-list">
    {% for block in section.blocks %}
      <div class="bp-item" {{ block.shopify_attributes }}>
        <div class="bp-icon">
          {%- case block.settings.icon -%}
          {%- when 'leather' -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 10c0-2 2-4 5-4h10c3 0 5 2 5 4v14c0 2-2 4-5 4H11c-3 0-5-2-5-4z"/><path d="M6 14h20M10 8v20"/></svg>
          {%- when 'hammer' -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M20 4l8 8-6 6-8-8zM14 10l-9 9a3 3 0 0 0 4 4l9-9"/></svg>
          {%- when 'heart' -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 28s-11-7-11-15a6 6 0 0 1 11-4 6 6 0 0 1 11 4c0 8-11 15-11 15z"/></svg>
          {%- when 'person' -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="16" cy="11" r="5"/><path d="M5 28c0-6 5-10 11-10s11 4 11 10"/></svg>
          {%- when 'shield' -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 4l11 4v8c0 8-5 13.5-11 16-6-2.5-11-8-11-16V8z"/><path d="M11 16l3.5 3.5L21 12"/></svg>
          {%- when 'truck' -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="10" width="17" height="12" rx="1"/><path d="M19 15h6l5 4v3H19z"/><circle cx="9" cy="26" r="2.2"/><circle cx="24" cy="26" r="2.2"/></svg>
          {%- else -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="16" cy="16" r="12"/></svg>
          {%- endcase -%}
        </div>
        <div class="bp-item-body">
          {% if block.settings.num != blank %}<span class="bp-num">{{ block.settings.num }}</span>{% endif %}
          <h3 class="bp-title">{{ block.settings.title }}</h3>
          <p class="bp-desc">{{ block.settings.description }}</p>
        </div>
      </div>
    {% endfor %}
  </div>

  {% if section.settings.cta_text != blank %}
    <div class="bp-cta">
      <a class="bp-cta-btn" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }} &rarr;</a>
    </div>
  {% endif %}
</section>

<style>
  .bp-wrap{background:#F8F4EA;padding:80px 6vw;color:#2B2420;}
  .bp-head{text-align:center;max-width:640px;margin:0 auto 56px;}
  .bp-eyebrow{font-size:11px;letter-spacing:2.5px;text-transform:uppercase;color:#C38239;font-weight:700;display:block;margin-bottom:16px;}
  .bp-heading{font-family:'Bebas Neue',sans-serif;font-size:clamp(32px,4.5vw,52px);line-height:1.02;margin:0 0 18px;}
  .bp-text{font-size:14px;line-height:1.75;color:#7A7263;margin:0;}

  .bp-list{display:grid;grid-template-columns:repeat(2,1fr);gap:48px 56px;max-width:1000px;margin:0 auto;}
  .bp-item{display:flex;gap:20px;align-items:flex-start;}
  .bp-icon{flex-shrink:0;width:46px;height:46px;border-radius:50%;border:1.5px solid #C38239;color:#C38239;display:flex;align-items:center;justify-content:center;padding:11px;box-sizing:border-box;}
  .bp-icon svg{width:100%;height:100%;}
  .bp-num{display:block;font-family:'Bebas Neue',sans-serif;font-size:12px;letter-spacing:1.5px;color:#C38239;margin-bottom:6px;}
  .bp-title{font-family:'Bebas Neue',sans-serif;font-size:20px;letter-spacing:.5px;margin:0 0 8px;}
  .bp-desc{font-size:13.5px;line-height:1.7;color:#7A7263;margin:0;max-width:380px;}

  .bp-cta{text-align:center;margin-top:64px;}
  .bp-cta-btn{display:inline-block;background:#C38239;color:#F4EFDC;padding:14px 30px;border-radius:3px;font-size:12px;font-weight:700;letter-spacing:1.5px;text-transform:uppercase;text-decoration:none;}
  .bp-cta-btn:hover{background:#A8702F;}

  @media(max-width:768px){
    .bp-list{grid-template-columns:1fr;gap:36px;}
    .bp-item{gap:16px;}
  }
</style>

{% schema %}
{
  "name": "Brand Promise — Detail",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"What We Stand For"},
    {"type":"text","id":"heading","label":"Heading","default":"Our Brand Promise"},
    {"type":"textarea","id":"text","label":"Intro text","default":"Every Jack Studio piece is made on a simple promise — quality materials, honest craftsmanship, and service you can rely on."},
    {"type":"header","content":"Closing CTA (optional)"},
    {"type":"text","id":"cta_text","label":"Button text"},
    {"type":"url","id":"cta_link","label":"Button link"}
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {"type":"select","id":"icon","label":"Icon","default":"leather","options":[{"value":"leather","label":"Leather"},{"value":"hammer","label":"Craft"},{"value":"heart","label":"Service"},{"value":"person","label":"Personal"},{"value":"shield","label":"Trust"},{"value":"truck","label":"Delivery"}]},
        {"type":"text","id":"num","label":"Number label (optional)","default":"01"},
        {"type":"text","id":"title","label":"Title","default":"Premium Materials"},
        {"type":"textarea","id":"description","label":"Description","default":"We select full-grain and top-grain leathers built to age gracefully, not fall apart."}
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Brand Promise — Detail",
      "blocks": [
        {"type":"pillar","settings":{"icon":"leather","num":"01","title":"Premium Materials","description":"We select full-grain and top-grain leathers built to age gracefully, not fall apart."}},
        {"type":"pillar","settings":{"icon":"hammer","num":"02","title":"Crafted To Last","description":"Every piece is cut, stitched and finished with the same care since 2013 — built for daily use, not just display."}},
        {"type":"pillar","settings":{"icon":"heart","num":"03","title":"Thoughtful Service","description":"From in-store advice to after-sales repair and polish care, we're with you long after checkout."}},
        {"type":"pillar","settings":{"icon":"person","num":"04","title":"Designed For You","description":"Personalisation, engraving and corporate customisation — made relevant to how you actually live and work."}}
      ]
    }
  ]
}
{% endschema %}