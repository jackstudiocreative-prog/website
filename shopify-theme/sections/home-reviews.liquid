<section class="reviews" {{ section.shopify_attributes }}><div class="eyebrow">{{ section.settings.eyebrow }}</div><div class="gr-title">{{ section.settings.heading }}</div><p class="gr-sub">{{ section.settings.text }}</p><div class="gr-stat"><div class="gr-stat-number">{{ section.settings.stat }}</div><div class="gr-stat-copy"><strong>{{ section.settings.stat_title }}</strong><span>{{ section.settings.stat_note }}</span></div></div><div class="gr-stars">★★★★★</div><div class="gr-brand-grid">{% for block in section.blocks %}<div class="gr-brand-card" {{ block.shopify_attributes }}><div class="gr-card-stars">★★★★★</div><p>{{ block.settings.text }}</p><span class="source">{{ block.settings.source }}</span></div>{% endfor %}</div><a class="btn btn-outline" href="{{ section.settings.link }}">{{ section.settings.button }}</a></section>
{% schema %}
{"name":"HOME — Customer Reviews","max_blocks":6,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Customer Love"},{"type":"text","id":"heading","label":"Heading","default":"WHAT OUR CUSTOMERS SAY"},{"type":"textarea","id":"text","label":"Description","default":"Trusted by customers across Malaysia for quality products, thoughtful gifting and attentive service."},{"type":"text","id":"stat","label":"Stat","default":"5,000+"},{"type":"text","id":"stat_title","label":"Stat title","default":"5-Star Reviews"},{"type":"text","id":"stat_note","label":"Stat note","default":"Brand-level figure reported by Jack Studio"},{"type":"url","id":"link","label":"Reviews link"},{"type":"text","id":"button","label":"Button","default":"View Jack Studio Reviews"}],"blocks":[{"type":"review","name":"Review","settings":[{"type":"textarea","id":"text","label":"Review","default":"Quality products and attentive service are part of the Jack Studio experience."},{"type":"text","id":"source","label":"Source","default":"Customer Experience"}]}],"presets":[{"name":"HOME — Customer Reviews","blocks":[{"type":"review"},{"type":"review"},{"type":"review"}]}]}
{% endschema %}