<section class="icon-section" {{ section.shopify_attributes }}><div class="eyebrow" style="text-align:center">{{ section.settings.eyebrow }}</div><h2 style="text-align:center;margin:8px 0 30px">{{ section.settings.heading }}</h2><div class="icon-row">{% for block in section.blocks %}<div class="icon-item" {{ block.shopify_attributes }}><div class="icon-circle">{{ block.settings.icon }}</div><span>{{ block.settings.title }}</span></div>{% endfor %}</div></section>
{% schema %}
{"name":"HOME — Icon Benefits","max_blocks":8,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"THE JACK STUDIO EXPERIENCE"},{"type":"text","id":"heading","label":"Heading","default":"Thoughtful details, built in."}],"blocks":[{"type":"item","name":"Benefit","settings":[{"type":"text","id":"icon","label":"Icon","default":"✦"},{"type":"text","id":"title","label":"Title","default":"Genuine Leather"}]}],"presets":[{"name":"HOME — Icon Benefits","blocks":[{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"},{"type":"item"}]}]}
{% endschema %}