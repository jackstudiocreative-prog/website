<div class="ol-wrap">
  {%- if section.settings.banner_image != blank -%}
    {%- assign banner_href = section.settings.banner_link | default: '#stores' -%}
    <div class="ol-banner">
      <a href="{{ banner_href }}">{{ section.settings.banner_image | image_url: width: 2400 | image_tag: loading: 'eager', class: 'ol-banner-img' }}</a>
    </div>
  {%- else -%}
    <div class="ol-eyebrow">{{ section.settings.eyebrow }}</div>
    <h1>{{ section.settings.heading }}</h1>
    {% if section.settings.subtitle != blank %}<p class="ol-sub">{{ section.settings.subtitle }}</p>{% endif %}

    {%- if section.settings.show_map -%}
    <div class="ol-map-card">
      <svg class="ol-peninsula" viewBox="0 0 500 750" xmlns="http://www.w3.org/2000/svg" aria-label="Jack Studio outlets across Peninsular Malaysia" role="img">
        <defs>
          <filter id="olShadow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur in="SourceAlpha" stdDeviation="6"/>
            <feOffset dx="0" dy="4"/>
            <feComponentTransfer><feFuncA type="linear" slope="0.15"/></feComponentTransfer>
            <feMerge><feMergeNode/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
        </defs>
        <path class="ol-land" filter="url(#olShadow)" d="M 220 48 C 300 55, 355 120, 380 210 C 420 275, 425 350, 410 415 C 420 490, 425 565, 395 635 C 370 695, 325 735, 275 735 C 220 730, 185 695, 180 640 C 170 575, 170 510, 170 460 C 130 425, 90 375, 82 305 C 75 245, 92 190, 118 160 C 140 115, 165 75, 200 55 C 210 48, 215 45, 220 48 Z"/>
        <text class="ol-rlabel" x="35"  y="145">Penang</text>
        <text class="ol-rlabel" x="40"  y="360">Klang Valley</text>
        <text class="ol-rlabel" x="40"  y="470">N. Sembilan</text>
        <text class="ol-rlabel" x="390" y="660">Johor</text>
        <text class="ol-rlabel" x="420" y="400">Pahang</text>
        <text class="ol-rlabel" x="405" y="258">Terengganu</text>
        {%- assign kv = '155,380|178,375|172,402|200,418|208,388|210,365' | split: '|' -%}
        {%- for p in kv -%}{%- assign xy = p | split: ',' -%}<circle class="ol-halo" cx="{{ xy[0] }}" cy="{{ xy[1] }}" r="14"/><circle class="ol-dot-ink" cx="{{ xy[0] }}" cy="{{ xy[1] }}" r="6.5"/>{%- endfor -%}
        {%- assign jh = '330,665|285,685|280,655' | split: '|' -%}
        {%- for p in jh -%}{%- assign xy = p | split: ',' -%}<circle class="ol-halo" cx="{{ xy[0] }}" cy="{{ xy[1] }}" r="14"/><circle class="ol-dot-tan" cx="{{ xy[0] }}" cy="{{ xy[1] }}" r="6.5"/>{%- endfor -%}
        {%- assign ot = '185,155|375,260|365,400|225,470' | split: '|' -%}
        {%- for p in ot -%}{%- assign xy = p | split: ',' -%}<circle class="ol-halo" cx="{{ xy[0] }}" cy="{{ xy[1] }}" r="14"/><circle class="ol-dot-sage" cx="{{ xy[0] }}" cy="{{ xy[1] }}" r="6.5"/>{%- endfor -%}
      </svg>
      <div class="ol-legend">
        <span class="ol-lg"><i class="ol-lg-dot ol-lg-ink"></i> Klang Valley &middot; 6 stores</span>
        <span class="ol-lg"><i class="ol-lg-dot ol-lg-tan"></i> Johor &middot; 3 stores</span>
        <span class="ol-lg"><i class="ol-lg-dot ol-lg-sage"></i> Other regions &middot; 4 stores</span>
        <span class="ol-lg-hint">Tap a pin to jump to that store</span>
      </div>
    </div>
    {%- endif -%}
  {%- endif -%}

  {%- assign all_outlets = shop.metaobjects.outlet.values -%}
  {%- assign groups = '' -%}
  {%- for outlet in all_outlets -%}
    {%- assign r = outlet.region.value -%}
    {%- unless groups contains r -%}{%- assign groups = groups | append: r | append: '||' -%}{%- endunless -%}
  {%- endfor -%}
  {%- assign group_list = groups | split: '||' -%}

  <div id="stores">
  {%- for region in group_list -%}
    {%- if region != blank -%}
      <div class="ol-region">
        <h2>{{ region }}</h2>
        <div class="ol-grid">
          {%- for outlet in all_outlets -%}
            {%- if outlet.region.value == region -%}
              <article class="ol-card">
                <div class="ol-photo">
                  {%- if outlet.photo.value -%}{{ outlet.photo.value | image_url: width: 500 | image_tag: loading: 'lazy' }}{%- endif -%}
                </div>
                <div class="ol-body">
                  {% if outlet.location_label.value != blank %}<div class="ol-loc">{{ outlet.location_label.value }}</div>{% endif %}
                  <h3>{{ outlet.name.value }}</h3>
                  {% if outlet.address.value != blank %}<div class="ol-row">{{ outlet.address.value }}</div>{% endif %}
                  {% if outlet.hours.value != blank %}<div class="ol-row">{{ outlet.hours.value }}</div>{% endif %}
                  {% if outlet.phone.value != blank %}<div class="ol-row">{{ outlet.phone.value }}</div>{% endif %}
                  <div class="ol-actions">
                    {%- assign dir_link = outlet.directions_url.value -%}
                    {%- if dir_link == blank and outlet.address.value != blank -%}
                      {%- assign dir_link = 'https://www.google.com/maps/search/?api=1&query=' | append: outlet.address.value | url_param_escape -%}
                    {%- endif -%}
                    {% if dir_link != blank %}<a class="ol-btn" href="{{ dir_link }}" target="_blank" rel="noopener">Get Directions</a>{% endif %}
                    {%- assign call_link = outlet.call_url.value -%}
                    {%- if call_link == blank and outlet.phone.value != blank -%}
                      {%- assign call_link = 'tel:' | append: outlet.phone.value | remove: ' ' | remove: '-' -%}
                    {%- endif -%}
                    {% if call_link != blank %}<a class="ol-btn-outline" href="{{ call_link }}">Call Store</a>{% endif %}
                  </div>
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  {%- endfor -%}
  </div>
</div>
<style>
  html{scroll-behavior:smooth;}
  .ol-wrap{background:#F8F4EA;color:#2B2420;}
  .ol-banner{width:100%;margin:0 0 48px;}
  .ol-banner a{display:block;cursor:pointer;}
  .ol-banner-img{width:100%;height:auto;display:block;transition:opacity .2s;}
  .ol-banner a:hover .ol-banner-img{opacity:.92;}
  .ol-wrap > .ol-eyebrow,
  .ol-wrap > h1,
  .ol-wrap > .ol-sub,
  .ol-wrap > .ol-map-card,
  .ol-wrap #stores{padding-left:24px;padding-right:24px;max-width:1200px;margin-left:auto;margin-right:auto;}
  .ol-wrap > .ol-eyebrow{padding-top:40px;}
  #stores{scroll-margin-top:80px;}
  .ol-eyebrow{text-align:center;font-size:11px;letter-spacing:2.8px;text-transform:uppercase;color:#7A7263;margin-bottom:10px;}
  .ol-wrap>h1{text-align:center;font-family:'Bebas Neue',sans-serif;font-size:clamp(30px,3.6vw,40px);letter-spacing:1px;margin:0 0 12px;}
  .ol-sub{text-align:center;color:#7A7263;font-size:15px;margin:0 0 44px;}
  .ol-map-card{max-width:900px;margin:0 auto 44px;background:#FFFFFF;border-radius:24px;padding:28px 24px 22px;border:1px solid #E3DCC8;box-shadow:0 4px 24px rgba(43,36,28,0.06);}
  .ol-peninsula{display:block;width:100%;max-width:460px;height:auto;margin:0 auto;}
  .ol-peninsula .ol-land{fill:#EDE4CC;}
  .ol-peninsula .ol-rlabel{font-family:'Georgia',serif;font-style:italic;font-size:15px;fill:#B3A793;font-weight:500;}
  .ol-peninsula .ol-halo{fill:#fff;opacity:.75;}
  .ol-peninsula .ol-dot-ink{fill:#2E241C;}
  .ol-peninsula .ol-dot-tan{fill:#A88960;}
  .ol-peninsula .ol-dot-sage{fill:#7A8668;}
  .ol-legend{display:flex;flex-wrap:wrap;justify-content:center;align-items:center;gap:14px 24px;padding-top:20px;margin-top:22px;border-top:1px solid #E3DCC8;font-size:11.5px;color:#7A7263;letter-spacing:.02em;}
  .ol-lg{display:inline-flex;align-items:center;gap:8px;}
  .ol-lg-dot{width:9px;height:9px;border-radius:50%;display:inline-block;}
  .ol-lg-ink{background:#2E241C;} .ol-lg-tan{background:#A88960;} .ol-lg-sage{background:#7A8668;}
  .ol-lg-hint{color:#7A7263;font-style:italic;font-size:11px;padding-left:12px;border-left:1px solid #E3DCC8;}
  @media(max-width:640px){.ol-lg-hint{border-left:0;padding-left:0;width:100%;text-align:center;}.ol-wrap>h1{font-size:26px;}.ol-region h2{font-size:22px;}}
  .ol-region{margin-bottom:40px;padding-bottom:24px;}
  .ol-region h2{font-family:'Bebas Neue',sans-serif;font-size:clamp(26px,3vw,32px);letter-spacing:1px;margin:0 0 18px;border-bottom:1px solid #E3DCC8;padding-bottom:12px;}
  .ol-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:20px;}
  .ol-card{background:#FFFFFF;border:1px solid #E3DCC8;border-radius:6px;overflow:hidden;}
  .ol-photo{aspect-ratio:4/3;background:#EFEAD9;}
  .ol-photo img{width:100%;height:100%;object-fit:cover;display:block;}
  .ol-body{padding:16px;}
  .ol-loc{font-size:10px;letter-spacing:.5px;text-transform:uppercase;color:#7A7263;margin-bottom:4px;}
  .ol-body h3{font-size:15px;margin:0 0 10px;}
  .ol-row{font-size:13px;color:#7A7263;margin-bottom:4px;}
  .ol-actions{display:flex;gap:8px;margin-top:12px;flex-wrap:wrap;}
  .ol-btn{background:#C38239;color:#fff;font-size:11px;font-weight:600;padding:8px 14px;border-radius:3px;text-decoration:none;}
  .ol-btn-outline{border:1px solid #2B2420;color:#2B2420;font-size:11px;font-weight:600;padding:7px 13px;border-radius:3px;text-decoration:none;}
</style>
{% schema %}
{
  "name": "Outlets list",
  "settings": [
    { "type": "paragraph", "content": "门店资料(含照片)现在统一在后台 Content > Metaobjects > Outlet 里维护,与首页Our Outlets区块共用同一批门店条目。改这里的任何门店资料,两边会自动同步。Get Directions / Call Store 两个按钮:默认自动用地址生成Google地图链接、用电话生成拨号链接;如果在门店条目里填了 Custom Directions Link / Custom Call Link,会优先用你手动填的链接。" },
    { "type": "header", "content": "Hero Banner (overrides text + map below)" },
    { "type": "image_picker", "id": "banner_image", "label": "Banner image (full-width)" },
    { "type": "url", "id": "banner_link", "label": "Banner click link (defaults to #stores)" },
    { "type": "header", "content": "Text Header (used only if no banner image)" },
    { "type": "text",  "id": "eyebrow",  "label": "Eyebrow",  "default": "Our Boutiques" },
    { "type": "text",  "id": "heading",  "label": "Heading", "default": "From the Klang Valley to the East Coast." },
    { "type": "text",  "id": "subtitle", "label": "Subtitle", "default": "13 Jack Studio boutiques across Peninsular Malaysia — find the one nearest you." },
    { "type": "checkbox", "id": "show_map", "label": "Show peninsula map", "default": true }
  ],
  "presets": [{ "name": "Outlets list" }]
}
{% endschema %}