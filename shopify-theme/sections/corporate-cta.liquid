<section class="cta3-wrap" {{ section.shopify_attributes }}>
  <div class="cta3-banner">
    <div class="cta3-left">
      {% if section.settings.eyebrow != blank %}<span class="cta3-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
      <h2 class="cta3-heading">{{ section.settings.heading }}</h2>
      <p class="cta3-text">{{ section.settings.text }}</p>
      <div class="cta3-actions">
        {% if section.settings.quote_label != blank %}<a class="cta3-btn-light" href="{{ section.settings.quote_link }}">{{ section.settings.quote_label }}</a>{% endif %}
        {% if section.settings.contact_label != blank %}<a class="cta3-btn-outline" href="{{ section.settings.contact_link }}">{{ section.settings.contact_label }}</a>{% endif %}
      </div>
    </div>
    <div class="cta3-right">
      {% if section.settings.image %}
        {{ section.settings.image | image_url: width: 1000 | image_tag: loading: 'lazy' }}
      {% endif %}
    </div>
  </div>

  {% if section.settings.show_features %}
  <div class="cta3-features">
    <div class="cta3-feature">
      <span class="cta3-ficon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M16 4l10 4v8c0 6-4 11-10 12-6-1-10-6-10-12V8z" transform="translate(-4,0)"/><path d="M8 12l2.5 2.5L16 9"/></svg></span>
      <div class="cta3-fbody"><strong>{{ section.settings.f1_title }}</strong><span>{{ section.settings.f1_sub }}</span></div>
    </div>
    <div class="cta3-feature">
      <span class="cta3-ficon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 8h16M4 8a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2 2 2 0 0 0 2 2h0a2 2 0 0 0 2-2 2 2 0 0 1 2-2h2a2 2 0 0 1 2 2M4 16h16M4 16a2 2 0 0 0 2 2h9a2 2 0 0 0 2-2 2 2 0 0 1 2-2"/></svg></span>
      <div class="cta3-fbody"><strong>{{ section.settings.f2_title }}</strong><span>{{ section.settings.f2_sub }}</span></div>
    </div>
    <div class="cta3-feature">
      <span class="cta3-ficon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="2" y="9" width="13" height="9" rx="1"/><path d="M15 12h4l3 3v3h-7z"/><circle cx="7" cy="20" r="1.6"/><circle cx="18" cy="20" r="1.6"/></svg></span>
      <div class="cta3-fbody"><strong>{{ section.settings.f3_title }}</strong><span>{{ section.settings.f3_sub }}</span></div>
    </div>
    <div class="cta3-feature">
      <span class="cta3-ficon"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 13a8 8 0 0 1 16 0"/><path d="M4 13v4a2 2 0 0 0 2 2h1v-6H5a1 1 0 0 0-1 1zM20 13v4a2 2 0 0 1-2 2h-1v-6h2a1 1 0 0 1 1 1z"/><path d="M14 19a2 2 0 0 1-2 2h-1"/></svg></span>
      <div class="cta3-fbody"><strong>{{ section.settings.f4_title }}</strong><span>{{ section.settings.f4_sub }}</span></div>
    </div>
  </div>
  {% endif %}
</section>

<style>
  .cta3-wrap{width:100%;}
  .cta3-banner{position:relative;min-height:340px;background:#A9B79A;color:#fff;overflow:hidden;}
  .cta3-left{position:relative;z-index:2;max-width:70%;display:flex;flex-direction:column;justify-content:center;padding:44px 4vw 44px 6vw;min-height:340px;box-sizing:border-box;}
  .cta3-eyebrow{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#F4EFDC;font-weight:600;display:block;margin-bottom:14px;}
  .cta3-heading{font-family:'Bebas Neue',sans-serif;font-size:clamp(22px,2.8vw,32px);line-height:1.08;margin:0 0 14px;max-width:480px;}
  .cta3-text{font-size:13.5px;line-height:1.6;opacity:.92;max-width:440px;margin:0 0 24px;}
  .cta3-actions{display:flex;gap:12px;flex-wrap:wrap;}
  .cta3-btn-light{display:inline-block;background:#F4EFDC;color:#2B2420;padding:12px 22px;font-size:12px;font-weight:700;letter-spacing:.5px;border-radius:3px;text-decoration:none;}
  .cta3-btn-light:hover{background:#fff;}
  .cta3-btn-outline{display:inline-block;border:1.5px solid #fff;color:#fff;padding:11px 22px;font-size:12px;font-weight:700;letter-spacing:.5px;border-radius:3px;text-decoration:none;}
  .cta3-btn-outline:hover{background:rgba(255,255,255,.12);}
  .cta3-right{position:absolute;top:0;right:0;bottom:0;width:30%;z-index:1;clip-path:polygon(18% 0,100% 0,100% 100%,0% 100%);}
  .cta3-right img{width:100%;height:100%;object-fit:cover;display:block;}

  .cta3-features{display:grid;grid-template-columns:repeat(4,1fr);gap:20px;background:#8FA07E;padding:22px 6vw;}
  .cta3-feature{display:flex;align-items:center;gap:12px;}
  .cta3-ficon{flex-shrink:0;color:#C4823A;}
  .cta3-fbody{display:flex;flex-direction:column;gap:2px;}
  .cta3-fbody strong{font-size:12.5px;font-weight:700;color:#fff;letter-spacing:.3px;}
  .cta3-fbody span{font-size:11px;color:#F1EEE1;}

  @media(max-width:900px){
    .cta3-banner{min-height:400px;overflow:hidden;}
    .cta3-left{max-width:70%;padding:26px 4vw 26px 5vw;min-height:400px;}
    .cta3-eyebrow{font-size:11px;letter-spacing:1.4px;margin-bottom:12px;}
    .cta3-heading{font-size:22px;line-height:1.14;margin:0 0 12px;}
    .cta3-text{font-size:13.5px;line-height:1.55;margin:0 0 18px;}
    .cta3-actions{gap:10px;}
    .cta3-btn-light,.cta3-btn-outline{padding:11px 17px;font-size:11.5px;}
    .cta3-right{width:30%;}
    .cta3-features{grid-template-columns:repeat(2,1fr);gap:18px 14px;padding:22px 24px;}
  }
  @media(max-width:520px){
    .cta3-banner{min-height:350px;}
    .cta3-left{padding:22px 4vw 22px 5vw;min-height:350px;}
    .cta3-eyebrow{font-size:9.5px;margin-bottom:9px;}
    .cta3-heading{font-size:17px;margin:0 0 9px;}
    .cta3-text{font-size:11.5px;line-height:1.48;margin:0 0 14px;-webkit-line-clamp:4;display:-webkit-box;-webkit-box-orient:vertical;overflow:hidden;}
    .cta3-actions{flex-direction:column;align-items:flex-start;gap:8px;}
    .cta3-btn-light,.cta3-btn-outline{padding:10px 14px;font-size:10.5px;width:auto;}
    .cta3-right{clip-path:polygon(28% 0,100% 0,100% 100%,0% 100%);}
    .cta3-features{grid-template-columns:1fr;}
  }
</style>

{% schema %}
{
  "name": "CORPORATE — CTA",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow (optional)"},
    {"type":"text","id":"heading","label":"Heading","default":"Need a Corporate Gift Solution?"},
    {"type":"textarea","id":"text","label":"Text","default":"Tell us what you need and we'll help you create the right solution — from single gifts to large-scale corporate rollouts."},
    {"type":"text","id":"quote_label","label":"Primary button label","default":"Get a Quote"},
    {"type":"url","id":"quote_link","label":"Primary button link"},
    {"type":"text","id":"contact_label","label":"Secondary button label (optional)","default":"Contact Us"},
    {"type":"url","id":"contact_link","label":"Secondary button link"},
    {"type":"image_picker","id":"image","label":"Right-side image"},
    {"type":"header","content":"Feature strip"},
    {"type":"checkbox","id":"show_features","label":"Show feature strip","default":true},
    {"type":"text","id":"f1_title","label":"Feature 1 title","default":"Premium Quality"},
    {"type":"text","id":"f1_sub","label":"Feature 1 subtitle","default":"Crafted with care"},
    {"type":"text","id":"f2_title","label":"Feature 2 title","default":"Custom Solutions"},
    {"type":"text","id":"f2_sub","label":"Feature 2 subtitle","default":"Tailored to your brand"},
    {"type":"text","id":"f3_title","label":"Feature 3 title","default":"Reliable Delivery"},
    {"type":"text","id":"f3_sub","label":"Feature 3 subtitle","default":"On time, every time"},
    {"type":"text","id":"f4_title","label":"Feature 4 title","default":"Dedicated Support"},
    {"type":"text","id":"f4_sub","label":"Feature 4 subtitle","default":"Here to help"}
  ]
}
{% endschema %}