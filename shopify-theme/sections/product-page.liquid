{% assign product = product %}
<div class="pd-wrap">
  <div class="pd-grid">
    <div class="pd-gallery">
      {% if product.featured_media %}
        <div class="pd-main-image">
          <img id="pd-main-img" src="{{ product.featured_media | image_url: width: 900 }}" alt="{{ product.title | escape }}" loading="eager">
          <button type="button" class="pd-wish-btn" data-wishlist-toggle="{{ product.handle }}" aria-label="Add to wishlist">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10z"/></svg>
          </button>
        </div>
        {% if product.media.size > 1 %}
          <div class="pd-thumbs">
            {% for media in product.media limit: 6 %}
              <button type="button" class="pd-thumb{% if forloop.first %} is-active{% endif %}" data-full="{{ media | image_url: width: 900 | escape }}">
                <img src="{{ media | image_url: width: 200 }}" alt="{{ product.title | escape }} thumbnail" loading="lazy">
              </button>
            {% endfor %}
          </div>
        {% endif %}
      {% else %}
        <div class="pd-main-image pd-placeholder">
          <button type="button" class="pd-wish-btn" data-wishlist-toggle="{{ product.handle }}" aria-label="Add to wishlist">
            <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-7-4.5-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 11c0 5.5-7 10-7 10z"/></svg>
          </button>
        </div>
      {% endif %}
    </div>

    <div class="pd-info">
      {% if product.vendor != blank %}<div class="pd-vendor">{{ product.vendor }}</div>{% endif %}
      <h1 class="pd-title">{{ product.title }}</h1>
      <div class="pd-price">
        {{ product.selected_or_first_available_variant.price | money }}
        {% if product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}
          <s class="pd-compare">{{ product.selected_or_first_available_variant.compare_at_price | money }}</s>
        {% endif %}
      </div>

      {% if product.tags.size > 0 %}
        <div class="pd-tags">
          {% for tag in product.tags limit: 6 %}<span class="pd-tag">{{ tag }}</span>{% endfor %}
        </div>
      {% endif %}

      {% if product.has_only_default_variant == false %}
        {% for option in product.options_with_values %}
          <div class="pd-option">
            <label>{{ option.name }}</label>
            <select class="pd-select" data-option-select>
              {% for value in option.values %}
                <option value="{{ value | escape }}" {% if option.selected_value == value %}selected{% endif %}>{{ value }}</option>
              {% endfor %}
            </select>
          </div>
        {% endfor %}
      {% endif %}

      <div class="pd-actions">
        <div class="pd-qty">
          <button type="button" class="pd-qty-btn" data-qty-minus>&minus;</button>
          <input type="number" value="1" min="1" class="pd-qty-input" id="pd-qty-input">
          <button type="button" class="pd-qty-btn" data-qty-plus>+</button>
        </div>
        <button type="button" class="pd-add-btn" data-add-to-cart="{{ product.selected_or_first_available_variant.id }}" data-qty="1" id="pd-add-btn" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
          {% if product.selected_or_first_available_variant.available %}Add to Cart{% else %}Sold Out{% endif %}
        </button>
      </div>

      {% if section.settings.show_trust_strip %}
        <div class="pd-trust">
          {% if section.settings.trust_1_text != blank %}
          <div class="pd-trust-item">
            <span class="pd-trust-icon"><svg viewBox="0 0 32 32" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M13 4h6v6h-6zM10 10h12v18a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2z"/><path d="M14 18h4M14 22h4"/></svg></span>
            <span>{{ section.settings.trust_1_text }}</span>
          </div>
          {% endif %}
          {% if section.settings.trust_2_text != blank %}
          <div class="pd-trust-item">
            <span class="pd-trust-icon"><svg viewBox="0 0 32 32" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M8 26h16M12 22l2-14h4l2 14"/></svg></span>
            <span>{{ section.settings.trust_2_text }}</span>
          </div>
          {% endif %}
          {% if section.settings.trust_3_text != blank %}
          <div class="pd-trust-item">
            <span class="pd-trust-icon"><svg viewBox="0 0 32 32" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="11" width="17" height="12" rx="1"/><path d="M20 15h6l3 4v4h-9z"/><circle cx="9" cy="27" r="2.2"/><circle cx="24" cy="27" r="2.2"/></svg></span>
            <span>{{ section.settings.trust_3_text }}</span>
          </div>
          {% endif %}
          {% if section.settings.trust_4_text != blank %}
          <div class="pd-trust-item">
            <span class="pd-trust-icon"><svg viewBox="0 0 32 32" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="12" width="22" height="14" rx="1"/><path d="M5 17h22M16 12v14M12 12c-2 0-3-1-3-3s1-3 3-3c1.5 0 3 2 4 3-1 0-3.5 3-4 3zM20 12c2 0 3-1 3-3s-1-3-3-3c-1.5 0-3 2-4 3 1 0 3.5 3 4 3z"/></svg></span>
            <span>{{ section.settings.trust_4_text }}</span>
          </div>
          {% endif %}
        </div>
      {% endif %}

      {% if product.description != blank %}
        <div class="pd-desc">{{ product.description }}</div>
      {% endif %}

      <div class="pd-meta">
        {% if product.type != blank %}<div><strong>Type:</strong> {{ product.type }}</div>{% endif %}
        <div><strong>SKU:</strong> {{ product.selected_or_first_available_variant.sku | default: 'N/A' }}</div>
      </div>
    </div>
  </div>
</div>

<style>
  .pd-wrap{max-width:1200px;margin:0 auto;padding:48px 24px 80px;color:#2B2420;}
  .pd-grid{display:grid;grid-template-columns:1fr 1fr;gap:56px;}
  .pd-gallery,.pd-info{min-width:0;}
  .pd-main-image{position:relative;aspect-ratio:1;background:#F9F4E3;border-radius:8px;overflow:hidden;}
  .pd-main-image img{width:100%;height:100%;object-fit:cover;display:block;}
  .pd-placeholder{background:linear-gradient(135deg,#EFEAD9,#E3DCC8);}
  .pd-wish-btn{position:absolute;top:14px;right:14px;z-index:2;width:40px;height:40px;border-radius:50%;background:rgba(244,239,220,.92);border:0;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#2B2420;transition:transform .2s;}
  .pd-wish-btn:hover{transform:scale(1.08);}
  .pd-wish-btn.is-wished{color:#8DA68A;}
  .pd-wish-btn.is-wished svg{fill:#8DA68A;stroke:#8DA68A;}
  .pd-thumbs{display:flex;gap:10px;margin-top:12px;}
  .pd-thumb{width:64px;height:64px;border-radius:4px;overflow:hidden;border:2px solid transparent;padding:0;cursor:pointer;background:none;}
  .pd-thumb.is-active{border-color:#C4823A;}
  .pd-thumb img{width:100%;height:100%;object-fit:cover;display:block;pointer-events:none;}
  .pd-vendor{font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:#7A7263;margin-bottom:8px;}
  .pd-title{font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:1px;margin:0 0 14px;line-height:1.15;width:100%;overflow-wrap:break-word;word-break:break-word;white-space:normal;}
  .pd-price{font-size:22px;font-weight:600;color:#2B2420;margin-bottom:16px;}
  .pd-compare{color:#A69C86;font-weight:400;font-size:16px;margin-left:8px;}
  .pd-tags{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px;}
  .pd-tag{background:#F4EFDC;color:#7A7263;font-size:11px;padding:4px 10px;border-radius:12px;}
  .pd-option{margin-bottom:16px;}
  .pd-option label{display:block;font-size:11px;letter-spacing:1px;text-transform:uppercase;color:#7A7263;margin-bottom:6px;}
  .pd-select{width:100%;padding:10px 12px;border:1px solid #D8CFB8;border-radius:4px;font-size:13px;background:#F9F4E3;}
  .pd-actions{display:flex;gap:12px;margin:24px 0;}
  .pd-qty{display:flex;align-items:center;border:1px solid #D8CFB8;border-radius:4px;overflow:hidden;}
  .pd-qty-btn{width:36px;height:44px;background:#F9F4E3;border:0;cursor:pointer;font-size:16px;color:#2B2420;}
  .pd-qty-input{width:44px;height:44px;border:0;border-left:1px solid #D8CFB8;border-right:1px solid #D8CFB8;text-align:center;font-size:14px;-moz-appearance:textfield;}
  .pd-qty-input::-webkit-outer-spin-button,.pd-qty-input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0;}
  .pd-add-btn{flex:1;background:#C38239;color:#FFFFFF;border:0;border-radius:4px;font-size:13px;font-weight:600;letter-spacing:1px;text-transform:uppercase;cursor:pointer;}
  .pd-add-btn:hover{background:#A8702F;}
  .pd-add-btn:disabled{background:#B3AA8F;cursor:not-allowed;}
  .pd-trust{display:grid;grid-template-columns:1fr 1fr;gap:12px 16px;margin:0 0 24px;padding:16px 18px;background:#F9F4E3;border-radius:6px;}
  .pd-trust-item{display:flex;align-items:center;gap:8px;}
  .pd-trust-icon{flex-shrink:0;width:16px;height:16px;color:#2B2420;}
  .pd-trust-item span:last-child{font-size:12.5px;line-height:1.4;color:#2B2420;}
  .pd-desc{font-size:14px;line-height:1.7;color:#4a3f33;margin:20px 0;padding-top:20px;border-top:1px solid #E3DCC8;}
  .pd-meta{font-size:12px;color:#7A7263;line-height:1.8;margin-top:16px;}
  @media(max-width:768px){.pd-grid{grid-template-columns:1fr;gap:28px;}.pd-wrap{padding:24px 20px 60px;}.pd-title{font-size:18px;}.pd-main-image{aspect-ratio:1;max-height:50vh;}}
  @media(max-width:480px){.pd-trust{grid-template-columns:1fr;}}
</style>

<script>
  (function(){
    var mainImg = document.getElementById('pd-main-img');
    document.querySelectorAll('.pd-thumb').forEach(function(btn){
      btn.addEventListener('click', function(e){
        e.preventDefault();
        var full = btn.getAttribute('data-full');
        if(mainImg && full) mainImg.setAttribute('src', full);
        document.querySelectorAll('.pd-thumb').forEach(function(t){ t.classList.remove('is-active'); });
        btn.classList.add('is-active');
      });
    });
    var qtyInput = document.getElementById('pd-qty-input');
    var addBtn = document.getElementById('pd-add-btn');
    var minus = document.querySelector('[data-qty-minus]');
    var plus = document.querySelector('[data-qty-plus]');
    function syncQty(){ if(addBtn) addBtn.setAttribute('data-qty', qtyInput.value || 1); }
    if(minus) minus.addEventListener('click', function(){ var v = parseInt(qtyInput.value)||1; if(v>1) qtyInput.value = v-1; syncQty(); });
    if(plus) plus.addEventListener('click', function(){ var v = parseInt(qtyInput.value)||1; qtyInput.value = v+1; syncQty(); });
    if(qtyInput) qtyInput.addEventListener('input', syncQty);

    var variants = {{ product.variants | json }};
    var optionSelects = document.querySelectorAll('[data-option-select]');
    function updateVariant(){
      if(!optionSelects.length) return;
      var selected = Array.prototype.map.call(optionSelects, function(s){ return s.value; });
      var match = null;
      for(var i=0;i<variants.length;i++){
        var v = variants[i];
        var vals = [v.option1, v.option2, v.option3].filter(Boolean);
        var isMatch = vals.length === selected.length;
        if(isMatch){ for(var j=0;j<vals.length;j++){ if(vals[j] !== selected[j]){ isMatch = false; break; } } }
        if(isMatch){ match = v; break; }
      }
      if(match && addBtn){
        addBtn.setAttribute('data-add-to-cart', match.id);
        addBtn.disabled = !match.available;
        addBtn.textContent = match.available ? 'Add to Cart' : 'Sold Out';
      }
    }
    optionSelects.forEach(function(s){ s.addEventListener('change', updateVariant); });
  })();
</script>
{% schema %}
{"name":"Product page","settings":[
{"type":"checkbox","id":"show_trust_strip","label":"Show trust strip below Add to Cart","default":true},
{"type":"text","id":"trust_1_text","label":"Trust item 1 (care icon)","default":"Free polish care for every purchase"},
{"type":"text","id":"trust_2_text","label":"Trust item 2 (personalisation icon)","default":"Free name engraving & embossing"},
{"type":"text","id":"trust_3_text","label":"Trust item 3 (delivery icon)","default":"Free shipping above RM99 (EM & WM)"},
{"type":"text","id":"trust_4_text","label":"Trust item 4 (gift icon)","default":"Exquisite gift packaging included"}
]}
{% endschema %}