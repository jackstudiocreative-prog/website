<section class="cpz-wrap" {{ section.shopify_attributes }}>
  <div class="cpz-left">
    <span class="cpz-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="cpz-heading">{{ section.settings.heading }}</h2>
    <p class="cpz-text">{{ section.settings.text }}</p>
    {% if section.settings.button_text != blank %}
      <a class="cpz-btn" href="{{ section.settings.button_link }}">{{ section.settings.button_text }} &rarr;</a>
    {% endif %}
  </div>
  <div class="cpz-grid">
    {% for block in section.blocks %}
      <div class="cpz-cap" {{ block.shopify_attributes }}>
        <span class="cpz-cap-icon">
          {%- case block.settings.icon -%}
          {%- when 'stamp' -%}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="5" y="3" width="14" height="9" rx="1"/><path d="M9 12v3M15 12v3M5 21h14M7 21v-4h10v4"/></svg>
          {%- when 'pencil' -%}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 20l1-4L15 6l3 3L8 19l-4 1z"/><path d="M13 8l3 3"/></svg>
          {%- when 'gift' -%}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><rect x="3" y="9" width="18" height="12" rx="1"/><path d="M3 9h18M12 9v12M8 9c-1.5 0-2.5-.8-2.5-2.2S6.5 4.5 8 4.5c1.2 0 2.5 1.6 3.5 2.5-.8 0-2.5 2-3.5 2zM16 9c1.5 0 2.5-.8 2.5-2.2S15.5 4.5 14 4.5c-1.2 0-2.5 1.6-3.5 2.5.8 0 2.5 2 3.5 2z"/></svg>
          {%- else -%}<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><circle cx="12" cy="12" r="9"/></svg>
          {%- endcase -%}
        </span>
        <div class="cpz-cap-body"><strong>{{ block.settings.title }}</strong><span>{{ block.settings.desc }}</span></div>
      </div>
    {% endfor %}
    {% for block in section.blocks %}
      <div class="cpz-img">
        {% if block.settings.image %}{{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy' }}{% endif %}
      </div>
    {% endfor %}
  </div>
</section>

<style>
  .cpz-wrap{display:flex;flex-wrap:wrap;gap:40px;background:{{ section.settings.bg_color }};padding:52px 6vw;align-items:center;}
  .cpz-left{flex:0 0 280px;}
  .cpz-eyebrow{font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#C4823A;font-weight:700;display:block;margin-bottom:12px;}
  .cpz-heading{font-family:'Bebas Neue',sans-serif;font-size:clamp(26px,3vw,32px);line-height:1.1;color:#2B2420;margin:0 0 16px;}
  .cpz-text{font-size:13px;line-height:1.6;color:#5A4E3F;margin:0 0 22px;}
  .cpz-btn{display:inline-block;background:#C38239;color:#fff;padding:11px 20px;font-size:11px;font-weight:700;letter-spacing:1px;text-transform:uppercase;text-decoration:none;border-radius:3px;}
  .cpz-btn:hover{background:#A8702F;}

  .cpz-grid{flex:1 1 500px;display:grid;grid-template-columns:repeat(3,1fr);column-gap:18px;row-gap:12px;}
  .cpz-cap{display:flex;align-items:flex-start;gap:8px;}
  .cpz-cap-icon{flex-shrink:0;width:26px;height:26px;border-radius:50%;border:1px solid #2B2420;color:#2B2420;display:flex;align-items:center;justify-content:center;}
  .cpz-cap-body strong{display:block;font-size:12px;letter-spacing:.5px;text-transform:uppercase;color:#2B2420;}
  .cpz-cap-body span{display:block;font-size:11.5px;color:#7A7263;line-height:1.4;}
  .cpz-img{aspect-ratio:1/1;border-radius:8px;overflow:hidden;background:#EDE4CC;}
  .cpz-img img{width:100%;height:100%;object-fit:cover;display:block;}

  @media(max-width:900px){
    .cpz-wrap{flex-direction:column;}
    .cpz-left{flex:0 0 auto;}
    .cpz-heading{font-size:22px;}
    .cpz-grid{width:100%;}
  }
  @media(max-width:600px){
    .cpz-grid{grid-template-columns:1fr;}
    .cpz-grid > *:nth-child(1){order:0;}
    .cpz-grid > *:nth-child(2){order:2;}
    .cpz-grid > *:nth-child(3){order:4;}
    .cpz-grid > *:nth-child(4){order:1;margin-bottom:20px;}
    .cpz-grid > *:nth-child(5){order:3;margin-bottom:20px;}
    .cpz-grid > *:nth-child(6){order:5;}
  }
</style>

{% schema %}
{
  "name": "CORPORATE — Personalise",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background","default":"#F4EFDC"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Make It Personal"},
    {"type":"text","id":"heading","label":"Heading","default":"Your Brand. Your Message. Your Gift."},
    {"type":"textarea","id":"text","label":"Text","default":"Add a personal touch with customisation options that reflect your brand identity."},
    {"type":"text","id":"button_text","label":"Button text","default":"Explore Personalisation"},
    {"type":"url","id":"button_link","label":"Button link"}
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {"type":"select","id":"icon","label":"Icon","default":"stamp","options":[{"value":"stamp","label":"Stamp"},{"value":"pencil","label":"Pencil"},{"value":"gift","label":"Gift"}]},
        {"type":"text","id":"title","label":"Title","default":"Logo Embossing"},
        {"type":"text","id":"desc","label":"Description","default":"Brand your products with elegance"},
        {"type":"image_picker","id":"image","label":"Image"}
      ]
    }
  ],
  "max_blocks": 3,
  "presets": [
    {
      "name": "CORPORATE — Personalise",
      "blocks": [
        {"type":"tile","settings":{"icon":"stamp","title":"Logo Embossing","desc":"Brand your products with elegance"}},
        {"type":"tile","settings":{"icon":"pencil","title":"Name Engraving","desc":"Add names, initials or meaningful text"}},
        {"type":"tile","settings":{"icon":"gift","title":"Custom Packaging","desc":"Premium gift box with your brand"}}
      ]
    }
  ]
}
{% endschema %}