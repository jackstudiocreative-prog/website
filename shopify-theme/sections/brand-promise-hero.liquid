<section class="bph-wrap" {{ section.shopify_attributes }}>
  <div class="bph-left">
    <span class="bph-eyebrow">{{ section.settings.eyebrow }}</span>
    <h1 class="bph-heading">
      <span class="bph-line-dark">{{ section.settings.heading_dark }}</span>
      <span class="bph-line-accent">{{ section.settings.heading_accent }}</span>
    </h1>
    <span class="bph-rule"></span>
    <p class="bph-text">{{ section.settings.text }}</p>
  </div>
  <div class="bph-right">
    {% if section.settings.image %}
      {{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'eager' }}
    {% endif %}
  </div>
</section>

<style>
  .bph-wrap{display:grid;grid-template-columns:.85fr 1.15fr;min-height:440px;background:#F8F4EA;}
  .bph-left{display:flex;flex-direction:column;justify-content:center;padding:48px 5vw 48px 6vw;}
  .bph-eyebrow{font-size:11px;letter-spacing:2.5px;text-transform:uppercase;color:#C38239;font-weight:700;display:block;margin-bottom:14px;}
  .bph-heading{font-family:'Bebas Neue',sans-serif;font-size:clamp(24px,2.8vw,34px);line-height:1.12;margin:0;}
  .bph-line-dark{display:block;color:#2B2420;}
  .bph-line-accent{display:block;color:#C38239;}
  .bph-rule{display:block;width:44px;height:2px;background:#2B2420;margin:20px 0;}
  .bph-text{font-size:13.5px;line-height:1.75;color:#5A4E3F;max-width:360px;margin:0;}
  .bph-right{overflow:hidden;min-height:440px;}
  .bph-right img{width:100%;height:100%;object-fit:cover;display:block;}

  @media(max-width:900px){
    .bph-wrap{grid-template-columns:1fr;min-height:0;}
    .bph-left{padding:40px 24px;}
    .bph-heading{font-size:22px;}
    .bph-right{min-height:280px;}
    .bph-right img{min-height:280px;}
  }
</style>

{% schema %}
{
  "name": "Brand Promise — Hero",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Our Brand Promise"},
    {"type":"text","id":"heading_dark","label":"Heading line 1 (dark)","default":"More than what we make."},
    {"type":"text","id":"heading_accent","label":"Heading line 2 (accent color)","default":"It's how we make you feel."},
    {"type":"textarea","id":"text","label":"Body text","default":"At Jack Studio, our promise goes beyond the products we create. It is about making every experience more trustworthy, relevant and personal — from the materials we choose to the service we provide."},
    {"type":"image_picker","id":"image","label":"Right-side image"}
  ]
}
{% endschema %}