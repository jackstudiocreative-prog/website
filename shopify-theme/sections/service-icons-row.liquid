<section class="si-wrap{% if section.settings.size == 'large' %} si-large{% elsif section.settings.size == 'medium' %} si-medium{% endif %}">
  {% if section.settings.heading != blank %}<h2 class="si-heading">{{ section.settings.heading }}</h2>{% endif %}
  <div class="si-grid">
    {% for block in section.blocks %}
      <div class="si-item" {{ block.shopify_attributes }}>
        <div class="si-icon">
          {%- case block.settings.icon -%}
          {%- when 'personalisation' -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M8 26h16M12 22l2-14h4l2 14"/></svg>
          {%- when 'gift' -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="5" y="12" width="22" height="14" rx="1"/><path d="M5 17h22M16 12v14M12 12c-2 0-3-1-3-3s1-3 3-3c1.5 0 3 2 4 3-1 0-3.5 3-4 3zM20 12c2 0 3-1 3-3s-1-3-3-3c-1.5 0-3 2-4 3 1 0 3.5 3 4 3z"/></svg>
          {%- when 'care' -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M13 4h6v6h-6zM10 10h12v18a2 2 0 0 1-2 2h-8a2 2 0 0 1-2-2z"/><path d="M14 18h4M14 22h4"/></svg>
          {%- when 'warranty' -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 4l10 4v8c0 6-4 11-10 12-6-1-10-6-10-12V8z"/><path d="M11 16l3 3 6-6"/></svg>
          {%- when 'shield' -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 4l10 4v8c0 6-4 11-10 12-6-1-10-6-10-12V8z"/></svg>
          {%- when 'delivery' -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="11" width="17" height="12" rx="1"/><path d="M20 15h6l3 4v4h-9z"/><circle cx="9" cy="27" r="2.2"/><circle cx="24" cy="27" r="2.2"/></svg>
          {%- when 'heart' -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M16 27s-11-7-11-15a6 6 0 0 1 11-4 6 6 0 0 1 11 4c0 8-11 15-11 15z"/></svg>
          {%- when 'person' -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="16" cy="11" r="5"/><path d="M5 28c0-6 5-10 11-10s11 4 11 10"/></svg>
          {%- when 'handshake' -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 16l6-6 6 6 2-2 4 4-6 6-4-4-8-4z"/><path d="M28 16l-6-6-2 2"/></svg>
          {%- when 'headset' -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 18v-2a10 10 0 0 1 20 0v2"/><rect x="4" y="17" width="6" height="9" rx="2"/><rect x="22" y="17" width="6" height="9" rx="2"/><path d="M28 26a4 4 0 0 1-4 4h-3"/></svg>
          {%- when 'target' -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="16" cy="16" r="11"/><circle cx="16" cy="16" r="6.5"/><circle cx="16" cy="16" r="2" fill="currentColor" stroke="none"/></svg>
          {%- when 'group' -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="11" r="4"/><circle cx="22" cy="12.5" r="3.3"/><path d="M4 27c0-4.6 3.6-8 8-8s8 3.4 8 8"/><path d="M20 19.3c3.6 0 6.5 2.7 6.5 7.7"/></svg>
          {%- else -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="16" cy="16" r="12"/></svg>
          {%- endcase -%}
        </div>
        <div class="si-body">
          <div class="si-title">{{ block.settings.title }}</div>
          {% if block.settings.subtitle != blank %}<div class="si-sub">{{ block.settings.subtitle }}</div>{% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>
<style>
  .si-wrap{background:{{ section.settings.bg_color }};padding:36px 32px;border-top:1px solid rgba(41,39,36,.06);}
  .si-heading{font-family:'Bebas Neue',sans-serif;font-size:18px;letter-spacing:1.5px;color:#292724;text-align:center;margin:0 0 28px;}
  .si-grid{display:flex;flex-wrap:wrap;justify-content:center;gap:24px 28px;max-width:1200px;margin:0 auto;}
  .si-item{display:flex;align-items:flex-start;gap:11px;flex:0 1 220px;}
  .si-icon{width:34px;height:34px;color:#292724;flex-shrink:0;}
  .si-icon svg{width:100%;height:100%;}
  .si-title{font-family:'Bebas Neue',sans-serif;font-size:17px;letter-spacing:1.2px;color:#292724;margin-bottom:4px;}
  .si-sub{font-size:12px;color:#716B63;line-height:1.4;}

  .si-large{padding:52px 32px;}
  .si-large .si-grid{gap:32px 56px;}
  .si-large .si-item{flex:0 1 300px;gap:18px;}
  .si-large .si-icon{width:48px;height:48px;}
  .si-large .si-title{font-size:26px;letter-spacing:1.4px;margin-bottom:7px;}
  .si-large .si-sub{font-size:15px;line-height:1.5;}

  .si-medium{padding:44px 32px;}
  .si-medium .si-grid{gap:24px 32px;}
  .si-medium .si-item{flex:0 1 260px;gap:14px;}
  .si-medium .si-icon{width:38px;height:38px;}
  .si-medium .si-title{font-size:20px;letter-spacing:1.3px;margin-bottom:5px;}
  .si-medium .si-sub{font-size:13px;line-height:1.45;}

  @media(max-width:900px){.si-grid{gap:22px 20px;}.si-item{flex:0 1 200px;}.si-large .si-item{flex:0 1 260px;}.si-medium .si-item{flex:0 1 220px;}}
  @media(max-width:600px){.si-heading{font-size:16px;}.si-grid{flex-direction:column;align-items:center;gap:26px;}.si-item{width:100%;max-width:300px;flex:none;}.si-large .si-item{max-width:340px;}.si-medium .si-item{max-width:320px;}
    .si-large .si-grid,.si-medium .si-grid{flex-direction:row;flex-wrap:nowrap;align-items:flex-start;justify-content:space-between;gap:8px;}
    .si-large .si-item,.si-medium .si-item{flex:1 1 0;width:auto;max-width:none;flex-direction:column;align-items:center;text-align:center;gap:8px;}
    .si-large .si-icon,.si-medium .si-icon{width:28px;height:28px;}
    .si-large .si-title,.si-medium .si-title{font-size:11.5px;letter-spacing:.3px;margin-bottom:3px;}
    .si-large .si-sub,.si-medium .si-sub{font-size:9.5px;line-height:1.25;}
  }
</style>
{% schema %}
{"name":"Service Icons","tag":"section","settings":[
{"type":"text","id":"heading","label":"Heading (optional)"},
{"type":"color","id":"bg_color","label":"Background","default":"#F5F1E8"},
{"type":"select","id":"size","label":"Text size","info":"Compact 适合 4 个 item 一行；Medium 也能安全装下 4 个（字号比 Compact 大）；Large 字号最大，适合 2-3 个 item，4 个用 Large 桌面端会挤成两行。","default":"normal","options":[{"value":"normal","label":"Compact"},{"value":"medium","label":"Medium (适合 4 个 item 一行，比 Compact 大)"},{"value":"large","label":"Large (适合 2-3 个 item)"}]}],
"blocks":[{"type":"item","name":"Item","settings":[
{"type":"select","id":"icon","label":"Icon","default":"personalisation","options":[{"value":"personalisation","label":"Personalisation (A)"},{"value":"gift","label":"Gift"},{"value":"care","label":"Care"},{"value":"warranty","label":"Warranty"},{"value":"shield","label":"Shield (Trust)"},{"value":"delivery","label":"Delivery Truck"},{"value":"heart","label":"Heart"},{"value":"person","label":"Person"},{"value":"handshake","label":"Handshake"},{"value":"headset","label":"Headset"},{"value":"target","label":"Target (Relevant)"},{"value":"group","label":"Group (People)"}]},
{"type":"text","id":"title","label":"Title","default":"SERVICE"},
{"type":"textarea","id":"subtitle","label":"Subtitle","default":"Short description."}]}],
"max_blocks":6,
"presets":[{"name":"Service Icons","blocks":[
{"type":"item","settings":{"icon":"personalisation","title":"PERSONALISATION","subtitle":"Make it uniquely yours."}},
{"type":"item","settings":{"icon":"gift","title":"GIFT PACKAGING","subtitle":"Beautifully packed, ready to give."}},
{"type":"item","settings":{"icon":"care","title":"LEATHER CARE","subtitle":"Products care and support."}},
{"type":"item","settings":{"icon":"warranty","title":"WARRANTY & REPAIR","subtitle":"We’ve got you covered."}}
]}]}
{% endschema %}