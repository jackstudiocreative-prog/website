<section class="corp-hero" {{ section.shopify_attributes }}><div class="corp-copy"><div class="eyebrow">{{ section.settings.eyebrow }}</div><h1 class="hero-headline">{{ section.settings.heading }}</h1><p class="hero-tagline">{{ section.settings.tagline }}</p><p class="hero-body">{{ section.settings.body }}</p><div class="hero-buttons"><a class="btn primary" href="{{ section.settings.quote_link }}">{{ section.settings.quote_label }}</a><a class="btn" href="{{ section.settings.contact_link }}">{{ section.settings.contact_label }}</a></div></div><div class="corp-visual"><span class="hero-tag">{{ section.settings.tag }}</span><div class="hero-mark"><span class="num">{{ section.settings.number }}</span><div class="kicker">{{ section.settings.mark }}</div><span class="sub">{{ section.settings.categories }}</span></div></div></section>
{% schema %}
{"name":"CORPORATE — Hero","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"Corporate Solutions"},{"type":"text","id":"heading","label":"Heading","default":"Corporate Solutions."},{"type":"text","id":"tagline","label":"Tagline","default":"Premium leather goods for every corporate occasion."},{"type":"textarea","id":"body","label":"Body","default":"Strengthen relationships with thoughtful gifts designed for employees, clients, events and corporate milestones — crafted in Malaysia since 2013."},{"type":"text","id":"quote_label","label":"Quote button","default":"Get a Quote"},{"type":"url","id":"quote_link","label":"Quote link"},{"type":"text","id":"contact_label","label":"Contact button","default":"Contact Us"},{"type":"url","id":"contact_link","label":"Contact link"},{"type":"text","id":"tag","label":"Hero tag","default":"Est. 2013 · Malaysia"},{"type":"text","id":"number","label":"Hero number","default":"N° 01 / CORPORATE"},{"type":"text","id":"mark","label":"Hero mark","default":"Crafted for Business."},{"type":"text","id":"categories","label":"Hero categories","default":"Wallets · Bags · Belts · Gift Sets"}]}
{% endschema %}