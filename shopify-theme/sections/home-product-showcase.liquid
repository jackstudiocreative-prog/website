<section class="section" {{ section.shopify_attributes }}><div class="section-head"><div><div class="eyebrow">{{ section.settings.eyebrow }}</div><h2 class="section-title">{{ section.settings.heading }}</h2></div><a class="btn btn-outline" href="{{ section.settings.link }}">{{ section.settings.button }}</a></div><div class="shelf-scroll">{% if section.settings.collection != blank %}{% for product in section.settings.collection.products limit:5 %}<a class="shelf-item" href="{{ product.url }}"><div class="simg" style="background-image:url('{{ product.featured_image | image_url: width:700 }}')"></div><div class="sname">{{ product.title }}</div></a>{% endfor %}{% else %}{% for block in section.blocks %}<a class="shelf-item" href="{{ block.settings.link }}" {{ block.shopify_attributes }}><div class="simg" style="{% if block.settings.image != blank %}background-image:url('{{ block.settings.image | image_url: width:700 }}');{% endif %}"></div><div class="sname">{{ block.settings.title }}</div></a>{% endfor %}{% endif %}</div></section>
{% schema %}
{"name":"HOME — Best Sellers","max_blocks":8,"settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"05 / BEST SELLERS"},{"type":"text","id":"heading","label":"Heading","default":"Best Sellers"},{"type":"text","id":"button","label":"Button","default":"SHOP ALL"},{"type":"url","id":"link","label":"Button link"},{"type":"collection","id":"collection","label":"Shopify collection"}],"blocks":[{"type":"product","name":"Manual product","settings":[{"type":"image_picker","id":"image","label":"Image"},{"type":"text","id":"title","label":"Title","default":"Classic Wallet"},{"type":"url","id":"link","label":"Link"}]}],"presets":[{"name":"HOME — Best Sellers","blocks":[{"type":"product"},{"type":"product"},{"type":"product"},{"type":"product"},{"type":"product"}]}]}
{% endschema %}