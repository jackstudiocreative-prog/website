<div class="ct-wrap">
  <h1 class="ct-title">Shopping Cart</h1>

  <div id="ct-empty" class="ct-empty" style="display:none;">
    <p>Your cart is empty.</p>
    <a href="/" class="ct-empty-link">Continue Shopping &rarr;</a>
  </div>

  <div id="ct-body" class="ct-body">
    <div class="ct-items" id="ct-items"></div>

    <div class="ct-summary">
      <div class="ct-row">
        <span>Subtotal</span>
        <span id="ct-subtotal">RM 0.00</span>
      </div>
      <p class="ct-note">Shipping and taxes calculated at checkout.</p>
      <a href="/checkout" class="ct-checkout-btn">Checkout</a>
      <a href="/" class="ct-continue-link">Continue Shopping</a>
    </div>
  </div>
</div>

<style>
  .ct-wrap{max-width:1100px;margin:0 auto;padding:48px 24px 80px;color:#2B2420;}
  .ct-title{font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:1px;margin:0 0 32px;text-align:center;}
  .ct-empty{text-align:center;padding:60px 20px;color:#7A7263;font-size:14px;}
  .ct-empty-link{display:inline-block;margin-top:16px;color:#2B2420;font-weight:600;text-decoration:underline;}
  .ct-body{display:grid;grid-template-columns:1fr 320px;gap:48px;align-items:start;}

  .ct-item{display:grid;grid-template-columns:88px 1fr auto;gap:16px;align-items:center;padding:18px 0;border-bottom:1px solid #E3DCC8;}
  .ct-item-img{width:88px;height:88px;border-radius:4px;overflow:hidden;background:#F9F4E3;}
  .ct-item-img img{width:100%;height:100%;object-fit:cover;display:block;}
  .ct-item-info h3{font-size:14px;font-weight:600;margin:0 0 6px;line-height:1.3;}
  .ct-item-variant{font-size:11px;color:#7A7263;margin-bottom:8px;}
  .ct-item-price{font-size:13px;color:#2B2420;font-weight:600;}
  .ct-item-right{text-align:right;display:flex;flex-direction:column;align-items:flex-end;gap:10px;}
  .ct-qty{display:flex;align-items:center;border:1px solid #D8CFB8;border-radius:4px;overflow:hidden;}
  .ct-qty-btn{width:28px;height:32px;background:#F9F4E3;border:0;cursor:pointer;font-size:14px;color:#2B2420;}
  .ct-qty-input{width:36px;height:32px;border:0;border-left:1px solid #D8CFB8;border-right:1px solid #D8CFB8;text-align:center;font-size:12px;-moz-appearance:textfield;}
  .ct-qty-input::-webkit-outer-spin-button,.ct-qty-input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0;}
  .ct-remove{background:none;border:0;color:#7A7263;font-size:11px;text-decoration:underline;cursor:pointer;padding:0;}

  .ct-summary{background:#F0EDE3;border-radius:8px;padding:24px;position:sticky;top:24px;}
  .ct-row{display:flex;justify-content:space-between;font-size:15px;font-weight:600;margin-bottom:8px;}
  .ct-note{font-size:11px;color:#7A7263;margin:0 0 20px;line-height:1.5;}
  .ct-checkout-btn{display:block;text-align:center;background:#C38239;color:#FFFFFF;padding:14px;border-radius:4px;font-size:13px;font-weight:600;letter-spacing:1px;text-transform:uppercase;text-decoration:none;margin-bottom:12px;}
  .ct-checkout-btn:hover{background:#A8702F;}
  .ct-continue-link{display:block;text-align:center;font-size:12px;color:#7A7263;text-decoration:underline;}

  @media(max-width:768px){
    .ct-body{grid-template-columns:1fr;}
    .ct-title{font-size:20px;}
    .ct-summary{position:static;}
    .ct-item{grid-template-columns:64px 1fr;}
    .ct-item-img{width:64px;height:64px;}
    .ct-item-right{grid-column:1/-1;flex-direction:row;justify-content:space-between;align-items:center;margin-top:10px;}
  }
</style>

<script>
(function(){
  function money(cents){ return 'RM ' + (cents/100).toFixed(2); }

  function render(cart){
    var itemsEl = document.getElementById('ct-items');
    var empty = document.getElementById('ct-empty');
    var body = document.getElementById('ct-body');

    if(cart.item_count === 0){
      body.style.display = 'none';
      empty.style.display = 'block';
      return;
    }
    empty.style.display = 'none';
    body.style.display = 'grid';

    itemsEl.innerHTML = '';
    cart.items.forEach(function(item){
      var div = document.createElement('div');
      div.className = 'ct-item';
      div.innerHTML =
        '<div class="ct-item-img">' + (item.image ? '<img src="' + item.image + '" alt="' + item.product_title + '">' : '') + '</div>' +
        '<div class="ct-item-info">' +
          '<h3><a href="' + item.url + '" style="color:inherit;text-decoration:none;">' + item.product_title + '</a></h3>' +
          (item.variant_title ? '<div class="ct-item-variant">' + item.variant_title + '</div>' : '') +
          '<div class="ct-item-price">' + money(item.final_price) + '</div>' +
        '</div>' +
        '<div class="ct-item-right">' +
          '<div class="ct-qty">' +
            '<button class="ct-qty-btn" data-qty-minus data-key="' + item.key + '" data-qty="' + item.quantity + '">−</button>' +
            '<input type="number" class="ct-qty-input" value="' + item.quantity + '" min="0" data-key="' + item.key + '" data-qty-input>' +
            '<button class="ct-qty-btn" data-qty-plus data-key="' + item.key + '" data-qty="' + item.quantity + '">+</button>' +
          '</div>' +
          '<button class="ct-remove" data-remove data-key="' + item.key + '">Remove</button>' +
        '</div>';
      itemsEl.appendChild(div);
    });

    document.getElementById('ct-subtotal').textContent = money(cart.total_price);

    itemsEl.querySelectorAll('[data-qty-minus]').forEach(function(btn){
      btn.addEventListener('click', function(){
        var q = parseInt(btn.getAttribute('data-qty'), 10);
        updateItem(btn.getAttribute('data-key'), Math.max(0, q - 1));
      });
    });
    itemsEl.querySelectorAll('[data-qty-plus]').forEach(function(btn){
      btn.addEventListener('click', function(){
        var q = parseInt(btn.getAttribute('data-qty'), 10);
        updateItem(btn.getAttribute('data-key'), q + 1);
      });
    });
    itemsEl.querySelectorAll('[data-qty-input]').forEach(function(input){
      input.addEventListener('change', function(){
        updateItem(input.getAttribute('data-key'), parseInt(input.value, 10) || 0);
      });
    });
    itemsEl.querySelectorAll('[data-remove]').forEach(function(btn){
      btn.addEventListener('click', function(){
        updateItem(btn.getAttribute('data-key'), 0);
      });
    });
  }

  function updateItem(key, qty){
    fetch('/cart/change.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ id: key, quantity: qty })
    })
    .then(function(r){ return r.json(); })
    .then(function(cart){
      render(cart);
      document.querySelectorAll('[data-cart-count]').forEach(function(el){ el.textContent = cart.item_count; el.style.display = cart.item_count > 0 ? '' : 'none'; });
    });
  }

  function load(){
    fetch('/cart.js').then(function(r){ return r.json(); }).then(render);
  }

  document.addEventListener('DOMContentLoaded', load);
})();
</script>
{% schema %}
{"name":"Cart page","settings":[]}
{% endschema %}
