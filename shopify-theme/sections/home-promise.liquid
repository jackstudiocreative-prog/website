<section class="promise-block" {{ section.shopify_attributes }}><h2>{{ section.settings.heading }}</h2><div class="promise-intro">{{ section.settings.intro }}</div><div class="promise-parts">
{% for block in section.blocks %}<div class="promise-part" {{ block.shopify_attributes }}><div class="pi-big">{{ block.settings.icon }}</div><h3>{{ block.settings.title }}</h3><p>{{ block.settings.text }}</p><div class="pillar-list">{{ block.settings.list }}</div></div>{% endfor %}
</div></section>
{% schema %}
{"name":"HOME — Brand Promise","max_blocks":6,"settings":[{"type":"text","id":"heading","label":"Heading","default":"OUR BRAND PROMISE"},{"type":"textarea","id":"intro","label":"Intro","default":"Creating better choices, meaningful experiences and relationships that last."}],"blocks":[{"type":"pillar","name":"Promise pillar","settings":[{"type":"text","id":"icon","label":"Icon / SVG placeholder","default":"✦"},{"type":"text","id":"title","label":"Title","default":"More Trust"},{"type":"textarea","id":"text","label":"Text","default":"Confidence in every choice. Care beyond every purchase."},{"type":"textarea","id":"list","label":"Pillar list","default":"Reliable Quality\nLifetime Care\nWarranty\nRepair Service"}]}],"presets":[{"name":"HOME — Brand Promise","blocks":[{"type":"pillar","settings":{"title":"More Trust"}},{"type":"pillar","settings":{"title":"More Relevant"}},{"type":"pillar","settings":{"title":"More Personal"}},{"type":"pillar","settings":{"title":"More Service"}}]}]}
{% endschema %}