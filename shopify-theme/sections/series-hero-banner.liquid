<section class="shb-wrap">
  <div class="shb-media">
    {% if section.settings.image %}{{ section.settings.image | image_url: width: 2000 | image_tag: loading: 'eager', alt: section.settings.heading }}{% endif %}
    <div class="shb-overlay"></div>
  </div>
  <div class="shb-content">
    {% if section.settings.eyebrow != blank %}<span class="shb-eyebrow">{{ section.settings.eyebrow }}</span>{% endif %}
    <h1 class="shb-heading">{{ section.settings.heading }}</h1>
    {% if section.settings.description != blank %}<p class="shb-desc">{{ section.settings.description }}</p>{% endif %}
  </div>
</section>

<style>
  .shb-wrap{position:relative;min-height:440px;display:flex;align-items:flex-end;overflow:hidden;background:#2B2420;}
  .shb-media{position:absolute;inset:0;}
  .shb-media img{width:100%;height:100%;object-fit:cover;display:block;}
  .shb-overlay{position:absolute;inset:0;background:linear-gradient(0deg,rgba(30,22,14,.78) 0%,rgba(30,22,14,.35) 45%,rgba(30,22,14,.05) 75%);}
  .shb-content{position:relative;z-index:1;padding:48px 6vw 44px;max-width:640px;color:#F8F4EA;}
  .shb-eyebrow{display:block;font-size:11px;letter-spacing:2.5px;text-transform:uppercase;color:#E8C9A0;font-weight:700;margin-bottom:14px;}
  .shb-heading{font-family:'Bebas Neue',sans-serif;font-size:clamp(32px,4.5vw,54px);letter-spacing:1px;line-height:1;margin:0 0 14px;color:#F8F4EA;}
  .shb-desc{font-size:14px;line-height:1.7;color:#E8E2D2;margin:0;max-width:480px;}

  @media(max-width:640px){
    .shb-wrap{min-height:340px;}
    .shb-content{padding:32px 22px 30px;}
    .shb-heading{font-size:28px;}
  }
</style>

{% schema %}
{
  "name": "Series — Hero Banner",
  "settings": [
    {"type":"image_picker","id":"image","label":"Banner image"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Lifestyle Movement"},
    {"type":"text","id":"heading","label":"Heading","default":"Urban Carry"},
    {"type":"textarea","id":"description","label":"Description","default":"Carry smart. Move freely."}
  ],
  "presets": [{"name":"Series — Hero Banner"}]
}
{% endschema %}