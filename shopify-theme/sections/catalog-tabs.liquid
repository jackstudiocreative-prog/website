<section class="ctab-wrap" style="background:{{ section.settings.bg_color }};">
  {% if section.settings.heading != blank %}<h2 class="ctab-heading">{{ section.settings.heading }}</h2>{% endif %}

  <div class="ctab-tabs" data-ctab-tabs>
    {% for block in section.blocks %}
      <button type="button" class="ctab-tab{% if forloop.first %} is-active{% endif %}" data-ctab-tab data-ctab-target="{{ forloop.index0 }}" style="--ctab-accent:{{ section.settings.accent_color }};">{{ block.settings.label }}</button>
    {% endfor %}
  </div>

  <div class="ctab-panels">
    {% for block in section.blocks %}
      {% assign tab_collection = block.settings.collection %}
      <div class="ctab-panel{% if forloop.first %} is-active{% endif %}" data-ctab-panel="{{ forloop.index0 }}">
        <div class="ctab-carousel">
          {% if tab_collection and tab_collection.products.size > 3 %}
            <button type="button" class="ctab-arrow ctab-arrow-prev" data-ctab-prev aria-label="Previous">&larr;</button>
            <button type="button" class="ctab-arrow ctab-arrow-next" data-ctab-next aria-label="Next">&rarr;</button>
          {% endif %}
          <div class="ctab-rail" data-ctab-rail>
            {% if tab_collection %}
              {% for product in tab_collection.products limit: 12 %}
                <a class="ctab-card" href="{{ product.url }}">
                  <div class="ctab-card-img" style="background:{{ section.settings.image_bg_color }};">
                    {% if product.featured_image %}{{ product.featured_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: product.title }}{% endif %}
                  </div>
                  <div class="ctab-card-body">
                    <div class="ctab-card-title">{{ product.title }}</div>
                    <div class="ctab-card-price">{{ product.price | money }}</div>
                    {% assign color_values = nil %}
                    {% for option in product.options_with_values %}
                      {% assign opt_lc = option.name | downcase %}
                      {% if opt_lc contains 'color' or opt_lc contains 'colour' %}{% assign color_values = option.values %}{% endif %}
                    {% endfor %}
                    {% if color_values %}
                      <div class="ctab-swatches">
                        {% for v in color_values limit: 8 %}<span class="ctab-dot" style="background-color:{{ v | strip | downcase }};" title="{{ v }}"></span>{% endfor %}
                      </div>
                    {% endif %}
                    {% if product.description != blank %}<p class="ctab-card-sub">{{ product.description | strip_html | truncate: 70 }}</p>{% endif %}
                  </div>
                </a>
              {% else %}
                <p class="ctab-empty">No products in this collection yet.</p>
              {% endfor %}
            {% else %}
              <p class="ctab-empty">Select a collection for this tab in the theme editor.</p>
            {% endif %}
          </div>
        </div>
        <div class="ctab-panel-bottom">
          {% if tab_collection %}<a class="ctab-shopall" href="{{ tab_collection.url }}">Shop All {{ block.settings.label }} &rarr;</a>{% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<style>
  .ctab-wrap{padding:48px 0 56px;max-width:100vw;overflow:hidden;}
  .ctab-heading{font-family:'Bebas Neue',sans-serif;font-size:clamp(22px,2.6vw,30px);letter-spacing:1.5px;color:#292724;text-align:center;margin:0 0 26px;}

  .ctab-tabs{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 28px;max-width:1300px;margin:0 auto;padding:0 24px 22px;border-bottom:1px solid rgba(41,39,36,.1);}
  .ctab-tab{background:none;border:0;padding:8px 2px;font-family:'Inter',sans-serif;font-size:14px;color:#716B63;cursor:pointer;position:relative;white-space:nowrap;}
  .ctab-tab::after{content:'';position:absolute;left:0;right:0;bottom:-23px;height:2px;background:transparent;transition:background .2s;}
  .ctab-tab.is-active{color:#292724;font-weight:600;}
  .ctab-tab.is-active::after{background:var(--ctab-accent,#C4823A);}
  .ctab-tab:hover{color:#292724;}

  .ctab-panels{max-width:1300px;margin:0 auto;padding:0 24px;}
  .ctab-panel{display:none;}
  .ctab-panel.is-active{display:block;}

  .ctab-panel-bottom{display:flex;justify-content:center;margin-top:30px;}
  .ctab-shopall{font-family:'Inter',sans-serif;font-size:13px;font-weight:600;letter-spacing:.3px;color:#292724;text-decoration:underline;text-underline-offset:3px;}
  .ctab-shopall:hover{color:{{ section.settings.accent_color }};}

  .ctab-carousel{position:relative;padding-top:30px;}
  .ctab-rail{display:flex;gap:24px;overflow-x:scroll;overflow-y:hidden;scroll-snap-type:x proximity;-webkit-overflow-scrolling:touch;overscroll-behavior-x:contain;touch-action:pan-x;scrollbar-width:none;padding-bottom:4px;}
  .ctab-rail::-webkit-scrollbar{display:none;}

  .ctab-card{flex:0 0 calc(33.333% - 16px);min-width:230px;display:block;text-decoration:none;color:inherit;scroll-snap-align:start;}
  .ctab-card-img{aspect-ratio:1/1;border-radius:4px;overflow:hidden;display:flex;align-items:center;justify-content:center;}
  .ctab-card-img img{width:100%;height:100%;object-fit:contain;display:block;transition:transform .5s ease;}
  .ctab-card:hover .ctab-card-img img{transform:scale(1.04);}
  .ctab-card-body{padding:14px 2px 0;}
  .ctab-card-title{font-family:'Inter',sans-serif;font-size:13.5px;font-weight:600;color:#292724;margin-bottom:4px;}
  .ctab-card-price{font-family:'Inter',sans-serif;font-size:13px;color:#292724;margin-bottom:8px;}
  .ctab-swatches{display:flex;gap:6px;margin-bottom:8px;flex-wrap:wrap;}
  .ctab-dot{width:14px;height:14px;border-radius:50%;display:inline-block;border:1px solid rgba(41,39,36,.15);}
  .ctab-card-sub{font-family:'Inter',sans-serif;font-size:12px;color:#8A8069;line-height:1.5;margin:0;}
  .ctab-empty{font-size:13px;color:#8A8069;padding:30px 0;}

  .ctab-arrow{position:absolute;top:calc(50% - 4px);width:38px;height:38px;border-radius:50%;border:1px solid rgba(41,39,36,.18);background:#fff;color:#292724;font-size:15px;display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:2;transition:background .2s;}
  .ctab-arrow:hover{background:#F5F1E8;}
  .ctab-arrow-prev{left:-14px;}
  .ctab-arrow-next{right:-14px;}

  @media(max-width:900px){
    .ctab-tabs{gap:6px 18px;justify-content:flex-start;overflow-x:auto;flex-wrap:nowrap;-webkit-overflow-scrolling:touch;scrollbar-width:none;padding-left:16px;padding-right:16px;}
    .ctab-tabs::-webkit-scrollbar{display:none;}
    .ctab-tab{font-size:12.5px;flex-shrink:0;}
    .ctab-panels{padding:0 16px;}
    .ctab-panel-bottom{margin-top:22px;}
    .ctab-shopall{font-size:12px;}
    .ctab-card{flex:0 0 68vw;min-width:0;}
    .ctab-arrow{display:none;}
  }
</style>

{% javascript %}
  document.querySelectorAll('[data-ctab-tabs]').forEach(function(tabsWrap){
    var wrap = tabsWrap.closest('.ctab-wrap');
    if (!wrap) return;
    var tabs = Array.prototype.slice.call(tabsWrap.querySelectorAll('[data-ctab-tab]'));
    var panels = Array.prototype.slice.call(wrap.querySelectorAll('[data-ctab-panel]'));

    tabs.forEach(function(tab){
      tab.addEventListener('click', function(){
        var target = tab.getAttribute('data-ctab-target');
        tabs.forEach(function(t){ t.classList.toggle('is-active', t === tab); });
        panels.forEach(function(p){ p.classList.toggle('is-active', p.getAttribute('data-ctab-panel') === target); });
      });
    });

    panels.forEach(function(panel){
      var rail = panel.querySelector('[data-ctab-rail]');
      var prevBtn = panel.querySelector('[data-ctab-prev]');
      var nextBtn = panel.querySelector('[data-ctab-next]');
      if (!rail) return;
      function step(dir){
        var card = rail.querySelector('.ctab-card');
        var w = card ? card.getBoundingClientRect().width + 24 : 300;
        rail.scrollBy({ left: dir * w, behavior: 'smooth' });
      }
      if (prevBtn) prevBtn.addEventListener('click', function(){ step(-1); });
      if (nextBtn) nextBtn.addEventListener('click', function(){ step(1); });

      var isDown = false, startX = 0, startScroll = 0, moved = false;
      function pointerX(e){ return (e.touches && e.touches[0]) ? e.touches[0].clientX : e.clientX; }
      function dragStart(e){ isDown = true; moved = false; startX = pointerX(e); startScroll = rail.scrollLeft; }
      function dragMove(e){ if(!isDown) return; var x = pointerX(e); var delta = startX - x; if (Math.abs(delta) > 4) moved = true; rail.scrollLeft = startScroll + delta; }
      function dragEnd(){ isDown = false; }
      rail.addEventListener('touchstart', dragStart, { passive: true });
      rail.addEventListener('touchmove', dragMove, { passive: true });
      rail.addEventListener('touchend', dragEnd);
      rail.addEventListener('mousedown', dragStart);
      window.addEventListener('mousemove', dragMove);
      window.addEventListener('mouseup', dragEnd);
      rail.querySelectorAll('.ctab-card').forEach(function(card){
        card.addEventListener('click', function(e){ if (moved) e.preventDefault(); });
      });
    });
  });
{% endjavascript %}

{% schema %}
{
  "name": "Catalog Tabs",
  "settings": [
    {"type":"text","id":"heading","label":"Heading (optional)"},
    {"type":"color","id":"bg_color","label":"Background","default":"#F5F1E8"},
    {"type":"color","id":"image_bg_color","label":"Product image background","default":"#FFFFFF"},
    {"type":"color","id":"accent_color","label":"Active tab accent color","default":"#C4823A"}
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "Category Tab",
      "settings": [
        {"type":"text","id":"label","label":"Tab label","default":"Category"},
        {"type":"collection","id":"collection","label":"Collection"}
      ]
    }
  ],
  "max_blocks": 8
}
{% endschema %}