{%- assign wa_number = section.settings.whatsapp_number | remove: ' ' | remove: '-' | remove: '+' -%}
<section class="sva" style="--sva-bg:{{ section.settings.bg_color }};" {{ section.shopify_attributes }}>
  <div class="sva-media">
    {%- if section.settings.image -%}
      {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'lazy', widths: '600,900,1200,1500,1800', sizes: '(max-width: 900px) 100vw, 70vw', alt: section.settings.image.alt }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag: 'sva-ph' }}
    {%- endif -%}
  </div>
  <div class="sva-inner">
    {%- if section.settings.eyebrow != blank -%}<p class="sva-eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h2 class="sva-heading">{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<p class="sva-text">{{ section.settings.text | newline_to_br }}</p>{%- endif -%}
    <div class="sva-actions">
      {%- if section.settings.button_label != blank -%}
        <a class="sva-btn sva-btn--fill" href="{{ section.settings.button_link | default: '/pages/contact' }}">
          {{ section.settings.button_label }}
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15M14 7l5 5-5 5"/></svg>
        </a>
      {%- endif -%}
      {%- if wa_number != blank and section.settings.whatsapp_label != blank -%}
        <a class="sva-btn sva-btn--line" href="https://wa.me/{{ wa_number }}{% if section.settings.whatsapp_message != blank %}?text={{ section.settings.whatsapp_message | url_encode }}{% endif %}" target="_blank" rel="noopener">
          <svg class="sva-wa" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3.2a8.8 8.8 0 0 0-7.6 13.2L3.2 20.8l4.5-1.2A8.8 8.8 0 1 0 12 3.2z"/><path d="M9 8.3c.2-.4.5-.4.8-.4.5 0 .6.6.8 1.1.2.5.3.7 0 1.1l-.4.5c.6 1.2 1.6 2.2 2.8 2.8l.5-.5c.3-.3.6-.2 1 0 .6.3 1.2.4 1.2.9 0 .7-.6 1.4-1.4 1.4-2.9 0-6-3.1-6-6 0-.4.3-.7.7-.9z"/></svg>
          {{ section.settings.whatsapp_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  .sva{position:relative;display:flex;align-items:center;min-height:clamp(300px,22vw,340px);background:var(--sva-bg);overflow:hidden;}
  .sva-media{position:absolute;top:0;right:0;bottom:0;width:72%;}
  .sva-media img,.sva-media .sva-ph{width:100%;height:100%;object-fit:cover;display:block;}
  .sva-media .sva-ph{background:#E9E0CF;}
  .sva-media::after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,var(--sva-bg) 0%,var(--sva-bg) 8%,transparent 55%);pointer-events:none;}
  .sva-inner{position:relative;z-index:1;width:100%;max-width:1440px;margin:0 auto;padding:36px clamp(20px,6vw,88px);}
  .sva-inner>*{max-width:360px;}
  .sva-eyebrow{display:flex;align-items:center;gap:14px;margin:0 0 12px;font-family:'Inter',sans-serif;font-size:10px;font-weight:500;letter-spacing:.3em;text-transform:uppercase;color:#401410;}
  .sva-eyebrow::after{content:"";width:36px;height:1px;background:currentColor;opacity:.6;}
  .sva-heading{margin:0 0 12px;font-family:'Bebas Neue',sans-serif;font-weight:400;font-size:clamp(36px,3.6vw,48px);line-height:1;color:#401410;}
  .sva-text{margin:0 0 20px;font-family:'Inter',sans-serif;font-size:14px;line-height:1.65;color:#3B2A22;}
  .sva-actions{display:flex;flex-wrap:wrap;gap:14px;max-width:none;}
  .sva-btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;min-width:140px;height:40px;padding:0 24px;font-family:'Inter',sans-serif;font-size:13px;font-weight:500;letter-spacing:.02em;text-decoration:none;transition:background .25s,color .25s,border-color .25s;}
  .sva-btn svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;}
  .sva-btn--fill{background:#B87635;border:1px solid #B87635;color:#FBF8F0;}
  .sva-btn--fill:hover{background:#9E622A;border-color:#9E622A;}
  .sva-btn--line{background:rgba(251,248,240,.6);border:1px solid #401410;color:#401410;}
  .sva-btn--line:hover{background:#401410;color:#FBF8F0;}
  .sva-btn:focus-visible{outline:2px solid #C38239;outline-offset:3px;}

  @media(max-width:900px){
    .sva{flex-direction:column-reverse;align-items:stretch;min-height:0;}
    .sva-media{position:relative;width:100%;height:clamp(220px,60vw,340px);}
    .sva-media::after{background:linear-gradient(180deg,var(--sva-bg) 0%,transparent 40%);}
    .sva-inner{padding:40px 20px 8px;}
  }
</style>

{% schema %}
{
  "name": "Service — Assistance",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background","default":"#EFE6D6"},
    {"type":"image_picker","id":"image","label":"Background image"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Always Here For You"},
    {"type":"text","id":"heading","label":"Heading","default":"Need Assistance?"},
    {"type":"textarea","id":"text","label":"Text","default":"Our team is always ready to help you with product care, repairs, or any questions about your Jack Studio pieces."},
    {"type":"header","content":"Primary button"},
    {"type":"text","id":"button_label","label":"Label","default":"Contact Us"},
    {"type":"url","id":"button_link","label":"Link"},
    {"type":"header","content":"WhatsApp button"},
    {"type":"text","id":"whatsapp_label","label":"Label","default":"WhatsApp Us"},
    {"type":"text","id":"whatsapp_number","label":"Number (with country code)","default":"601112015288"},
    {"type":"text","id":"whatsapp_message","label":"Pre-filled message","default":"Hi Jack Studio, I'd like to ask about your service."}
  ],
  "presets": [{"name":"Service — Assistance"}]
}
{% endschema %}
