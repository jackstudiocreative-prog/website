<section class="cgl-wrap" {{ section.shopify_attributes }}>
  <h2 class="cgl-heading">{{ section.settings.heading }}</h2>
  <div class="cgl-grid">
    {% for block in section.blocks %}
      <div class="cgl-tile" {{ block.shopify_attributes }}>
        {% if block.settings.image %}{{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy' }}{% endif %}
        <div class="cgl-overlay"></div>
        <div class="cgl-cap">
          <strong>{{ block.settings.title }}</strong>
          <span>{{ block.settings.desc }}</span>
        </div>
      </div>
    {% endfor %}
  </div>
</section>

<style>
  .cgl-wrap{background:{{ section.settings.bg_color }};padding:52px 6vw;text-align:center;}
  .cgl-heading{font-family:'Bebas Neue',sans-serif;font-size:clamp(24px,2.8vw,30px);letter-spacing:1.5px;color:#2B2420;margin:0 0 36px;}
  .cgl-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px;max-width:1200px;margin:0 auto;}
  .cgl-tile{position:relative;aspect-ratio:3/4;border-radius:8px;overflow:hidden;background:#E3DCC8;}
  .cgl-tile img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block;}
  .cgl-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(43,36,28,.75) 0%,rgba(43,36,28,.05) 55%);}
  .cgl-cap{position:absolute;left:14px;right:14px;bottom:14px;text-align:left;color:#fff;}
  .cgl-cap strong{display:block;font-size:13px;letter-spacing:1px;text-transform:uppercase;margin-bottom:4px;}
  .cgl-cap span{display:block;font-size:11.5px;line-height:1.4;opacity:.9;}

  @media(max-width:900px){
    .cgl-grid{grid-template-columns:repeat(2,1fr);}
    .cgl-heading{font-size:20px;}
  }
</style>

{% schema %}
{
  "name": "Corporate Gallery",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background","default":"#F4EFDC"},
    {"type":"text","id":"heading","label":"Heading","default":"Corporate Gifting That Leaves A Lasting Impression"}
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {"type":"image_picker","id":"image","label":"Image"},
        {"type":"text","id":"title","label":"Title","default":"Client Gifts"},
        {"type":"text","id":"desc","label":"Description","default":"Strengthen relationships with meaningful gifts."}
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Corporate Gallery",
      "blocks": [
        {"type":"tile","settings":{"title":"Client Gifts","desc":"Strengthen relationships with meaningful gifts."}},
        {"type":"tile","settings":{"title":"Employee Recognition","desc":"Appreciate your team with thoughtful tokens."}},
        {"type":"tile","settings":{"title":"Company Events","desc":"Perfect for conferences, seminars and launches."}},
        {"type":"tile","settings":{"title":"Festive Gifting","desc":"Celebrate every festive season with elegance."}}
      ]
    }
  ]
}
{% endschema %}