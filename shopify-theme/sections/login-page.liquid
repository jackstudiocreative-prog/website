<div class="lg-wrap">
  <div class="lg-visual">
    <div class="lg-visual-inner">
      <span class="lg-eyebrow">Welcome Back</span>
      <h1 class="lg-mark">Jack<br>Studio</h1>
      <p class="lg-tagline">Crafted for every journey, since 2013.</p>
    </div>
  </div>

  <div class="lg-form-side">
    <div class="lg-form-box">
      <h2 class="lg-title">Sign In</h2>
      <p class="lg-sub">Access your orders, wishlist and account details.</p>

      {% form 'customer_login' %}
        {% if form.errors %}
          <div class="lg-error">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}

        <div class="lg-field">
          <label for="customer_email">Email</label>
          <input type="email" name="customer[email]" id="customer_email" autocomplete="email" autocorrect="off" autocapitalize="off" required>
        </div>

        {% if form.password_needed %}
          <div class="lg-field">
            <div class="lg-field-row">
              <label for="customer_password">Password</label>
              <a href="#" id="lg-recover-link">Forgot password?</a>
            </div>
            <input type="password" name="customer[password]" id="customer_password" autocomplete="current-password" required>
          </div>
        {% endif %}

        <button type="submit" class="lg-submit">Sign In</button>
      {% endform %}

      <div class="lg-recover" id="lg-recover-box" style="display:none;">
        <h3>Reset your password</h3>
        <p>We'll send you an email to reset your password.</p>
        {% form 'recover_customer_password' %}
          {% if form.posted_successfully? %}
            <p class="lg-success">If that email exists, you'll receive a reset link shortly.</p>
          {% endif %}
          <div class="lg-field">
            <label for="recover_email">Email</label>
            <input type="email" name="email" id="recover_email" autocomplete="email" required>
          </div>
          <button type="submit" class="lg-submit">Send Reset Link</button>
        {% endform %}
        <button type="button" class="lg-back" id="lg-back-link">&larr; Back to Sign In</button>
      </div>

      <div class="lg-divider"><span>New here?</span></div>
      <a href="{{ routes.account_register_url }}" class="lg-create-btn">Create an Account</a>
    </div>
  </div>
</div>

<style>
  .lg-wrap{display:grid;grid-template-columns:1fr 1fr;min-height:calc(100vh - 200px);}
  .lg-visual{background:#2B2420;display:flex;align-items:center;justify-content:center;padding:60px;position:relative;overflow:hidden;}
  .lg-visual::before{content:'';position:absolute;inset:0;background:radial-gradient(60% 50% at 20% 20%,rgba(196,130,58,.25),transparent 60%),radial-gradient(50% 50% at 85% 80%,rgba(43,36,32,.35),transparent 60%);}
  .lg-visual-inner{position:relative;z-index:1;color:#FFFFFF;text-align:left;max-width:380px;}
  .lg-eyebrow{font-size:11px;letter-spacing:3px;text-transform:uppercase;color:#F4EFDC;font-weight:600;display:block;margin-bottom:20px;}
  .lg-mark{font-family:'Bebas Neue',sans-serif;font-size:clamp(44px,5.5vw,68px);line-height:.92;letter-spacing:1px;margin:0 0 20px;}
  .lg-tagline{font-family:Georgia,serif;font-style:italic;font-size:16px;line-height:1.5;opacity:.9;margin:0;}

  .lg-form-side{display:flex;align-items:center;justify-content:center;padding:60px 40px;background:#FFFFFF;}
  .lg-form-box{width:100%;max-width:380px;}
  .lg-title{font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:1px;margin:0 0 8px;color:#2B2420;}
  .lg-sub{font-size:13px;color:#7A7263;margin:0 0 32px;line-height:1.5;}

  .lg-error{background:#F4E2E0;color:#8A3B32;font-size:13px;padding:12px 16px;border-radius:4px;margin-bottom:20px;}
  .lg-error ul{margin:0;padding-left:18px;}

  .lg-field{margin-bottom:18px;}
  .lg-field label{display:block;font-size:11px;letter-spacing:1px;text-transform:uppercase;color:#7A7263;margin-bottom:6px;font-weight:600;}
  .lg-field-row{display:flex;justify-content:space-between;align-items:baseline;}
  .lg-field-row a{font-size:11px;color:#C4823A;text-decoration:underline;font-weight:600;text-transform:none;letter-spacing:0;}
  .lg-field input{width:100%;padding:12px 14px;border:1px solid #D8CFB8;border-radius:4px;font-size:14px;background:#F9F4E3;color:#2B2420;box-sizing:border-box;}
  .lg-field input:focus{outline:2px solid #8DA68A;outline-offset:1px;}

  .lg-submit{width:100%;background:#C38239;color:#FFFFFF;border:0;padding:14px;border-radius:4px;font-size:13px;font-weight:600;letter-spacing:1px;text-transform:uppercase;cursor:pointer;margin-top:6px;}
  .lg-submit:hover{background:#A8702F;}

  .lg-recover h3{font-family:'Bebas Neue',sans-serif;font-size:20px;margin:0 0 8px;color:#2B2420;}
  .lg-recover p{font-size:13px;color:#7A7263;margin:0 0 20px;}
  .lg-success{background:#EAF1E9;color:#4B6349;font-size:13px;padding:12px 16px;border-radius:4px;margin-bottom:16px;}
  .lg-back{background:none;border:0;color:#7A7263;font-size:12px;text-decoration:underline;cursor:pointer;margin-top:8px;padding:0;}

  .lg-divider{text-align:center;margin:28px 0 20px;position:relative;}
  .lg-divider::before{content:'';position:absolute;top:50%;left:0;right:0;height:1px;background:#E3DCC8;}
  .lg-divider span{position:relative;background:#FFFFFF;padding:0 14px;font-size:11px;letter-spacing:1px;text-transform:uppercase;color:#7A7263;}

  .lg-create-btn{display:block;text-align:center;width:100%;background:none;border:1px solid #C38239;color:#C38239;padding:13px;border-radius:4px;font-size:13px;font-weight:600;letter-spacing:1px;text-transform:uppercase;text-decoration:none;box-sizing:border-box;}
  .lg-create-btn:hover{background:#C38239;color:#FFFFFF;}

  @media(max-width:900px){
    .lg-wrap{grid-template-columns:1fr;min-height:auto;}
    .lg-visual{padding:48px 24px;min-height:220px;}
    .lg-mark{font-size:36px;}
    .lg-title{font-size:22px;}
    .lg-form-side{padding:40px 24px;}
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function(){
    var recoverLink = document.getElementById('lg-recover-link');
    var backLink = document.getElementById('lg-back-link');
    var recoverBox = document.getElementById('lg-recover-box');
    if(recoverLink){
      recoverLink.addEventListener('click', function(e){
        e.preventDefault();
        recoverBox.style.display = 'block';
        recoverBox.scrollIntoView({behavior:'smooth', block:'center'});
      });
    }
    if(backLink){
      backLink.addEventListener('click', function(){
        recoverBox.style.display = 'none';
      });
    }
    {% if form.posted_successfully? %}
      if(recoverBox) recoverBox.style.display = 'block';
    {% endif %}
  });
</script>
{% schema %}
{"name":"Login page","settings":[]}
{% endschema %}