<div class="wl-wrap">
  <h1 class="wl-title">My Wishlist</h1>
  <div id="wl-empty" class="wl-empty" style="display:none;">
    <p>Your wishlist is empty.</p>
    <a href="/collections/all" class="wl-empty-link">Browse Products &rarr;</a>
  </div>
  <div id="wl-grid" class="wl-grid"></div>
</div>

<style>
  .wl-wrap{max-width:1200px;margin:0 auto;padding:48px 24px 80px;color:#2B2420;}
  .wl-title{font-family:'Bebas Neue',sans-serif;font-size:26px;letter-spacing:1px;margin:0 0 32px;text-align:center;}
  .wl-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;}
  .wl-card{text-decoration:none;color:inherit;display:block;position:relative;}
  .wl-img{aspect-ratio:4/5;background:#F9F4E3;border-radius:4px;overflow:hidden;margin-bottom:12px;position:relative;}
  .wl-img img{width:100%;height:100%;object-fit:cover;display:block;}
  .wl-remove{position:absolute;top:10px;right:10px;width:32px;height:32px;border-radius:50%;background:rgba(244,239,220,.92);border:0;display:flex;align-items:center;justify-content:center;cursor:pointer;color:#2B2420;z-index:2;}
  .wl-name{font-size:13px;font-weight:600;margin-bottom:4px;line-height:1.3;}
  .wl-price{font-size:13px;color:#7A7263;}
  .wl-empty{text-align:center;padding:60px 20px;color:#7A7263;font-size:14px;}
  .wl-empty-link{display:inline-block;margin-top:16px;color:#2B2420;font-weight:600;text-decoration:underline;}
  @media(max-width:768px){.wl-grid{grid-template-columns:repeat(2,1fr);gap:16px;}.wl-title{font-size:20px;}}
</style>

<script>
(function(){
  var KEY = 'jack_studio_wishlist';
  function getList(){
    try { return JSON.parse(localStorage.getItem(KEY)) || []; }
    catch(e){ return []; }
  }
  function removeHandle(handle){
    var list = getList().filter(function(h){ return h !== handle; });
    localStorage.setItem(KEY, JSON.stringify(list));
    render();
  }
  function render(){
    var handles = getList();
    var grid = document.getElementById('wl-grid');
    var empty = document.getElementById('wl-empty');
    if(handles.length === 0){
      grid.innerHTML = '';
      empty.style.display = 'block';
      return;
    }
    empty.style.display = 'none';
    grid.innerHTML = '<p style="grid-column:1/-1;text-align:center;color:#7A7263;font-size:13px;">Loading...</p>';
    Promise.all(handles.map(function(h){
      return fetch('/products/' + h + '.js').then(function(r){ return r.ok ? r.json() : null; }).catch(function(){ return null; });
    })).then(function(products){
      grid.innerHTML = '';
      products.forEach(function(p, i){
        if(!p) return;
        var handle = handles[i];
        var img = p.featured_image || (p.images && p.images[0]) || '';
        var card = document.createElement('div');
        card.className = 'wl-card';
        card.innerHTML =
          '<button class="wl-remove" aria-label="Remove" data-handle="' + handle + '">' +
            '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>' +
          '</button>' +
          '<a href="/products/' + handle + '">' +
            '<div class="wl-img">' + (img ? '<img src="' + img + '" alt="' + p.title + '" loading="lazy">' : '') + '</div>' +
            '<div class="wl-name">' + p.title + '</div>' +
            '<div class="wl-price">' + (p.price / 100).toFixed(2) + '</div>' +
          '</a>';
        grid.appendChild(card);
      });
      grid.querySelectorAll('.wl-remove').forEach(function(btn){
        btn.addEventListener('click', function(e){
          e.preventDefault();
          removeHandle(btn.getAttribute('data-handle'));
        });
      });
    });
  }
  document.addEventListener('DOMContentLoaded', render);
})();
</script>
{% schema %}
{"name":"Wishlist page","settings":[]}
{% endschema %}