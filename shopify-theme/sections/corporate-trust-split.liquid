<section class="cts-wrap" style="background:{{ section.settings.bg_color }};" {{ section.shopify_attributes }}>
  <div class="cts-left">
    <span class="cts-eyebrow">{{ section.settings.eyebrow }}</span>
    <h2 class="cts-heading">{{ section.settings.heading }}</h2>
    <p class="cts-tagline">{{ section.settings.tagline }}</p>
    <span class="cts-underline"></span>
  </div>
  <div class="cts-items">
    {% for block in section.blocks %}
      <div class="cts-item" {{ block.shopify_attributes }}>
        <span class="cts-icon">
          {%- case block.settings.icon -%}
          {%- when 'shield' -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M16 4l10 4v8c0 6-4 11-10 12-6-1-10-6-10-12V8z"/></svg>
          {%- when 'person' -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="16" cy="11" r="5"/><path d="M5 28c0-6 5-10 11-10s11 4 11 10"/></svg>
          {%- when 'handshake' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
          {%- when 'headset' -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M6 18v-2a10 10 0 0 1 20 0v2"/><rect x="4" y="17" width="6" height="9" rx="2"/><rect x="22" y="17" width="6" height="9" rx="2"/><path d="M28 26a4 4 0 0 1-4 4h-3"/></svg>
          {%- else -%}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="16" cy="16" r="12"/></svg>
          {%- endcase -%}
        </span>
        <strong class="cts-title">{{ block.settings.title }}</strong>
        <span class="cts-desc">{{ block.settings.desc }}</span>
      </div>
    {% endfor %}
  </div>
</section>

<style>
  .cts-wrap{display:flex;align-items:center;gap:56px;padding:56px 6vw;flex-wrap:wrap;}
  .cts-left{flex:0 0 260px;}
  .cts-eyebrow{display:block;font-size:11px;letter-spacing:2px;text-transform:uppercase;color:#C4823A;font-weight:700;margin-bottom:10px;}
  .cts-heading{font-family:'Bebas Neue',sans-serif;font-size:clamp(30px,3.6vw,44px);line-height:0.95;color:#2B2420;margin:0 0 12px;}
  .cts-tagline{font-size:13.5px;color:#5A4E3F;margin:0 0 16px;}
  .cts-underline{display:block;width:40px;height:2px;background:#2B2420;}

  .cts-items{flex:1 1 600px;display:flex;flex-wrap:wrap;gap:0;}
  .cts-item{flex:1 1 180px;padding:0 24px;border-left:1px solid rgba(64,20,16,.12);display:flex;flex-direction:column;align-items:flex-start;}
  .cts-item:first-child{border-left:0;padding-left:0;}
  .cts-icon{width:34px;height:34px;color:#2B2420;margin-bottom:16px;}
  .cts-icon svg{width:100%;height:100%;}
  .cts-title{font-size:13.5px;letter-spacing:.5px;text-transform:uppercase;font-weight:700;color:#2B2420;margin-bottom:8px;line-height:1.3;}
  .cts-desc{font-size:13px;color:#7A7263;line-height:1.6;}

  @media(max-width:900px){
    .cts-wrap{flex-direction:column;align-items:flex-start;gap:36px;padding:44px 24px;}
    .cts-heading{font-size:30px;}
    .cts-items{width:100%;}
    .cts-item{flex:1 1 45%;border-left:0;padding:0 0 20px;margin-bottom:20px;border-bottom:1px solid rgba(64,20,16,.1);}
    .cts-item:first-child{padding-left:0;}
  }
  @media(max-width:520px){
    .cts-item{flex:1 1 100%;}
  }
</style>

{% schema %}
{
  "name": "CORPORATE — Trust Split",
  "settings": [
    {"type":"color","id":"bg_color","label":"Background","default":"#EFE2DB"},
    {"type":"text","id":"eyebrow","label":"Eyebrow","default":"Why Businesses Trust"},
    {"type":"text","id":"heading","label":"Heading (large)","default":"Jack Studio"},
    {"type":"text","id":"tagline","label":"Tagline","default":"Quality gifts. Stronger relationships."}
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {"type":"select","id":"icon","label":"Icon","default":"shield","options":[{"value":"shield","label":"Shield"},{"value":"person","label":"Person"},{"value":"handshake","label":"Handshake"},{"value":"headset","label":"Headset"}]},
        {"type":"text","id":"title","label":"Title","default":"Quality Craftsmanship"},
        {"type":"textarea","id":"desc","label":"Description","default":"Made with the finest leather and attention to every detail."}
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "CORPORATE — Trust Split",
      "blocks": [
        {"type":"item","settings":{"icon":"shield","title":"Quality Craftsmanship","desc":"Made with the finest leather and attention to every detail."}},
        {"type":"item","settings":{"icon":"person","title":"Customised Solutions","desc":"Tailored products to suit your brand and objectives."}},
        {"type":"item","settings":{"icon":"handshake","title":"Reliable Partner","desc":"Professional service from start to finish, delivered on time."}},
        {"type":"item","settings":{"icon":"headset","title":"After-Sales Care","desc":"Dedicated support to ensure your satisfaction every step ahead."}}
      ]
    }
  ]
}
{% endschema %}
