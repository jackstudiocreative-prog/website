{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/render.mjs": { "includeFiles": "bundle/**" }
  },
  "rewrites": [
    { "source": "/((?!assets/|cart\\.js$|api/).*)", "destination": "/api/render?__path=/$1" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    }
  ]
}
